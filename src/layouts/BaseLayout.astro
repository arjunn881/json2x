---
import SEO from '../components/seo/SEO.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import '../styles/global.css';
import { defaultLang, LANGUAGE_META, type Lang } from '../i18n/ui';
import { getLocalizedTools } from '../i18n/tools';
import { useTranslatedPath, useTranslations } from '../i18n/utils';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  keywords?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  robots?: string;
  currentId?: string;
  publishedTime?: string;
  author?: string;
  schema?: Record<string, any> | Record<string, any>[];
  containerClass?: string;
  isSecondary?: boolean;
  contentLength?: number;
  lang?: Lang;
  /**
   * Tool pages run their logic from an inline <script> inside <main>, which the
   * browser executes while parsing the body — before any deferred script. Set
   * this so /assets/js/common.js loads synchronously in <head> and the global
   * `JT` helper exists by the time those inline scripts run. Without it every
   * tool that touches `JT` throws ReferenceError and dies silently.
   */
  needsToolRuntime?: boolean;
}

const {
  title,
  description,
  canonical,
  keywords,
  ogImage,
  ogType = 'website',
  robots,
  currentId = '',
  publishedTime,
  author,
  schema,
  containerClass = 'container',
  isSecondary = false,
  contentLength,
  lang = defaultLang,
  needsToolRuntime = false
} = Astro.props;

const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const langMeta = LANGUAGE_META[lang] || LANGUAGE_META[defaultLang];
const localizedTools = getLocalizedTools(lang);

const searchIndexData = [
  ...localizedTools.map((tool) => ({
    name: tool.name,
    href: tool.href,
    desc: tool.desc,
  })),
  { name: t('breadcrumb.docs'), href: translatePath('/docs'), desc: t('search.docsDesc') },
  { name: t('breadcrumb.kb'), href: translatePath('/kb'), desc: t('search.kbDesc') },
  { name: t('breadcrumb.blog'), href: translatePath('/blog'), desc: t('search.blogDesc') },
];

const searchIndexJson = JSON.stringify(searchIndexData);
---

<!DOCTYPE html>
<html lang={langMeta.bcp47} data-ssr-i18n="true">
<head>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-W5LWV30LK1"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-W5LWV30LK1');
  </script>

  <!-- Performance DNS & Preconnect -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=3" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=3" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
  <link rel="shortcut icon" href="/favicon.ico?v=3" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=3" />
  <link rel="manifest" href="/site.webmanifest?v=3" />

  <!-- Preload fonts for max speed & zero layout shifts -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" />

  <!-- Instant Theme Initializer (prevents flash) -->
  <script is:inline>
    (function () {
      var t;
      try { t = localStorage.getItem('jsontoolkit_theme'); } catch (e) {}
      if (!t) {
        t = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
      document.documentElement.setAttribute('data-theme', t);
    })();
  </script>

  <!-- Full Rich SEO & Structured Data -->
  <SEO
    title={title}
    description={description}
    canonical={canonical}
    keywords={keywords}
    ogImage={ogImage}
    ogType={ogType}
    robots={robots}
    publishedTime={publishedTime}
    author={author}
    schema={schema}
    isSecondary={isSecondary}
    contentLength={contentLength}
    lang={lang}
  />
  {needsToolRuntime && <script src="/assets/js/common.js" is:inline></script>}
</head>
<body>
  <Header currentId={currentId} lang={lang} />

  <main id="main-content">
    <div class={containerClass}>
      <slot />
    </div>
  </main>

  <Footer lang={lang} />

  <!-- Global Quick Search Modal -->
  <div id="search-modal-backdrop" class="search-modal-backdrop" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.6);backdrop-filter:blur(4px);z-index:9999;align-items:flex-start;justify-content:center;padding-top:12vh;">
    <div class="search-modal-box" style="background:var(--bg-surface);border:1px solid var(--bg-border);border-radius:var(--radius-xl);width:90%;max-width:560px;box-shadow:var(--shadow-lg);overflow:hidden;animation:modalIn 0.15s ease-out;">
      <div style="display:flex;align-items:center;padding:var(--space-4);border-bottom:1px solid var(--bg-border);gap:var(--space-3);">
        <svg width="18" height="18" viewBox="0 0 16 16" fill="none" style="color:var(--text-muted);flex-shrink:0;"><circle cx="7" cy="7" r="5" stroke="currentColor" stroke-width="1.5"/><path d="M11 11l3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        <input id="quick-search-input" type="text" placeholder={t('search.modalPlaceholder')} style="width:100%;background:transparent;border:none;outline:none;font-size:var(--text-base);color:var(--text-primary);" />
        <kbd style="font-size:11px;background:var(--bg-raised);padding:2px 6px;border-radius:4px;color:var(--text-muted);border:1px solid var(--bg-border);">ESC</kbd>
      </div>
      <div id="quick-search-results" data-no-results={t('search.noResults')} style="max-height:360px;overflow-y:auto;padding:var(--space-2);">
        <!-- Populated via search script -->
      </div>
    </div>
  </div>

  <script id="quick-search-data" type="application/json" set:html={searchIndexJson} />

  <!-- Shared Utility Scripts -->
  <script src="/assets/js/i18n.js" defer></script>
  {!needsToolRuntime && <script src="/assets/js/common.js" defer is:inline></script>}

  <!-- Quick Search Controller -->
  <script is:inline>
    (function () {
      var modal = document.getElementById('search-modal-backdrop');
      var input = document.getElementById('quick-search-input');
      var results = document.getElementById('quick-search-results');
      var searchBtn = document.getElementById('header-search-btn');
      var dataEl = document.getElementById('quick-search-data');

      var SEARCH_INDEX = [];
      if (dataEl && dataEl.textContent) {
        try { SEARCH_INDEX = JSON.parse(dataEl.textContent); } catch (e) {}
      }
      var noResultsLabel = (results && results.getAttribute('data-no-results')) || 'No matching tools found';

      function openSearch() {
        if (!modal) return;
        modal.style.display = 'flex';
        if (input) { input.value = ''; input.focus(); renderResults(''); }
      }

      function closeSearch() {
        if (!modal) return;
        modal.style.display = 'none';
      }

      if (searchBtn) searchBtn.addEventListener('click', openSearch);
      if (modal) {
        modal.addEventListener('click', function(e) {
          if (e.target === modal) closeSearch();
        });
      }

      document.addEventListener('keydown', function(e) {
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          modal && modal.style.display === 'flex' ? closeSearch() : openSearch();
        }
        if (e.key === 'Escape' && modal && modal.style.display === 'flex') {
          closeSearch();
        }
      });

      function renderResults(query) {
        if (!results) return;
        var q = query.trim().toLowerCase();
        var matches = SEARCH_INDEX.filter(function(item) {
          return !q || item.name.toLowerCase().includes(q) || item.desc.toLowerCase().includes(q);
        });

        if (matches.length === 0) {
          results.innerHTML = '<div style="padding:var(--space-6);text-align:center;color:var(--text-muted);font-size:var(--text-sm);">' + noResultsLabel + '</div>';
          return;
        }

        results.innerHTML = matches.map(function(m) {
          return '<a href="' + m.href + '" style="display:block;padding:var(--space-3) var(--space-4);border-radius:var(--radius-md);text-decoration:none;color:inherit;transition:background var(--transition-fast);" onmouseover="this.style.background=\'var(--bg-raised)\'" onmouseout="this.style.background=\'transparent\'">' +
            '<div style="font-size:var(--text-sm);font-weight:var(--font-semibold);color:var(--text-primary);margin-bottom:2px;">' + m.name + '</div>' +
            '<div style="font-size:var(--text-xs);color:var(--text-secondary);">' + m.desc + '</div>' +
          '</a>';
        }).join('');
      }

      if (input) {
        input.addEventListener('input', function() {
          renderResults(this.value);
        });
      }
    })();
  </script>
</body>
</html>
