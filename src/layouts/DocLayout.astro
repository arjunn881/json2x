---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import { DOCS } from '../data/docs';
import { getToolBySlugOrId } from '../data/tools';

export interface Props {
  title: string;
  description: string;
  category?: string;
  tags?: string[];
  author?: string;
  date?: string;
  primaryTool?: string;
  canonical?: string;
}

const {
  title,
  description,
  category = 'Documentation',
  tags = [],
  author = 'JSON2X Engineering Team',
  date = '2026-08-16',
  primaryTool = 'json-validator',
  canonical = Astro.url.pathname
} = Astro.props;

const techArticleSchema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  'headline': title,
  'description': description,
  'inLanguage': 'en',
  'articleSection': category,
  'mainEntityOfPage': {
    '@type': 'WebPage',
    '@id': `https://json2x.com${canonical}`
  },
  'author': {
    '@type': 'Organization',
    'name': author
  },
  'datePublished': date,
  'dateModified': date,
  'publisher': {
    '@type': 'Organization',
    'name': 'JSON2X',
    'url': 'https://json2x.com'
  }
};

// `primaryTool` is authored as a tool id, slug, or alias; expose the resolved
// tool so the page-level CTA can link to the canonical URL, not an alias.
const ctaTool = getToolBySlugOrId(primaryTool);
const relatedTools = ctaTool
  ? ctaTool.related
      .map((r) => getToolBySlugOrId(r))
      .filter((t): t is NonNullable<typeof t> => Boolean(t))
      .slice(0, 4)
  : [];

const currentSlug = canonical.replace('/docs', '').replace(/\/$/, '');
const relatedDocs = DOCS.filter((d) => d.filename.replace(/\.mdx?$/, '') !== currentSlug).slice(0, 5);

// Google renders roughly 60 characters of a title, and " | JSON2X Docs" costs 14 of
// them. Keep the suffix only while the doc title still fits beside it; past that the
// title itself carries the keywords, so it gets the whole budget.
const TITLE_BUDGET = 60;
const branded = `${title} | JSON2X Docs`;
const pageTitle = branded.length <= TITLE_BUDGET
  ? branded
  : (`${title} | JSON2X`.length <= TITLE_BUDGET ? `${title} | JSON2X` : title);
---

<BaseLayout
  title={pageTitle}
  description={description}
  canonical={canonical}
  currentId="docs"
  schema={techArticleSchema}
>
  <Breadcrumbs
    items={[
      { label: 'Documentation', href: '/docs' },
      { label: title }
    ]}
  />

  <div class="tool-hero" style="text-align:left; margin-bottom:var(--space-10);">
    <div class="tool-hero__badge">{category} Documentation</div>
    <h1 class="tool-hero__title">{title}</h1>
    <p class="tool-hero__desc">{description}</p>
  </div>

  <article class="faq-prose" style="margin-bottom:var(--space-12);">
    <slot />
  </article>

  {relatedTools.length > 0 && (
    <section class="tool-section" style="margin-top:var(--space-12);">
      <h2 class="tool-section__title">Tools referenced in this document</h2>
      <div class="related-tools-grid">
        {relatedTools.map((t) => (
          <a href={t.href} class="related-tool-card">
            <span class="related-tool-card__icon">
              <Fragment set:html={t.icon} />
            </span>
            <span class="related-tool-card__body">
              <span class="related-tool-card__title">{t.name}</span>
              <span class="related-tool-card__desc">{t.desc}</span>
            </span>
          </a>
        ))}
      </div>
    </section>
  )}

  {relatedDocs.length > 0 && (
    <section class="tool-section" style="margin-top:var(--space-12);">
      <h2 class="tool-section__title">Related Documentation &amp; Reference Articles</h2>
      <ul style="line-height: var(--leading-relaxed); padding-left: var(--space-6);">
        {relatedDocs.map((doc) => {
          const slug = doc.filename.replace(/\.mdx?$/, '');
          return (
            <li>
              <a href={`/docs/${slug}`} style="color:var(--accent); text-decoration:none;">{doc.frontmatter.title}</a>
            </li>
          );
        })}
      </ul>
    </section>
  )}
</BaseLayout>
