---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import { BLOG_ARTICLES } from '../../data/blog';
import { defaultLang, type Lang } from '../../i18n/ui';
import { useTranslations, useTranslatedPath } from '../../i18n/utils';
import { getPageBundle } from '../../i18n/pages';

export interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const isEn = lang === 'en';
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const pages = getPageBundle(lang);
const hubMeta = pages?.blogHub;

const canonicalPath = isEn ? '/blog' : translatePath('/blog');

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  ...(isEn ? {} : { 'inLanguage': lang }),
  'name': isEn ? 'JSON2X Engineering Blog & Developer Tutorials' : hubMeta!.schemaName,
  'url': isEn ? 'https://json2x.com/blog' : `https://json2x.com${canonicalPath}`,
  'itemListElement': BLOG_ARTICLES.map((a, idx) => ({
    '@type': 'ListItem',
    'position': idx + 1,
    'name': a.title,
    'url': `https://json2x.com/blog/${a.slug}`
  }))
};
---

{isEn ? (
  <BaseLayout
    title="Engineering Blog & Developer Tutorials — JSON2X"
    description="In-depth developer articles, architectural benchmarks, data migration tutorials, and performance guides for JSON, CSV, TypeScript, SQL, and APIs."
    keywords="json tools, json formatter, json validator, json to typescript, json converter, csv to json, json diff, json engineering blog, json minification performance benchmarks, json vs yaml vs xml vs toml comparison, typescript zod api validation guide, zero server browser security architecture, migrating soap xml to json"
    canonical="/blog"
    currentId="blog"
    schema={itemListSchema}
  >
    <Breadcrumbs items={[{ label: 'Engineering Blog' }]} />

    <div class="tool-hero" style="text-align:left; margin-bottom:var(--space-10);">
      <div class="tool-hero__badge">Engineering Hub</div>
      <h1 class="tool-hero__title">Engineering Blog &amp; Tutorials</h1>
      <p class="tool-hero__desc">Authoritative guides on client-side data engineering, RFC standards, type inference, performance benchmarks, and zero-server privacy.</p>
    </div>

    <div class="faq-grid" style="grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: var(--space-6);">
      {BLOG_ARTICLES.map((article) => (
        <a href={`/blog/${article.slug}`} class="faq-card" style="text-decoration:none; display:flex; flex-direction:column;">
          <p class="faq-section__eyebrow">{article.category}</p>
          <h2 class="faq-card__q" style="margin-top:0;">{article.h1}</h2>
          <p class="faq-card__a">{article.metaDesc}</p>
        </a>
      ))}
    </div>
  </BaseLayout>
) : (
  <BaseLayout
    title={hubMeta!.title}
    description={hubMeta!.description}
    keywords={hubMeta!.keywords}
    canonical={canonicalPath}
    currentId="blog"
    schema={itemListSchema}
    lang={lang}
  >
    <Breadcrumbs items={[{ label: t('breadcrumb.blog') }]} lang={lang} />

    <div class="tool-hero" style="text-align:left; margin-bottom:var(--space-10);">
      <div class="tool-hero__badge">{hubMeta!.badge}</div>
      <h1 class="tool-hero__title">{hubMeta!.h1}</h1>
      <p class="tool-hero__desc">{hubMeta!.desc}</p>
      <div style="margin-top:var(--space-4); padding:var(--space-3) var(--space-4); background:var(--bg-raised); border:1px solid var(--bg-border); border-left:3px solid var(--accent); border-radius:var(--radius-md); font-size:var(--text-sm); color:var(--text-secondary);">
        {hubMeta!.englishNotice}
      </div>
    </div>

    <div class="faq-grid" style="grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: var(--space-6);">
      {BLOG_ARTICLES.map((article) => {
        const catLabel = hubMeta!.categoryLabels?.[article.category] || article.category;
        return (
          <a href={`/blog/${article.slug}`} hreflang="en" class="faq-card" style="text-decoration:none; display:flex; flex-direction:column;">
            <p class="faq-section__eyebrow">{catLabel} · EN</p>
            <h2 class="faq-card__q" style="margin-top:0;" lang="en">{article.h1}</h2>
            <p class="faq-card__a" lang="en">{article.metaDesc}</p>
          </a>
        );
      })}
    </div>
  </BaseLayout>
)}

