---
export interface Props {
  title: string;
  description: string;
  canonical?: string;
  keywords?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  robots?: string;
  publishedTime?: string;
  author?: string;
  schema?: Record<string, any> | Record<string, any>[];
}

const {
  title,
  description,
  canonical = Astro.url.href,
  keywords = 'json tools, json formatter, json validator, json to typescript, json converter, csv to json, json diff',
  ogImage = 'https://json2x.com/assets/og-image.png',
  ogType = 'website',
  robots = 'index, follow',
  publishedTime,
  author = 'JSON2X Engineering Team',
  schema
} = Astro.props;

const siteUrl = 'https://json2x.com';
const canonicalUrl = canonical.startsWith('http') ? canonical : `${siteUrl}${canonical}`;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;

// Base Schema.org WebSite & Organization
const baseSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    'name': 'JSON2X',
    'url': 'https://json2x.com',
    'description': 'Universal developer JSON toolkit — 100% client-side data privacy.',
    'potentialAction': {
      '@type': 'SearchAction',
      'target': 'https://json2x.com/tools/?q={search_term_string}',
      'query-input': 'required name=search_term_string'
    }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    'name': 'JSON2X',
    'url': 'https://json2x.com',
    'logo': 'https://json2x.com/favicon.svg',
    'sameAs': [
      'https://github.com/arjunn881/json2x'
    ]
  }
];

const customSchemas = Array.isArray(schema) ? schema : schema ? [schema] : [];
const allSchemas = [...baseSchemas, ...customSchemas];
---

<!-- Primary SEO Meta -->
<title>{title}</title>
<meta name="description" content={description} />
{keywords && <meta name="keywords" content={keywords} />}
<meta name="robots" content={robots} />
<link rel="canonical" href={canonicalUrl} />
<meta name="author" content={author} />
<meta name="theme-color" content="#0d1117" />
<meta name="color-scheme" content="dark light" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:site_name" content="JSON2X" />
<meta property="og:locale" content="en_US" />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<!-- Structured Data (JSON-LD) -->
{allSchemas.map((s) => (
  <script type="application/ld+json" set:html={JSON.stringify(s)} />
))}
