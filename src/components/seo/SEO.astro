---
export interface Props {
  title: string;
  description: string;
  canonical?: string;
  keywords?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  robots?: string;
  publishedTime?: string;
  author?: string;
  schema?: Record<string, any> | Record<string, any>[];
  isSecondary?: boolean;
  contentLength?: number;
}

const {
  title,
  description,
  canonical,
  keywords = 'json tools, json formatter, json validator, json to typescript, json converter, csv to json, json diff',
  ogImage = 'https://json2x.com/assets/og-image.png',
  ogType = 'website',
  robots = 'index, follow',
  publishedTime,
  author = 'JSON2X Engineering Team',
  schema,
  isSecondary = false,
  contentLength
} = Astro.props;

const siteUrl = 'https://json2x.com';

// Dynamic, self-referencing canonical tag strictly derived from Astro.url.pathname
// Strips query parameters, tracking tags (?utm=, ?ref=), and normalizes trailing slashes
const cleanPathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const defaultCanonical = `${siteUrl}${cleanPathname}`;

let canonicalUrl = defaultCanonical;
if (canonical) {
  const cleanExplicit = canonical.split('?')[0].split('#')[0].replace(/\/+$/, '') || '/';
  canonicalUrl = cleanExplicit.startsWith('http') ? cleanExplicit : `${siteUrl}${cleanExplicit}`;
}
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;

// Secondary threshold check: Automatically drop 'noindex, follow' if secondary, variation parameter, or below content threshold
// Protects against GSC "Discovered - currently not indexed" bloat and AdSense Low Value Content penalties
const hasTrackingOrVariantParams = Astro.url.searchParams.size > 0;
const isMinorVariation = isSecondary || hasTrackingOrVariantParams;
const meetsContentThreshold = isMinorVariation ? false : (contentLength !== undefined ? contentLength >= 250 : true);
const thresholdRobots = (!meetsContentThreshold) ? 'noindex, follow' : robots;

// Force noindex on ALL *.pages.dev hostnames (main staging + every unique deployment preview)
const isStaging = Astro.url.hostname.endsWith('.pages.dev');
const effectiveRobots = isStaging ? 'noindex, nofollow' : thresholdRobots;

// Base Schema.org WebSite & Organization
const baseSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    'name': 'JSON2X',
    'url': 'https://json2x.com',
    'description': 'Universal developer JSON toolkit — 100% client-side data privacy.',
    'potentialAction': {
      '@type': 'SearchAction',
      'target': 'https://json2x.com/tools?q={search_term_string}',
      'query-input': 'required name=search_term_string'
    },
    // GEO: speakable — marks key page sections for AI voice/summary extraction
    'speakable': {
      '@type': 'SpeakableSpecification',
      'cssSelector': ['h1', '.tool-hero__desc', '#direct-answer', '#blog-intro', '.tool-hero__title']
    }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    'name': 'JSON2X',
    'url': 'https://json2x.com',
    'logo': 'https://json2x.com/favicon.svg',
    'sameAs': [
      'https://github.com/arjunn881/json2x'
    ]
  }
];

const customSchemas = Array.isArray(schema) ? schema : schema ? [schema] : [];
const allSchemas = [...baseSchemas, ...customSchemas];
---

<!-- Primary SEO Meta -->
<title>{title}</title>
<meta name="description" content={description} />
{keywords && <meta name="keywords" content={keywords} />}
<meta name="robots" content={effectiveRobots} />
<link rel="canonical" href={canonicalUrl} />
<meta name="author" content={author} />
<meta name="theme-color" content="#0d1117" />
<meta name="color-scheme" content="dark light" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:site_name" content="JSON2X" />
<meta property="og:locale" content="en_US" />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<!-- Structured Data (JSON-LD) -->
{allSchemas.map((s) => (
  <script type="application/ld+json" set:html={JSON.stringify(s)} />
))}
