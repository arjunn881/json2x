---
export interface FAQItem {
  q: string;
  a: string;
}

export interface Props {
  faqs: FAQItem[];
  pageUrl?: string;
}

const { faqs, pageUrl = Astro.url.href } = Astro.props;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map((faq) => ({
    '@type': 'Question',
    'name': faq.q,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': faq.a
    }
  }))
};
---
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
