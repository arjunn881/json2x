---
const year = new Date().getFullYear();
---

<footer class="site-footer" role="contentinfo">
  <div class="container">
    <div class="site-footer__grid">
      <!-- Col 1: Brand -->
      <div class="footer-col">
        <a href="/" class="site-header__logo" style="margin-bottom: var(--space-3); text-decoration: none;">
          <span class="logo-icon" aria-hidden="true">&#123;2X&#125;</span>
          JSON<span style="color:var(--accent)">2X</span>
        </a>
        <p class="footer-brand__tagline">Fast, free, browser-only JSON &amp; CSV utilities. No data leaves your machine.</p>
      </div>

      <!-- Col 2: Developer Tools -->
      <div class="footer-col">
        <h2 class="footer-col__title">Developer Tools</h2>
        <div class="footer-col__links">
          <a href="/tools/json-formatter" class="footer-col__link">JSON Formatter</a>
          <a href="/tools/json-validator" class="footer-col__link">JSON Validator</a>
          <a href="/tools/json-minifier" class="footer-col__link">JSON Minifier</a>
          <a href="/tools/json-diff" class="footer-col__link">JSON Diff</a>
          <a href="/tools/json-to-csv" class="footer-col__link">JSON to CSV</a>
          <a href="/tools/csv-to-json" class="footer-col__link">CSV to JSON</a>
          <a href="/tools/json-to-yaml" class="footer-col__link">JSON to YAML</a>
          <a href="/tools/json-to-xml" class="footer-col__link">JSON to XML</a>
          <a href="/tools/json-to-toml" class="footer-col__link">JSON to TOML</a>
          <a href="/tools/json-to-sql" class="footer-col__link">JSON to SQL</a>
          <a href="/tools/json-converter" class="footer-col__link">JSON Multi-Converter</a>
          <a href="/tools/typescript-generator" class="footer-col__link">JSON to TypeScript</a>
          <a href="/tools/json-to-code" class="footer-col__link">JSON to Code</a>
          <a href="/tools/json-schema-generator" class="footer-col__link">JSON Schema Generator</a>
          <a href="/tools/json-mock-generator" class="footer-col__link">JSON Mock Generator</a>
          <a href="/tools/jsonpath" class="footer-col__link">JSONPath Tester</a>
          <a href="/tools/json-tree-viewer" class="footer-col__link">JSON Tree Viewer</a>
          <a href="/tools/" class="footer-col__link" style="color:var(--accent)">All Tools Index &rarr;</a>
        </div>
      </div>

      <!-- Col 3: Error Troubleshooting -->
      <div class="footer-col">
        <h2 class="footer-col__title">Error Troubleshooting</h2>
        <div class="footer-col__links">
          <a href="/kb/json-errors" class="footer-col__link">Unexpected Token Fix</a>
          <a href="/kb/json-errors" class="footer-col__link">Trailing Comma Fix</a>
          <a href="/kb/json-errors" class="footer-col__link">Invalid Character Fix</a>
          <a href="/kb/json-errors" class="footer-col__link">Unexpected End Fix</a>
          <a href="/kb/" class="footer-col__link" style="color:var(--accent)">Error Knowledge Base &rarr;</a>
        </div>
      </div>

      <!-- Col 4: Guides & Reference -->
      <div class="footer-col">
        <h2 class="footer-col__title">Guides &amp; Reference</h2>
        <div class="footer-col__links">
          <a href="/docs/rfc8259-json-specification" class="footer-col__link">JSON RFC 8259 Specs</a>
          <a href="/docs/typescript-zod-generation-guide" class="footer-col__link">TypeScript Schema Tutorial</a>
          <a href="/docs/" class="footer-col__link">Documentation Hub</a>
          <a href="/kb/" class="footer-col__link">Knowledge Base Hub</a>
          <a href="/blog/" class="footer-col__link" style="color:var(--accent)">Blog &amp; Tutorials &rarr;</a>
        </div>
      </div>

      <!-- Col 5: Trust & Governance -->
      <div class="footer-col">
        <h2 class="footer-col__title">Trust &amp; Governance</h2>
        <div class="footer-col__links">
          <a href="/faq" class="footer-col__link">Frequently Asked Questions</a>
          <a href="/contact" class="footer-col__link">Contact &amp; Support</a>
          <a href="/security" class="footer-col__link">Security Architecture</a>
          <a href="/editorial-policy" class="footer-col__link">Editorial Policy</a>
          <a href="/changelog" class="footer-col__link">Version History</a>
          <a href="/roadmap" class="footer-col__link">Feature Roadmap</a>
          <a href="/open-source" class="footer-col__link">Open Source</a>
        </div>
      </div>
    </div>

    <!-- Bottom Legal Bar -->
    <div class="site-footer__bottom">
      <p class="site-footer__copy">&copy; {year} JSON2X. All processing happens locally in your browser.</p>
      <div class="site-footer__legal">
        <a href="/about">About Us</a>
        <a href="/faq">FAQ</a>
        <a href="/contact">Contact</a>
        <a href="/privacy">Privacy Policy</a>
        <a href="/terms">Terms</a>
        <a href="/disclaimer">Disclaimer</a>
        <a href="/license">License</a>
      </div>
    </div>
  </div>
</footer>
