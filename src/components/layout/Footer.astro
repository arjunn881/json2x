---
import { TOOLS } from '../../data/tools';
import { defaultLang, type Lang } from '../../i18n/ui';
import { getLocalizedTool } from '../../i18n/tools';
import { getCanonicalUrl, useTranslatedPath, useTranslations } from '../../i18n/utils';

export interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

export const POWERHOUSE_TOOLS = [
  { name: 'JSON Formatter', href: '/tools/json-formatter', desc: 'Prettify and syntax-highlight minified JSON' },
  { name: 'JSON Validator', href: '/tools/json-validator', desc: 'Strict RFC 8259 syntax checker with line numbers' },
  { name: 'JSON to TypeScript', href: '/tools/typescript-generator', desc: 'Generate TypeScript interfaces and types' },
  { name: 'JSON to XML', href: '/tools/json-to-xml', desc: 'Convert JSON to clean XML trees with custom root node' },
  { name: 'JSON to Prisma', href: '/tools/json-to-prisma', desc: 'Generate Prisma ORM schema models from JSON' },
  { name: 'JSON to CSV', href: '/tools/json-to-csv', desc: 'Export JSON arrays to spreadsheet CSV' },
  { name: 'CSV to JSON', href: '/tools/csv-to-json', desc: 'Convert CSV spreadsheets into typed JSON arrays' },
  { name: 'JSON to YAML', href: '/tools/json-to-yaml', desc: 'Convert JSON to YAML configuration manifests' },
  { name: 'JSON to SQL', href: '/tools/json-to-sql', desc: 'Generate CREATE TABLE and INSERT statements' },
  { name: 'JSON to Zod', href: '/tools/json-to-zod', desc: 'Generate Zod runtime validation schemas' },
  { name: 'JSON Diff', href: '/tools/json-diff', desc: 'Semantic tree comparison between two JSON documents' },
  { name: 'JSON Minifier', href: '/tools/json-minifier', desc: 'Compress JSON payload size client-side' },
  { name: 'JSON Schema Generator', href: '/tools/json-schema-generator', desc: 'Infer Draft-07 JSON Schema specifications' },
  { name: 'JSONPath Tester', href: '/tools/jsonpath', desc: 'Evaluate JSONPath queries interactively' },
  { name: 'JSON Multi-Converter', href: '/tools/json-converter', desc: '7-in-1 Code and Schema multi-generator' }
];

const localizedPowerhouse = lang === 'en'
  ? POWERHOUSE_TOOLS
  : POWERHOUSE_TOOLS.map((pt) => {
      const match = TOOLS.find((tool) => tool.href === pt.href);
      if (!match) return { ...pt, href: translatePath(pt.href) };
      const locTool = getLocalizedTool(match, lang);
      return {
        name: locTool.name,
        href: locTool.href,
        desc: locTool.desc,
      };
    });

const powerhouseSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  'name': t('footer.schemaName'),
  'description': t('footer.schemaDesc'),
  'itemListElement': localizedPowerhouse.map((tool, index) => ({
    '@type': 'SiteNavigationElement',
    'position': index + 1,
    'name': tool.name,
    'description': tool.desc,
    'url': getCanonicalUrl(tool.href)
  }))
};

const year = new Date().getFullYear();
---

<!-- Core Powerhouse Tools Navigation Schema -->
<script type="application/ld+json" set:html={JSON.stringify(powerhouseSchema)} />

<footer class="site-footer" role="contentinfo">
  <div class="container">
    <div class="site-footer__grid">
      <!-- Col 1: Brand -->
      <div class="footer-col">
        <a href={translatePath('/')} class="site-header__logo" style="margin-bottom: var(--space-3); text-decoration: none;">
          <span class="logo-icon" aria-hidden="true">&#123;2X&#125;</span>
          JSON<span style="color:var(--accent)">2X</span>
        </a>
        <p class="footer-brand__tagline">{t('footer.tagline')}</p>
      </div>

      <!-- Col 2: Developer Tools (Powerhouse Tools Prioritized) -->
      <div class="footer-col">
        <h2 class="footer-col__title">{t('footer.toolsTitle')}</h2>
        <div class="footer-col__links">
          {localizedPowerhouse.map((pt) => (
            <a href={pt.href} class="footer-col__link">{pt.name}</a>
          ))}
          <a href={translatePath('/tools')} class="footer-col__link" style="color:var(--accent); font-weight:600;">{t('footer.allToolsIndex')} &rarr;</a>
        </div>
      </div>

      <!-- Col 3: Error Troubleshooting -->
      <div class="footer-col">
        <h2 class="footer-col__title">{t('footer.errorsTitle')}</h2>
        <div class="footer-col__links">
          <a href="/kb/json-errors" class="footer-col__link">{t('footer.errUnexpectedToken')}</a>
          <a href="/kb/json-errors" class="footer-col__link">{t('footer.errTrailingComma')}</a>
          <a href="/kb/json-errors" class="footer-col__link">{t('footer.errInvalidChar')}</a>
          <a href="/kb/json-errors" class="footer-col__link">{t('footer.errUnexpectedEnd')}</a>
          <a href={translatePath('/kb')} class="footer-col__link" style="color:var(--accent)">{t('footer.errKbLink')} &rarr;</a>
        </div>
      </div>

      <!-- Col 4: Guides & Reference -->
      <div class="footer-col">
        <h2 class="footer-col__title">{t('footer.guidesTitle')}</h2>
        <div class="footer-col__links">
          <a href="/docs/rfc8259-json-specification" class="footer-col__link">{t('footer.rfcSpecs')}</a>
          <a href="/docs/typescript-zod-generation-guide" class="footer-col__link">{t('footer.tsTutorial')}</a>
          <a href={translatePath('/docs')} class="footer-col__link">{t('footer.docsHub')}</a>
          <a href={translatePath('/kb')} class="footer-col__link">{t('footer.kbHub')}</a>
          <a href={translatePath('/blog')} class="footer-col__link" style="color:var(--accent)">{t('footer.blogTutorials')} &rarr;</a>
        </div>
      </div>

      <!-- Col 5: Trust & Governance -->
      <div class="footer-col">
        <h2 class="footer-col__title">{t('footer.trustTitle')}</h2>
        <div class="footer-col__links">
          <a href={translatePath('/faq')} class="footer-col__link">{t('footer.faqFull')}</a>
          <a href="/contact" class="footer-col__link">{t('footer.contactSupport')}</a>
          <a href="/security" class="footer-col__link">{t('footer.securityArch')}</a>
          <a href="/editorial-policy" class="footer-col__link">{t('footer.editorialPolicy')}</a>
          <a href="/changelog" class="footer-col__link">{t('footer.versionHistory')}</a>
          <a href="/roadmap" class="footer-col__link">{t('footer.roadmap')}</a>
          <a href="/open-source" class="footer-col__link">{t('footer.openSource')}</a>
        </div>
      </div>
    </div>

    <!-- Bottom Legal Bar -->
    <div class="site-footer__bottom">
      <p class="site-footer__copy">&copy; {year} {t('footer.copySuffix')}</p>
      <div class="site-footer__legal">
        <a href={translatePath('/about')}>{t('footer.aboutUs')}</a>
        <a href={translatePath('/faq')}>{t('footer.faq')}</a>
        <a href="/contact">{t('footer.contact')}</a>
        <a href="/privacy">{t('footer.privacy')}</a>
        <a href="/terms">{t('footer.terms')}</a>
        <a href="/disclaimer">{t('footer.disclaimer')}</a>
        <a href="/license">{t('footer.license')}</a>
      </div>
    </div>
  </div>
</footer>
