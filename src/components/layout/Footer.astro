---
export const POWERHOUSE_TOOLS = [
  { name: 'JSON Formatter', href: '/tools/json-formatter', desc: 'Prettify and syntax-highlight minified JSON' },
  { name: 'JSON Validator', href: '/tools/json-validator', desc: 'Strict RFC 8259 syntax checker with line numbers' },
  { name: 'JSON to TypeScript', href: '/tools/typescript-generator', desc: 'Generate TypeScript interfaces and types' },
  { name: 'JSON to XML', href: '/tools/json-to-xml', desc: 'Convert JSON to clean XML trees with custom root node' },
  { name: 'JSON to Prisma', href: '/tools/json-to-prisma', desc: 'Generate Prisma ORM schema models from JSON' },
  { name: 'JSON to CSV', href: '/tools/json-to-csv', desc: 'Export JSON arrays to spreadsheet CSV' },
  { name: 'CSV to JSON', href: '/tools/csv-to-json', desc: 'Convert CSV spreadsheets into typed JSON arrays' },
  { name: 'JSON to YAML', href: '/tools/json-to-yaml', desc: 'Convert JSON to YAML configuration manifests' },
  { name: 'JSON to SQL', href: '/tools/json-to-sql', desc: 'Generate CREATE TABLE and INSERT statements' },
  { name: 'JSON to Zod', href: '/tools/json-to-zod', desc: 'Generate Zod runtime validation schemas' },
  { name: 'JSON Diff', href: '/tools/json-diff', desc: 'Semantic tree comparison between two JSON documents' },
  { name: 'JSON Minifier', href: '/tools/json-minifier', desc: 'Compress JSON payload size client-side' },
  { name: 'JSON Schema Generator', href: '/tools/json-schema-generator', desc: 'Infer Draft-07 JSON Schema specifications' },
  { name: 'JSONPath Tester', href: '/tools/jsonpath', desc: 'Evaluate JSONPath queries interactively' },
  { name: 'JSON Multi-Converter', href: '/tools/json-converter', desc: '7-in-1 Code and Schema multi-generator' }
];

const powerhouseSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  'name': 'Core Developer Utilities',
  'description': 'High-traffic client-side developer utilities on JSON2X',
  'itemListElement': POWERHOUSE_TOOLS.map((tool, index) => ({
    '@type': 'SiteNavigationElement',
    'position': index + 1,
    'name': tool.name,
    'description': tool.desc,
    'url': `https://json2x.com${tool.href}`
  }))
};

const year = new Date().getFullYear();
---

<!-- Core Powerhouse Tools Navigation Schema -->
<script type="application/ld+json" set:html={JSON.stringify(powerhouseSchema)} />

<footer class="site-footer" role="contentinfo">
  <div class="container">
    <div class="site-footer__grid">
      <!-- Col 1: Brand -->
      <div class="footer-col">
        <a href="/" class="site-header__logo" style="margin-bottom: var(--space-3); text-decoration: none;">
          <span class="logo-icon" aria-hidden="true">&#123;2X&#125;</span>
          JSON<span style="color:var(--accent)">2X</span>
        </a>
        <p class="footer-brand__tagline">Fast, free, browser-only JSON &amp; CSV utilities. No data leaves your machine.</p>
      </div>

      <!-- Col 2: Developer Tools (Powerhouse Tools Prioritized) -->
      <div class="footer-col">
        <h2 class="footer-col__title">Powerhouse Developer Tools</h2>
        <div class="footer-col__links">
          {POWERHOUSE_TOOLS.map((pt) => (
            <a href={pt.href} class="footer-col__link">{pt.name}</a>
          ))}
          <a href="/tools" class="footer-col__link" style="color:var(--accent); font-weight:600;">All Tools Index &rarr;</a>
        </div>
      </div>

      <!-- Col 3: Error Troubleshooting -->
      <div class="footer-col">
        <h2 class="footer-col__title">Error Troubleshooting</h2>
        <div class="footer-col__links">
          <a href="/kb/json-errors" class="footer-col__link">Unexpected Token Fix</a>
          <a href="/kb/json-errors" class="footer-col__link">Trailing Comma Fix</a>
          <a href="/kb/json-errors" class="footer-col__link">Invalid Character Fix</a>
          <a href="/kb/json-errors" class="footer-col__link">Unexpected End Fix</a>
          <a href="/kb" class="footer-col__link" style="color:var(--accent)">Error Knowledge Base &rarr;</a>
        </div>
      </div>

      <!-- Col 4: Guides & Reference -->
      <div class="footer-col">
        <h2 class="footer-col__title">Guides &amp; Reference</h2>
        <div class="footer-col__links">
          <a href="/docs/rfc8259-json-specification" class="footer-col__link">JSON RFC 8259 Specs</a>
          <a href="/docs/typescript-zod-generation-guide" class="footer-col__link">TypeScript Schema Tutorial</a>
          <a href="/docs" class="footer-col__link">Documentation Hub</a>
          <a href="/kb" class="footer-col__link">Knowledge Base Hub</a>
          <a href="/blog" class="footer-col__link" style="color:var(--accent)">Blog &amp; Tutorials &rarr;</a>
        </div>
      </div>

      <!-- Col 5: Trust & Governance -->
      <div class="footer-col">
        <h2 class="footer-col__title">Trust &amp; Governance</h2>
        <div class="footer-col__links">
          <a href="/faq" class="footer-col__link">Frequently Asked Questions</a>
          <a href="/contact" class="footer-col__link">Contact &amp; Support</a>
          <a href="/security" class="footer-col__link">Security Architecture</a>
          <a href="/editorial-policy" class="footer-col__link">Editorial Policy</a>
          <a href="/changelog" class="footer-col__link">Version History</a>
          <a href="/roadmap" class="footer-col__link">Feature Roadmap</a>
          <a href="/open-source" class="footer-col__link">Open Source</a>
        </div>
      </div>
    </div>

    <!-- Bottom Legal Bar -->
    <div class="site-footer__bottom">
      <p class="site-footer__copy">&copy; {year} JSON2X. All processing happens locally in your browser.</p>
      <div class="site-footer__legal">
        <a href="/about">About Us</a>
        <a href="/faq">FAQ</a>
        <a href="/contact">Contact</a>
        <a href="/privacy">Privacy Policy</a>
        <a href="/terms">Terms</a>
        <a href="/disclaimer">Disclaimer</a>
        <a href="/license">License</a>
      </div>
    </div>
  </div>
</footer>
