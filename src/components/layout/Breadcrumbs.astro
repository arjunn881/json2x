---
import { defaultLang, type Lang } from '../../i18n/ui';
import { getCanonicalUrl, useTranslatedPath, useTranslations } from '../../i18n/utils';

export interface BreadcrumbItem {
  label: string;
  href?: string;
}

export interface Props {
  items: BreadcrumbItem[];
  lang?: Lang;
}

const { items, lang = defaultLang } = Astro.props;
const siteUrl = 'https://json2x.com';
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const homeHref = translatePath('/');

// The visible trail starts at Home, so the JSON-LD must too — Google requires
// BreadcrumbList to match the rendered breadcrumb exactly.
const normalizedItems: BreadcrumbItem[] = items.map((item) => ({
  ...item,
  href: item.href
    ? (item.href.startsWith('http') ? item.href : translatePath(item.href))
    : undefined
}));

const schemaItems: BreadcrumbItem[] = [{ label: t('breadcrumb.home'), href: homeHref }, ...normalizedItems];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': schemaItems.map((item, index) => ({
    '@type': 'ListItem',
    'position': index + 1,
    'name': item.label,
    'item': item.href ? (item.href.startsWith('http') ? item.href : getCanonicalUrl(item.href, siteUrl)) : undefined
  }))
};
---

<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

<nav aria-label={t('a11y.breadcrumb')} class="breadcrumb">
  <a class="breadcrumb__link" href={homeHref}>{t('breadcrumb.home')}</a>
  {normalizedItems.map((item, index) => (
    <Fragment>
      <span class="breadcrumb__separator" aria-hidden="true">/</span>
      {item.href && index < normalizedItems.length - 1 ? (
        <a class="breadcrumb__link" href={item.href}>{item.label}</a>
      ) : (
        <span class="breadcrumb__current" aria-current="page">{item.label}</span>
      )}
    </Fragment>
  ))}
</nav>
