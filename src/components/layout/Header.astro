---
import { CATEGORIES, TOOLS } from '../../data/tools';

export interface Props {
  currentId?: string;
}

const { currentId = '' } = Astro.props;

const COMPANY_LINKS = [
  { id: 'about', name: 'About Us', href: '/about' },
  { id: 'faq', name: 'FAQ', href: '/faq' },
  { id: 'contact', name: 'Contact', href: '/contact' },
  { id: 'privacy', name: 'Privacy Policy', href: '/privacy' },
  { id: 'terms', name: 'Terms & Conditions', href: '/terms' },
  { id: 'disclaimer', name: 'Disclaimer', href: '/disclaimer' },
  { id: 'license', name: 'License', href: '/license' },
];

const LANGUAGES = [
  { code: 'en', name: 'English', flag: '🇺🇸' },
  { code: 'es', name: 'Español', flag: '🇪🇸' },
  { code: 'zh', name: '简体中文', flag: '🇨🇳' },
  { code: 'ja', name: '日本語', flag: '🇯🇵' },
  { code: 'pt', name: 'Português', flag: '🇧🇷' },
  { code: 'de', name: 'Deutsch', flag: '🇩🇪' },
  { code: 'fr', name: 'Français', flag: '🇫🇷' },
  { code: 'hi', name: 'हिन्दी', flag: '🇮🇳' },
  { code: 'ru', name: 'Русский', flag: '🇷🇺' },
  { code: 'ar', name: 'العربية', flag: '🇸🇦' }
];
---

<div class="top-bar" role="navigation" aria-label="Utility navigation">
  <div class="container top-bar__inner">
    <div id="live-user-clock" class="top-bar__clock" title="Live Local Time" aria-label="Live local time"></div>
    <div class="top-bar__links">
      {COMPANY_LINKS.map((link) => (
        <a href={link.href} class={`top-bar__link${currentId === link.id ? ' active' : ''}`}>
          {link.name}
        </a>
      ))}
    </div>

    <!-- Language Picker (Desktop) -->
    <div class="lang-picker" id="lang-picker-wrapper">
      <button class="lang-picker__btn" id="lang-picker-btn" aria-label="Language: English" aria-haspopup="true" aria-expanded="false" title="Change Language">
        <span class="lang-picker__flag" id="lang-current-flag" aria-hidden="true">🇺🇸</span>
        <span class="lang-picker__code" id="lang-current-code">EN</span>
        <svg width="10" height="10" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <div class="lang-picker__menu" id="lang-picker-menu" role="menu" aria-label="Select Language">
        {LANGUAGES.map((l) => (
          <button class={`lang-picker__item${l.code === 'en' ? ' active' : ''}`} data-lang={l.code} role="menuitem" aria-label={l.name}>
            <span class="lang-picker__flag" aria-hidden="true">{l.flag}</span>
            <span class="lang-picker__item-name">{l.name}</span>
          </button>
        ))}
      </div>
    </div>
  </div>
</div>

<header class="site-header" role="banner">
  <a class="skip-link" href="#main-content">Skip to main content</a>
  <div class="container site-header__inner">
    <a href="/" class="site-header__logo" aria-label="JSON2X Home">
      <span class="logo-icon" aria-hidden="true">&#123;2X&#125;</span>
      JSON<span style="color:var(--accent)">2X</span>
    </a>

    <nav class="site-nav" aria-label="Primary navigation">
      <div class="site-nav__dropdown-wrap">
        <a class={`site-nav__link${currentId.includes('tool') || currentId === 'catalog' ? ' active' : ''}`} href="/tools/">
          Catalog
        </a>
        <div class="site-nav__dropdown-menu">
          {CATEGORIES.map((cat) => {
            const catTools = TOOLS.filter((t) => t.category === cat.id);
            return (
              <div class="site-nav__dropdown-col">
                <div class="site-nav__dropdown-head">
                  <Fragment set:html={cat.icon} />
                  <span>{cat.name}</span>
                </div>
                {catTools.map((t) => (
                  <a class={`site-nav__dropdown-item${t.id === currentId || t.slug === currentId ? ' active' : ''}`} href={t.href}>
                    <span class="site-nav__dropdown-icon"><Fragment set:html={t.icon} /></span>
                    <span class="site-nav__dropdown-info">
                      <span class="site-nav__dropdown-name">{t.name} {t.badge && <span class="badge badge--sm">{t.badge}</span>}</span>
                      <span class="site-nav__dropdown-desc">{t.desc}</span>
                    </span>
                  </a>
                ))}
              </div>
            );
          })}
        </div>
      </div>

      <a class={`site-nav__link${currentId === 'docs' ? ' active' : ''}`} href="/docs/">Docs</a>
      <a class={`site-nav__link${currentId === 'kb' ? ' active' : ''}`} href="/kb/">Knowledge Base</a>
      <a class={`site-nav__link${currentId === 'blog' ? ' active' : ''}`} href="/blog/">Blog</a>
    </nav>

    <!-- Search Button -->
    <button class="header-search-btn" id="header-search-btn" aria-label="Search tools and guides (Ctrl+K)" title="Quick Search (Ctrl+K)">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <circle cx="7" cy="7" r="5" stroke="currentColor" stroke-width="1.5"/>
        <path d="M11 11l3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
      <span class="header-search-text">Search tools...</span>
      <kbd class="header-search-kbd">Ctrl K</kbd>
    </button>

    <!-- Single Theme Toggle Icon Button -->
    <button class="theme-toggle" id="theme-toggle" aria-label="Toggle dark/light theme" title="Toggle theme">
      <svg class="theme-toggle__icon-sun" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><circle cx="9" cy="9" r="4" stroke="currentColor" stroke-width="1.5"/><path d="M9 1v2M9 15v2M1 9h2M15 9h2M3.34 3.34l1.42 1.42M13.24 13.24l1.42 1.42M3.34 14.66l1.42-1.42M13.24 4.76l1.42-1.42" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      <svg class="theme-toggle__icon-moon" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M15.5 10.5A7 7 0 1 1 7.5 2.5a5.5 5.5 0 0 0 8 8z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>

    <!-- Mobile Nav Toggle -->
    <button class="nav-toggle" id="nav-toggle" aria-label="Toggle navigation" aria-expanded="false" aria-controls="mobile-nav">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <rect x="2" y="5"  width="16" height="2" rx="1" fill="currentColor"/>
        <rect x="2" y="9"  width="16" height="2" rx="1" fill="currentColor"/>
        <rect x="2" y="13" width="16" height="2" rx="1" fill="currentColor"/>
      </svg>
    </button>
  </div>
</header>

<!-- Mobile Navigation Drawer -->
<nav class="mobile-nav" id="mobile-nav" aria-label="Mobile navigation">
  <!-- Mobile Collapsible Language Dropdown -->
  <details class="mobile-nav__lang-accordion" id="mobile-lang-accordion">
    <summary class="mobile-nav__lang-summary">
      <span style="display:flex;align-items:center;gap:8px;">
        <span id="mobile-current-flag" aria-hidden="true">🇺🇸</span>
        <span id="mobile-current-name">English</span>
      </span>
      <svg class="accordion-chevron" width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </summary>
    <div class="mobile-nav__lang">
      {LANGUAGES.map((l) => (
        <button class={`mobile-nav__lang-btn${l.code === 'en' ? ' active' : ''}`} data-lang={l.code} aria-label={l.name}>
          <span aria-hidden="true">{l.flag}</span>
          <span>{l.name}</span>
        </button>
      ))}
    </div>
  </details>

  <!-- Quick Tools Index Link -->
  <div style="padding:var(--space-2) var(--space-3);margin-bottom:var(--space-2);background:var(--bg-raised);border-radius:var(--radius-md);display:flex;align-items:center;justify-content:space-between;border:1px solid var(--bg-border);">
    <a href="/tools/" style="font-weight:var(--font-bold);color:var(--accent);text-decoration:none;font-size:var(--text-sm);">Browse All Tools Catalog &rarr;</a>
  </div>

  <!-- Collapsible Categorized Tool Accordions -->
  {CATEGORIES.map((cat) => {
    const catTools = TOOLS.filter((t) => t.category === cat.id);
    const hasActive = catTools.some((t) => t.id === currentId || t.slug === currentId);
    return (
      <details class="mobile-nav__accordion" open={hasActive}>
        <summary>
          <span style="display:flex;align-items:center;gap:8px;">
            <Fragment set:html={cat.icon} />
            <span>{cat.name}</span>
          </span>
          <svg class="accordion-chevron" width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </summary>
        <div class="mobile-nav__cat-links">
          {catTools.map((t) => (
            <a class={`mobile-nav__link${t.id === currentId || t.slug === currentId ? ' active' : ''}`} href={t.href}>
              <Fragment set:html={t.icon} />
              <span>{t.name}</span>
              {t.badge && <span style="font-size:9px;background:var(--accent);color:#fff;padding:1px 4px;border-radius:3px;margin-left:auto;">{t.badge}</span>}
            </a>
          ))}
        </div>
      </details>
    );
  })}

  <!-- Collapsible Resources & Docs Accordion -->
  <details class="mobile-nav__accordion" open={currentId === 'docs' || currentId === 'kb' || currentId === 'blog'}>
    <summary>
      <span style="display:flex;align-items:center;gap:8px;">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 3h4a2 2 0 012 2v8a2 2 0 00-2-2H3V3zM13 3H9a2 2 0 00-2 2v8a2 2 0 012-2h4V3z" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
        </svg>
        <span>Resources &amp; Knowledge</span>
      </span>
      <svg class="accordion-chevron" width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </summary>
    <div class="mobile-nav__cat-links">
      <a class={`mobile-nav__link${currentId === 'docs' ? ' active' : ''}`} href="/docs/">Documentation Matrix</a>
      <a class={`mobile-nav__link${currentId === 'kb' ? ' active' : ''}`} href="/kb/">Knowledge Base Guides</a>
      <a class={`mobile-nav__link${currentId === 'blog' ? ' active' : ''}`} href="/blog/">Engineering Blog</a>
    </div>
  </details>

  <!-- Collapsible Company & Legal Accordion -->
  <details class="mobile-nav__accordion">
    <summary>
      <span style="display:flex;align-items:center;gap:8px;">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <rect x="3" y="7" width="10" height="7" rx="1.5" stroke="currentColor" stroke-width="1.3"/>
          <path d="M5 7V4.5a3 3 0 016 0V7" stroke="currentColor" stroke-width="1.3"/>
        </svg>
        <span>Company &amp; Legal</span>
      </span>
      <svg class="accordion-chevron" width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </summary>
    <div class="mobile-nav__cat-links">
      {COMPANY_LINKS.map((c) => (
        <a class={`mobile-nav__link${currentId === c.id ? ' active' : ''}`} href={c.href}>{c.name}</a>
      ))}
    </div>
  </details>
</nav>

<!-- Live Theme Toggle & Navigation Script (Fast inline script) -->
<script is:inline>
  (function() {
    function toggleTheme() {
      var curr = document.documentElement.getAttribute('data-theme') || 'dark';
      var next = curr === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      try { localStorage.setItem('jsontoolkit_theme', next); } catch(e) {}
    }

    // Header single theme toggle
    var toggle = document.getElementById('theme-toggle');
    if (toggle) toggle.addEventListener('click', toggleTheme);

    // Mobile nav drawer toggle
    var navToggle = document.getElementById('nav-toggle');
    var mobileNav = document.getElementById('mobile-nav');
    if (navToggle && mobileNav) {
      navToggle.addEventListener('click', function() {
        var isOpen = mobileNav.classList.toggle('open');
        navToggle.setAttribute('aria-expanded', String(isOpen));
      });

      // Automatically close drawer when expanding to desktop viewport (> 900px)
      var mql = window.matchMedia('(min-width: 901px)');
      function handleBreakpoint(e) {
        if (e.matches) {
          mobileNav.classList.remove('open');
          navToggle.setAttribute('aria-expanded', 'false');
        }
      }
      if (mql.addEventListener) {
        mql.addEventListener('change', handleBreakpoint);
      } else if (mql.addListener) {
        mql.addListener(handleBreakpoint);
      }
    }

    var LANG_MAP = {
      en: { name: 'English', flag: '🇺🇸' },
      es: { name: 'Español', flag: '🇪🇸' },
      zh: { name: '简体中文', flag: '🇨🇳' },
      ja: { name: '日本語', flag: '🇯🇵' },
      pt: { name: 'Português', flag: '🇧🇷' },
      de: { name: 'Deutsch', flag: '🇩🇪' },
      fr: { name: 'Français', flag: '🇫🇷' },
      hi: { name: 'हिन्दी', flag: '🇮🇳' },
      ru: { name: 'Русский', flag: '🇷🇺' },
      ar: { name: 'العربية', flag: '🇸🇦' }
    };

    // Language picker handler (Desktop & Mobile)
    function handleLangChange(code) {
      if (window.JSON2X_I18N && typeof window.JSON2X_I18N.setLanguage === 'function') {
        window.JSON2X_I18N.setLanguage(code);
      } else {
        try { localStorage.setItem('jsontoolkit_lang', code); } catch(e) {}
      }

      // Update mobile summary text & flag
      var info = LANG_MAP[code] || LANG_MAP.en;
      var mobFlag = document.getElementById('mobile-current-flag');
      var mobName = document.getElementById('mobile-current-name');
      if (mobFlag) mobFlag.textContent = info.flag;
      if (mobName) mobName.textContent = info.name;

      var deskFlag = document.getElementById('lang-current-flag');
      var deskCode = document.getElementById('lang-current-code');
      if (deskFlag) deskFlag.textContent = info.flag;
      if (deskCode) deskCode.textContent = code.toUpperCase();

      // Automatically hide / collapse mobile language accordion after selection
      var mobAccordion = document.getElementById('mobile-lang-accordion');
      if (mobAccordion) {
        mobAccordion.removeAttribute('open');
      }

      // Update active state on buttons
      document.querySelectorAll('.lang-picker__item, .mobile-nav__lang-btn').forEach(function(btn) {
        if (btn.getAttribute('data-lang') === code) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      });
    }

    // Initialize current language display on load
    try {
      var savedLang = localStorage.getItem('jsontoolkit_lang') || 'en';
      if (LANG_MAP[savedLang]) {
        var mobFlag = document.getElementById('mobile-current-flag');
        var mobName = document.getElementById('mobile-current-name');
        if (mobFlag) mobFlag.textContent = LANG_MAP[savedLang].flag;
        if (mobName) mobName.textContent = LANG_MAP[savedLang].name;
      }
    } catch(e) {}

    // Desktop Language picker dropdown
    var langBtn = document.getElementById('lang-picker-btn');
    var langMenu = document.getElementById('lang-picker-menu');
    if (langBtn && langMenu) {
      langBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        var open = langMenu.classList.toggle('open');
        langBtn.setAttribute('aria-expanded', String(open));
      });
      document.addEventListener('click', function(e) {
        if (!langMenu.contains(e.target) && !langBtn.contains(e.target)) {
          langMenu.classList.remove('open');
          langBtn.setAttribute('aria-expanded', 'false');
        }
      });
      langMenu.querySelectorAll('.lang-picker__item').forEach(function(item) {
        item.addEventListener('click', function() {
          handleLangChange(this.getAttribute('data-lang'));
          langMenu.classList.remove('open');
        });
      });
    }

    // Mobile Language buttons
    document.querySelectorAll('.mobile-nav__lang-btn').forEach(function(item) {
      item.addEventListener('click', function() {
        handleLangChange(this.getAttribute('data-lang'));
      });
    });

    // Live clock in top bar
    function updateClock() {
      var clockEl = document.getElementById('live-user-clock');
      if (!clockEl) return;
      var now = new Date();
      clockEl.textContent = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' }) + ' Local';
    }
    updateClock();
    setInterval(updateClock, 1000);
  })();
</script>
