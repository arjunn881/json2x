---
import {
  defaultLang,
  isLocalizedRoute,
  LANGUAGE_META,
  LOCALES,
  type Lang,
} from '../../i18n/ui';
import { getLocalizedCategories, getLocalizedTools } from '../../i18n/tools';
import { stripLocaleFromPath, useTranslatedPath, useTranslations } from '../../i18n/utils';

export interface Props {
  currentId?: string;
  lang?: Lang;
}

const { currentId = '', lang = defaultLang } = Astro.props;

const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const currentMeta = LANGUAGE_META[lang] || LANGUAGE_META[defaultLang];
const localizedCategories = getLocalizedCategories(lang);
const localizedTools = getLocalizedTools(lang);

const currentCleanRoute = stripLocaleFromPath(Astro.url.pathname);
const routeIsLocalized = isLocalizedRoute(currentCleanRoute);

const COMPANY_LINKS = [
  { id: 'about', name: t('nav.about'), href: translatePath('/about') },
  { id: 'faq', name: t('nav.faq'), href: translatePath('/faq') },
  { id: 'contact', name: t('nav.contact'), href: '/contact' },
  { id: 'privacy', name: t('nav.privacy'), href: '/privacy' },
  { id: 'terms', name: t('nav.terms'), href: '/terms' },
  { id: 'disclaimer', name: t('nav.disclaimer'), href: '/disclaimer' },
  { id: 'license', name: t('nav.license'), href: '/license' },
];

const LANGUAGE_SWITCH_ITEMS = LOCALES.map((loc) => {
  const meta = LANGUAGE_META[loc];
  const switchHref = routeIsLocalized
    ? translatePath(currentCleanRoute, loc)
    : loc === defaultLang
      ? currentCleanRoute
      : `/${loc}`;
  return {
    code: loc,
    meta,
    href: switchHref,
    isActive: loc === lang,
  };
});

const homeHref = translatePath('/');
const toolsHref = translatePath('/tools');
const docsHref = translatePath('/docs');
const kbHref = translatePath('/kb');
const blogHref = translatePath('/blog');
---

<div class="top-bar" role="navigation" aria-label={t('a11y.utilityNav')}>
  <div class="container top-bar__inner">
    <div
      id="live-user-clock"
      class="top-bar__clock"
      title={t('a11y.localTime')}
      aria-label={t('a11y.localTime')}
      data-local-suffix={t('clock.localSuffix')}
      data-clock-locale={currentMeta.intlLocale}
    ></div>
    <div class="top-bar__links">
      {COMPANY_LINKS.map((link) => (
        <a href={link.href} class={`top-bar__link${currentId === link.id ? ' active' : ''}`}>
          {link.name}
        </a>
      ))}
    </div>

    <!-- Language Picker (Desktop) -->
    <div class="lang-picker" id="lang-picker-wrapper">
      <button
        class="lang-picker__btn"
        id="lang-picker-btn"
        type="button"
        aria-label={`${t('a11y.languagePrefix')} ${currentMeta.nativeName}`}
        aria-haspopup="true"
        aria-expanded="false"
        title={t('a11y.changeLang')}
      >
        <span class="lang-picker__flag" id="lang-current-flag" aria-hidden="true">{currentMeta.flag}</span>
        <span class="lang-picker__code" id="lang-current-code">{currentMeta.shortCode}</span>
        <svg width="10" height="10" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <div class="lang-picker__menu" id="lang-picker-menu" role="menu" aria-label={t('a11y.selectLang')}>
        {LANGUAGE_SWITCH_ITEMS.map((item) => (
          <a
            href={item.href}
            hreflang={item.meta.bcp47}
            lang={item.meta.bcp47}
            class={`lang-picker__item${item.isActive ? ' active' : ''}`}
            data-lang={item.code}
            role="menuitem"
            aria-label={item.meta.nativeName}
            aria-current={item.isActive ? 'page' : undefined}
          >
            <span class="lang-picker__flag" aria-hidden="true">{item.meta.flag}</span>
            <span class="lang-picker__item-name">{item.meta.nativeName}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</div>

<header class="site-header" role="banner">
  <a class="skip-link" href="#main-content">{t('a11y.skipToMain')}</a>
  <div class="container site-header__inner">
    <a href={homeHref} class="site-header__logo" aria-label={t('a11y.homeAria')}>
      <span class="logo-icon" aria-hidden="true">&#123;2X&#125;</span>
      JSON<span style="color:var(--accent)">2X</span>
    </a>

    <nav class="site-nav" aria-label={t('a11y.primaryNav')}>
      <div class="site-nav__dropdown-wrap">
        <a
          class={`site-nav__link site-nav__link--has-menu${currentId.includes('tool') || currentId === 'catalog' ? ' active' : ''}`}
          href={toolsHref}
          aria-expanded="false"
          aria-controls="catalog-menu"
        >
          {t('nav.catalog')}
          <svg class="site-nav__caret" width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true"><path d="M2 4l3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <div class="site-nav__dropdown-menu" id="catalog-menu">
          {localizedCategories.map((cat) => {
            const catTools = localizedTools.filter((tool) => tool.category === cat.id);
            return (
              <div class="site-nav__dropdown-col">
                <div class="site-nav__dropdown-head">
                  <Fragment set:html={cat.icon} />
                  <span>{cat.name}</span>
                </div>
                {catTools.map((tool) => (
                  <a class={`site-nav__dropdown-item${tool.id === currentId || tool.slug === currentId ? ' active' : ''}`} href={tool.href}>
                    <span class="site-nav__dropdown-icon"><Fragment set:html={tool.icon} /></span>
                    <span class="site-nav__dropdown-info">
                      <span class="site-nav__dropdown-name">{tool.name} {tool.badge && <span class="badge badge--sm">{tool.badge}</span>}</span>
                      <span class="site-nav__dropdown-desc">{tool.desc}</span>
                    </span>
                  </a>
                ))}
              </div>
            );
          })}
        </div>
      </div>

      <a class={`site-nav__link${currentId === 'docs' ? ' active' : ''}`} href={docsHref}>{t('nav.docs')}</a>
      <a class={`site-nav__link${currentId === 'kb' ? ' active' : ''}`} href={kbHref}>{t('nav.kb')}</a>
      <a class={`site-nav__link${currentId === 'blog' ? ' active' : ''}`} href={blogHref}>{t('nav.blog')}</a>
    </nav>

    <!-- Search Button -->
    <button class="header-search-btn" id="header-search-btn" type="button" aria-label={t('nav.searchAria')} title={t('nav.searchTitle')}>
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <circle cx="7" cy="7" r="5" stroke="currentColor" stroke-width="1.5"/>
        <path d="M11 11l3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
      <span class="header-search-text">{t('nav.searchPlaceholder')}</span>
      <kbd class="header-search-kbd">Ctrl K</kbd>
    </button>

    <!-- Single Theme Toggle Icon Button -->
    <button class="theme-toggle" id="theme-toggle" type="button" aria-label={t('a11y.toggleTheme')} title={t('a11y.toggleTheme')}>
      <svg class="theme-toggle__icon-sun" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><circle cx="9" cy="9" r="4" stroke="currentColor" stroke-width="1.5"/><path d="M9 1v2M9 15v2M1 9h2M15 9h2M3.34 3.34l1.42 1.42M13.24 13.24l1.42 1.42M3.34 14.66l1.42-1.42M13.24 4.76l1.42-1.42" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      <svg class="theme-toggle__icon-moon" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M15.5 10.5A7 7 0 1 1 7.5 2.5a5.5 5.5 0 0 0 8 8z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>

    <!-- Mobile Nav Toggle -->
    <button class="nav-toggle" id="nav-toggle" type="button" aria-label={t('a11y.toggleMenu')} aria-expanded="false" aria-controls="mobile-nav">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <rect x="2" y="5"  width="16" height="2" rx="1" fill="currentColor"/>
        <rect x="2" y="9"  width="16" height="2" rx="1" fill="currentColor"/>
        <rect x="2" y="13" width="16" height="2" rx="1" fill="currentColor"/>
      </svg>
    </button>
  </div>
</header>

<!-- Mobile Navigation Drawer -->
<nav class="mobile-nav" id="mobile-nav" aria-label={t('a11y.mobileNav')}>
  <!-- Mobile Collapsible Language Dropdown -->
  <details class="mobile-nav__lang-accordion" id="mobile-lang-accordion">
    <summary class="mobile-nav__lang-summary">
      <span style="display:flex;align-items:center;gap:8px;">
        <span id="mobile-current-flag" aria-hidden="true">{currentMeta.flag}</span>
        <span id="mobile-current-name">{currentMeta.nativeName}</span>
      </span>
      <svg class="accordion-chevron" width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </summary>
    <div class="mobile-nav__lang">
      {LANGUAGE_SWITCH_ITEMS.map((item) => (
        <a
          href={item.href}
          hreflang={item.meta.bcp47}
          lang={item.meta.bcp47}
          class={`mobile-nav__lang-btn${item.isActive ? ' active' : ''}`}
          data-lang={item.code}
          aria-label={item.meta.nativeName}
          aria-current={item.isActive ? 'page' : undefined}
        >
          <span aria-hidden="true">{item.meta.flag}</span>
          <span>{item.meta.nativeName}</span>
        </a>
      ))}
    </div>
  </details>

  <!-- Quick Tools Index Link -->
  <div style="padding:var(--space-2) var(--space-3);margin-bottom:var(--space-2);background:var(--bg-raised);border-radius:var(--radius-md);display:flex;align-items:center;justify-content:space-between;border:1px solid var(--bg-border);">
    <a href={toolsHref} style="font-weight:var(--font-bold);color:var(--accent);text-decoration:none;font-size:var(--text-sm);">{t('nav.browseAllCatalog')} &rarr;</a>
  </div>

  <!-- Collapsible Categorized Tool Accordions -->
  {localizedCategories.map((cat) => {
    const catTools = localizedTools.filter((tool) => tool.category === cat.id);
    const hasActive = catTools.some((tool) => tool.id === currentId || tool.slug === currentId);
    return (
      <details class="mobile-nav__accordion" open={hasActive}>
        <summary>
          <span style="display:flex;align-items:center;gap:8px;">
            <Fragment set:html={cat.icon} />
            <span>{cat.name}</span>
          </span>
          <svg class="accordion-chevron" width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </summary>
        <div class="mobile-nav__cat-links">
          {catTools.map((tool) => (
            <a class={`mobile-nav__link${tool.id === currentId || tool.slug === currentId ? ' active' : ''}`} href={tool.href}>
              <Fragment set:html={tool.icon} />
              <span>{tool.name}</span>
              {tool.badge && <span style="font-size:9px;background:var(--accent);color:#fff;padding:1px 4px;border-radius:3px;margin-left:auto;">{tool.badge}</span>}
            </a>
          ))}
        </div>
      </details>
    );
  })}

  <!-- Collapsible Resources & Docs Accordion -->
  <details class="mobile-nav__accordion" open={currentId === 'docs' || currentId === 'kb' || currentId === 'blog'}>
    <summary>
      <span style="display:flex;align-items:center;gap:8px;">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 3h4a2 2 0 012 2v8a2 2 0 00-2-2H3V3zM13 3H9a2 2 0 00-2 2v8a2 2 0 012-2h4V3z" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
        </svg>
        <span>{t('nav.resourcesKnowledge')}</span>
      </span>
      <svg class="accordion-chevron" width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </summary>
    <div class="mobile-nav__cat-links">
      <a class={`mobile-nav__link${currentId === 'docs' ? ' active' : ''}`} href={docsHref}>{t('nav.docsMatrix')}</a>
      <a class={`mobile-nav__link${currentId === 'kb' ? ' active' : ''}`} href={kbHref}>{t('nav.kbGuides')}</a>
      <a class={`mobile-nav__link${currentId === 'blog' ? ' active' : ''}`} href={blogHref}>{t('nav.engBlog')}</a>
    </div>
  </details>

  <!-- Collapsible Company & Legal Accordion -->
  <details class="mobile-nav__accordion">
    <summary>
      <span style="display:flex;align-items:center;gap:8px;">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <rect x="3" y="7" width="10" height="7" rx="1.5" stroke="currentColor" stroke-width="1.3"/>
          <path d="M5 7V4.5a3 3 0 016 0V7" stroke="currentColor" stroke-width="1.3"/>
        </svg>
        <span>{t('nav.companyLegal')}</span>
      </span>
      <svg class="accordion-chevron" width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </summary>
    <div class="mobile-nav__cat-links">
      {COMPANY_LINKS.map((c) => (
        <a class={`mobile-nav__link${currentId === c.id ? ' active' : ''}`} href={c.href}>{c.name}</a>
      ))}
    </div>
  </details>
</nav>

<!-- Live Theme Toggle & Navigation Script (Fast inline script) -->
<script is:inline>
  (function() {
    function toggleTheme() {
      var curr = document.documentElement.getAttribute('data-theme') || 'dark';
      var next = curr === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      try { localStorage.setItem('jsontoolkit_theme', next); } catch(e) {}
    }

    // Header single theme toggle
    var toggle = document.getElementById('theme-toggle');
    if (toggle) toggle.addEventListener('click', toggleTheme);

    // Catalog mega-menu
    // Desktop (real hover): CSS :hover / :focus-within opens it, and a click on
    // "Catalog" navigates straight to /tools. Touch (no hover): first tap opens
    // the menu, second tap follows the link.
    var catalogWrap = document.querySelector('.site-nav__dropdown-wrap');
    var catalogLink = catalogWrap && catalogWrap.querySelector('.site-nav__link');
    if (catalogWrap && catalogLink) {
      var canHover = window.matchMedia('(hover: hover) and (pointer: fine)');

      function setCatalogOpen(open) {
        catalogWrap.classList.toggle('open', open);
        catalogLink.setAttribute('aria-expanded', String(open));
      }

      catalogLink.addEventListener('click', function (e) {
        if (canHover.matches) return; // let the link navigate on desktop
        if (!catalogWrap.classList.contains('open')) {
          e.preventDefault();
          setCatalogOpen(true);
        }
      });

      // Keep aria-expanded honest for hover/focus-driven opening
      catalogWrap.addEventListener('pointerenter', function () {
        if (canHover.matches) catalogLink.setAttribute('aria-expanded', 'true');
      });
      catalogWrap.addEventListener('pointerleave', function () {
        if (canHover.matches && !catalogWrap.classList.contains('open')) {
          catalogLink.setAttribute('aria-expanded', 'false');
        }
      });
      catalogWrap.addEventListener('focusin', function () {
        catalogLink.setAttribute('aria-expanded', 'true');
      });
      catalogWrap.addEventListener('focusout', function (e) {
        if (!catalogWrap.contains(e.relatedTarget) && !catalogWrap.classList.contains('open')) {
          catalogLink.setAttribute('aria-expanded', 'false');
        }
      });

      document.addEventListener('click', function (e) {
        if (!catalogWrap.contains(e.target)) setCatalogOpen(false);
      });

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && catalogWrap.contains(document.activeElement)) {
          setCatalogOpen(false);
          catalogLink.blur();
        } else if (e.key === 'Escape') {
          setCatalogOpen(false);
        }
      });
    }

    // Mobile nav drawer toggle
    var navToggle = document.getElementById('nav-toggle');
    var mobileNav = document.getElementById('mobile-nav');
    if (navToggle && mobileNav) {
      navToggle.addEventListener('click', function() {
        var isOpen = mobileNav.classList.toggle('open');
        navToggle.setAttribute('aria-expanded', String(isOpen));
      });

      // Automatically close drawer when expanding to desktop viewport (> 900px)
      var mql = window.matchMedia('(min-width: 901px)');
      function handleBreakpoint(e) {
        if (e.matches) {
          mobileNav.classList.remove('open');
          navToggle.setAttribute('aria-expanded', 'false');
        }
      }
      if (mql.addEventListener) {
        mql.addEventListener('change', handleBreakpoint);
      } else if (mql.addListener) {
        mql.addListener(handleBreakpoint);
      }
    }

    // Desktop Language picker dropdown (links navigate directly to SSR locale URLs)
    var langBtn = document.getElementById('lang-picker-btn');
    var langMenu = document.getElementById('lang-picker-menu');
    if (langBtn && langMenu) {
      langBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        var open = langMenu.classList.toggle('open');
        langBtn.setAttribute('aria-expanded', String(open));
      });
      document.addEventListener('click', function(e) {
        if (!langMenu.contains(e.target) && !langBtn.contains(e.target)) {
          langMenu.classList.remove('open');
          langBtn.setAttribute('aria-expanded', 'false');
        }
      });
    }

    // Live clock in top bar
    var clockEl = document.getElementById('live-user-clock');
    var localSuffix = (clockEl && clockEl.getAttribute('data-local-suffix')) || 'Local';
    var clockLocale = (clockEl && clockEl.getAttribute('data-clock-locale')) || undefined;
    function updateClock() {
      if (!clockEl) return;
      var now = new Date();
      clockEl.textContent = now.toLocaleTimeString(clockLocale || [], { hour: '2-digit', minute: '2-digit', second: '2-digit' }) + ' ' + localSuffix;
    }
    updateClock();
    setInterval(updateClock, 1000);
  })();
</script>
