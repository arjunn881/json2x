---
import type { ToolItem } from '../../data/tools';
import { defaultLang, type Lang } from '../../i18n/ui';
import { getRelatedLocalizedTools } from '../../i18n/tools';
import { useTranslations } from '../../i18n/utils';

export interface Props {
  tool: ToolItem;
  lang?: Lang;
}

const { tool, lang = defaultLang } = Astro.props;
const related = getRelatedLocalizedTools(tool, lang);
const t = useTranslations(lang);
---

{related.length > 0 && (
  <section class="tool-section" style="margin-top:var(--space-12);">
    <h2 class="tool-section__title">{t('tool.relatedTitle')}</h2>
    <div class="related-tools-grid">
      {related.map((rel) => (
        <a class="related-tool-card" href={rel.href}>
          <span class="related-tool-card__icon">
            <Fragment set:html={rel.icon} />
          </span>
          <span class="related-tool-card__body">
            <span class="related-tool-card__title">{rel.name}</span>
            <span class="related-tool-card__desc">{rel.desc}</span>
          </span>
        </a>
      ))}
    </div>
  </section>
)}
