---
import type { ToolItem } from '../../../data/tools';
import { defaultLang, type Lang } from '../../../i18n/ui';
import { getLocalizedTool } from '../../../i18n/tools';
import { getWorkspaceStrings } from '../../../i18n/workspaces';

export interface Props {
  tool: ToolItem;
  lang?: Lang;
}

const { tool, lang = defaultLang } = Astro.props;
const locTool = getLocalizedTool(tool, lang);
const ws = getWorkspaceStrings(lang);
const isEn = lang === 'en';
const payload = { ...ws, __isEn: isEn, __inLabel: locTool.inputLabel || ws.jsonInput, __outLabel: locTool.outputLabel || ws.yamlOutput };
---

  <div class="options-bar" style="display:flex;align-items:center;flex-wrap:wrap;gap:var(--space-3);padding:var(--space-3) var(--space-4);background:var(--bg-raised);border:1px solid var(--bg-border);border-radius:var(--radius-lg);margin-bottom:var(--space-4);">
        <label class="flex items-center gap-2 text-sm text-secondary">
          {ws.modeLabel}
          <select id="mode-select" class="jc-select" style="padding:4px 8px;background:var(--bg-base);color:var(--text-primary);border:1px solid var(--bg-border);border-radius:4px;" aria-label={isEn ? 'Conversion direction mode' : ws.modeLabel}>
            <option value="json2yaml" selected>JSON → YAML</option>
            <option value="yaml2json">YAML → JSON</option>
          </select>
        </label>
        <button class="btn btn--primary" id="convert-btn">{ws.convert}</button>
        <button class="btn btn--ghost btn--sm" id="copy-btn" style="margin-left:auto">{ws.copyResult}</button>
        <button class="btn btn--ghost btn--sm" id="download-btn">{ws.download}</button>
        <button class="btn btn--ghost btn--sm" id="clear-btn">{ws.clear}</button>
      </div>

      <div class="split-pane">
        <div class="pane">
          <div class="pane__header"><span class="pane__title" id="input-title">{locTool.inputLabel || ws.jsonInput}</span></div>
          <textarea class="textarea" id="converter-input"
            placeholder='{"apiVersion":"v1","kind":"Pod","metadata":{"name":"web-server"},"spec":{"containers":[{"name":"nginx","image":"nginx:1.21"}]}}'
            aria-label={isEn ? 'Input code pane' : ws.jsonInput} spellcheck="false" style="min-height:300px;font-family:var(--font-mono);"></textarea>
        </div>
        <div class="pane">
          <div class="pane__header"><span class="pane__title" id="output-title">{locTool.outputLabel || ws.yamlOutput}</span></div>
          <pre class="code-output" id="converter-output" tabindex="0" style="min-height:300px;font-family:var(--font-mono);padding:var(--space-4);background:var(--bg-base);border:1px solid var(--bg-border);border-radius:var(--radius-lg);overflow:auto;"></pre>
        </div>
      </div>

      <div id="tool-status" role="status" aria-live="polite" style="margin-top:var(--space-4)"></div>

  <script id="ws-i18n-data" type="application/json" is:inline set:html={JSON.stringify(payload).replace(/</g, '\\u003c')} />
  <script is:inline>

    (function() {
      'use strict';
      const WS = JSON.parse(document.getElementById('ws-i18n-data')?.textContent || '{}');
      const modeSel = document.getElementById('mode-select');
      const inputEl = document.getElementById('converter-input');
      const outputEl = document.getElementById('converter-output');
      const statusEl = document.getElementById('tool-status');
      const inputTitle = document.getElementById('input-title');
      const outputTitle = document.getElementById('output-title');

      function showStatus(msg, type = 'info') {
        statusEl.innerHTML = msg ? `<div class="alert alert--${type}">${msg}</div>` : '';
      }

      function convert() {
        const text = inputEl.value.trim();
        const mode = modeSel.value;

        if (!text) {
          outputEl.textContent = '';
          showStatus('');
          return;
        }

        if (mode === 'json2yaml') {
          const { data, error } = JT.parseJSON(text);
          if (error) {
            showStatus(`${WS.jsonParseError || 'JSON Parse Error'}: ${error}`, 'error');
            return;
          }
          const { yaml, error: yErr } = JT.jsonToYaml(data);
          if (yErr) {
            showStatus(`YAML Error: ${yErr}`, 'error');
            return;
          }
          outputEl.textContent = yaml;
          showStatus(`${WS.statusConvertedTo || 'Successfully converted to'} YAML`, 'success');
        } else {
          const { data, error } = JT.yamlToJson(text);
          if (error) {
            showStatus(`YAML ${WS.syntaxError || 'Parse Error'}: ${error}`, 'error');
            return;
          }
          const { text: jsonText } = JT.stringifyJSON(data, 2);
          outputEl.textContent = jsonText;
          showStatus(`${WS.statusConvertedTo || 'Successfully converted to'} JSON`, 'success');
        }
      }

      modeSel.addEventListener('change', () => {
        if (modeSel.value === 'json2yaml') {
          inputTitle.textContent = WS.__inLabel || WS.jsonInput || 'JSON Input';
          outputTitle.textContent = WS.__outLabel || WS.yamlOutput || 'YAML Output';
        } else {
          inputTitle.textContent = WS.yamlInput || 'YAML Input';
          outputTitle.textContent = WS.jsonOutput || 'JSON Output';
        }
        convert();
      });

      document.getElementById('convert-btn').addEventListener('click', convert);
      inputEl.addEventListener('input', JT.debounce(convert, 400));

      document.getElementById('copy-btn').addEventListener('click', () => {
        const res = outputEl.textContent;
        if (!res) return;
        JT.copyToClipboard(res)
          .then(() => showStatus(WS.__isEn ? 'Copied to clipboard!' : (WS.copied || 'Copied!'), 'success'))
          .catch(() => showStatus(WS.copyFailed || 'Copy failed.', 'warning'));
      });

      document.getElementById('download-btn').addEventListener('click', () => {
        const res = outputEl.textContent;
        if (!res) return;
        const ext = modeSel.value === 'json2yaml' ? 'yaml' : 'json';
        const blob = new Blob([res], { type: 'text/plain;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `data.${ext}`;
        a.click();
        setTimeout(() => URL.revokeObjectURL(url), 5000);
      });

      document.getElementById('clear-btn').addEventListener('click', () => {
        inputEl.value = '';
        outputEl.textContent = '';
        showStatus('');
      });
    })();
  
</script>

