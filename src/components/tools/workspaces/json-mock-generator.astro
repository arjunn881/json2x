---
import type { ToolItem } from '../../../data/tools';
import { defaultLang, type Lang } from '../../../i18n/ui';
import { getWorkspaceStrings } from '../../../i18n/workspaces';

export interface Props {
  tool: ToolItem;
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const ws = getWorkspaceStrings(lang);
const isEn = lang === 'en';
const payload = { ...ws, __isEn: isEn };
---

  <style>
    .mg-form {
      display:        flex;
      flex-direction: column;
      gap:            var(--space-5);
      padding:        var(--space-5);
      background:     var(--bg-base);
      flex:           1;
    }

    .mg-field {
      display:        flex;
      flex-direction: column;
      gap:            var(--space-2);
    }

    .mg-field__label {
      font-size:      var(--text-xs);
      font-weight:    var(--font-semibold);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color:          var(--text-secondary);
    }

    .mg-field__hint {
      font-size:   var(--text-xs);
      color:       var(--text-muted);
      line-height: var(--leading-relaxed);
    }

    .mg-control {
      width:         100%;
      padding:       var(--space-3) var(--space-4);
      background:    var(--bg-raised);
      color:         var(--text-primary);
      border:        1px solid var(--bg-border);
      border-radius: var(--radius-md);
      font-size:     var(--text-sm);
      font-family:   var(--font-sans);
      outline:       none;
      transition:    border-color var(--transition-fast), box-shadow var(--transition-fast);
    }

    .mg-control:focus-visible {
      border-color: var(--accent);
      box-shadow:   0 0 0 3px var(--accent-glow);
    }

    .mg-actions {
      display:     flex;
      flex-wrap:   wrap;
      gap:         var(--space-3);
      margin-top:  auto;
      padding-top: var(--space-4);
    }
  </style>

  <div class="tw-workspace tw-workspace--sticky-out">
    <!-- ── LEFT: input / configuration ───────────────────────── -->
    <section class="tw-pane tw-pane--input" aria-label={isEn ? 'Mock data options' : ws.mockOptionsTitle}>
      <div class="tw-pane__header">
        <h2 class="tw-pane__title">{ws.mockOptionsTitle} <span class="tw-pane__side">{ws.inputPaneSide}</span></h2>
      </div>
      <div class="mg-form">
        <div class="mg-field">
          <label class="mg-field__label" for="template-select">{ws.mockTemplateLabel}</label>
          <select class="mg-control" id="template-select" aria-describedby="template-hint">
            <option value="users" selected>{ws.mockTplUsers}</option>
            <option value="products">{ws.mockTplProducts}</option>
            <option value="transactions">{ws.mockTplTransactions}</option>
            <option value="logs">{ws.mockTplLogs}</option>
          </select>
          <span class="mg-field__hint" id="template-hint">{ws.mockTplHint}</span>
        </div>

        <div class="mg-field">
          <label class="mg-field__label" for="count-input">{ws.mockCountLabel}</label>
          <input class="mg-control" type="number" id="count-input" value="10" min="1" max="500" aria-describedby="count-hint" />
          <span class="mg-field__hint" id="count-hint">{ws.mockCountHint}</span>
        </div>

        <div class="mg-field">
          <label class="mg-field__label" for="root-key-input">{ws.mockRootKeyLabel} <span style="text-transform:none;font-weight:400;color:var(--text-muted)">{ws.mockOptionalParen}</span></label>
          <input class="mg-control" type="text" id="root-key-input" placeholder={ws.mockRootKeyPlaceholder} maxlength="40" aria-describedby="root-hint" />
          <span class="mg-field__hint" id="root-hint">{ws.mockRootKeyHintBefore} <code>&#123;"data": [ … ]&#125;</code>.</span>
        </div>

        <div class="mg-field">
          <label class="mg-field__label" for="indent-select">{ws.mockOutputFormatLabel}</label>
          <select class="mg-control" id="indent-select">
            <option value="2" selected>{ws.mockFmt2}</option>
            <option value="4">{ws.mockFmt4}</option>
            <option value="0">{ws.mockFmt0}</option>
          </select>
        </div>

        <div class="mg-actions">
          <button class="btn btn--primary" id="generate-btn">{ws.mockGenerateBtn}</button>
          <button class="btn btn--ghost btn--sm" id="clear-btn">{ws.clearOutput}</button>
        </div>
      </div>
    </section>

    <!-- ── RIGHT: output ─────────────────────────────────────── -->
    <section class="tw-pane tw-pane--output" aria-label={ws.mockOutTitle}>
      <div class="tw-pane__header">
        <h2 class="tw-pane__title">{ws.mockOutTitle} <span class="tw-pane__side">{ws.outputPaneSide}</span></h2>
        <div class="tw-pane__meta">
          <span id="stat-records">0 {ws.mockRecordPlural}</span>
          <span id="stat-size">0 B</span>
        </div>
      </div>
      <pre class="tw-output" id="converter-output" tabindex="0" data-placeholder={ws.mockEmptyPlaceholder}></pre>
      <div class="tw-pane__header" style="border-top:1px solid var(--bg-border);border-bottom:0">
        <button class="btn btn--ghost btn--sm" id="copy-btn">{ws.copy}</button>
        <button class="btn btn--ghost btn--sm" id="download-btn">{ws.downloadJson}</button>
      </div>
    </section>
  </div>

  <div id="tool-status" role="status" aria-live="polite" style="margin-top:var(--space-4)"></div>

  <script id="ws-i18n-data" type="application/json" is:inline set:html={JSON.stringify(payload).replace(/</g, '\\u003c')} />
  <script is:inline>

    (function() {
      'use strict';
      const WS = JSON.parse(document.getElementById('ws-i18n-data')?.textContent || '{}');
      const templateSel = document.getElementById('template-select');
      const countInput  = document.getElementById('count-input');
      const rootKeyEl   = document.getElementById('root-key-input');
      const indentSel   = document.getElementById('indent-select');
      const outputEl    = document.getElementById('converter-output');
      const statusEl    = document.getElementById('tool-status');
      const recordsEl   = document.getElementById('stat-records');
      const sizeEl      = document.getElementById('stat-size');

      function showStatus(msg, type = 'info') {
        statusEl.innerHTML = msg ? `<div class="alert alert--${type}">${msg}</div>` : '';
      }

      function formatBytes(n) {
        if (n < 1024) return n + ' B';
        if (n < 1048576) return (n / 1024).toFixed(1) + ' KB';
        return (n / 1048576).toFixed(2) + ' MB';
      }

      function setStats(count, text) {
        const unit = count === 1 ? (WS.mockRecordSingular || 'record') : (WS.mockRecordPlural || 'records');
        recordsEl.textContent = count + ' ' + unit;
        sizeEl.textContent = formatBytes(new Blob([text]).size);
      }

      function generate() {
        const tpl = templateSel.value;
        const { json, error } = JT.generateMockJson(tpl, countInput.value);
        if (error) {
          showStatus(`Mock generation error: ${error}`, 'error');
          return;
        }

        let items;
        try {
          items = JSON.parse(json);
        } catch (e) {
          showStatus('Mock generation error: could not parse generated data.', 'error');
          return;
        }

        const indent = parseInt(indentSel.value, 10) || 0;
        const rootKey = rootKeyEl.value.trim();
        const payload = rootKey ? { [rootKey]: items } : items;
        const text = JSON.stringify(payload, null, indent);

        outputEl.textContent = text;
        setStats(items.length, text);
        const okMsg = WS.__isEn
          ? `Generated ${items.length} synthetic ${tpl} records.`
          : `${WS.mockGeneratedPrefix || 'Generated'} ${items.length} (${tpl}) ${WS.mockGeneratedSuffix || 'synthetic records.'}`;
        showStatus(okMsg, 'success');
      }

      function clearOutput() {
        outputEl.textContent = '';
        recordsEl.textContent = '0 ' + (WS.mockRecordPlural || 'records');
        sizeEl.textContent = '0 B';
        showStatus('');
      }

      document.getElementById('generate-btn').addEventListener('click', generate);
      document.getElementById('clear-btn').addEventListener('click', clearOutput);
      templateSel.addEventListener('change', generate);
      indentSel.addEventListener('change', function () { if (outputEl.textContent) generate(); });
      rootKeyEl.addEventListener('input', JT.debounce(function () { if (outputEl.textContent) generate(); }, 300));
      countInput.addEventListener('input', JT.debounce(generate, 300));

      document.getElementById('copy-btn').addEventListener('click', () => {
        const res = outputEl.textContent;
        if (!res) return showStatus(WS.mockNothingCopy || 'Nothing to copy — generate a dataset first.', 'warning');
        JT.copyToClipboard(res)
          .then(() => showStatus(WS.__isEn ? 'Copied mock JSON to clipboard.' : (WS.copied || 'Copied!'), 'success'))
          .catch(() => showStatus(WS.copyFailed || 'Copy failed.', 'warning'));
      });

      document.getElementById('download-btn').addEventListener('click', () => {
        const res = outputEl.textContent;
        if (!res) return showStatus(WS.mockNothingDl || 'Nothing to download — generate a dataset first.', 'warning');
        const blob = new Blob([res], { type: 'application/json;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `mock_${templateSel.value}.json`;
        a.click();
        setTimeout(() => URL.revokeObjectURL(url), 5000);
      });

      generate();
    })();
  
</script>

