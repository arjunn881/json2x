---
import type { ToolItem } from '../../../data/tools';
import { defaultLang, type Lang } from '../../../i18n/ui';
import { getLocalizedTool } from '../../../i18n/tools';
import { getWorkspaceStrings } from '../../../i18n/workspaces';

export interface Props {
  tool: ToolItem;
  lang?: Lang;
}

const { tool, lang = defaultLang } = Astro.props;
const locTool = getLocalizedTool(tool, lang);
const ws = getWorkspaceStrings(lang);
const isEn = lang === 'en';
const payload = { ...ws, __isEn: isEn };
---

  <div class="options-bar">
        <label class="flex items-center gap-2 text-sm text-secondary">
          <input type="checkbox" id="mark-required" checked /> {ws.schemaMarkAllReq}
        </label>
        <label class="flex items-center gap-2 text-sm text-secondary">
          <input type="checkbox" id="add-examples" checked /> {ws.tabIncludeExamples}
        </label>
        <button class="btn btn--primary" id="generate-btn">{ws.schemaGenTitle}</button>
        <button class="btn btn--ghost btn--sm" id="copy-btn" style="margin-left:auto">{ws.copySchema}</button>
        <button class="btn btn--ghost btn--sm" id="clear-btn">{ws.clear}</button>
      </div>

      <div class="split-pane">
        <div class="pane">
          <div class="pane__header"><span class="pane__title">{locTool.inputLabel || ws.schemaSampleInputTitle}</span></div>
          <textarea class="textarea" id="json-input"
            placeholder={ws.placeholderPasteJson} aria-label={isEn ? 'JSON sample input' : ws.schemaSampleInputTitle} spellcheck="false"></textarea>
        </div>
        <div class="pane">
          <div class="pane__header">
            <span class="pane__title">{locTool.outputLabel || ws.schemaOutputTitle}</span>
          </div>
          <pre class="code-output" id="schema-output" tabindex="0"></pre>
        </div>
      </div>

      <div id="tool-status" role="status" aria-live="polite" style="margin-top:var(--space-4)"></div>

  <script id="ws-i18n-data" type="application/json" is:inline set:html={JSON.stringify(payload).replace(/</g, '\\u003c')} />
  <script is:inline>

    const WS = JSON.parse(document.getElementById('ws-i18n-data')?.textContent || '{}');

    /**
     * Minimal JSON Schema draft-07 inferencer.
     * Full implementation with $defs, anyOf, array-item merging goes in phase 2.
     */
    function inferSchema(value, addExamples) {
      const type = JT.getType(value);

      if (type === 'null')    return { type: 'null' };
      if (type === 'boolean') return addExamples ? { type: 'boolean', examples: [value] } : { type: 'boolean' };
      if (type === 'number')  return addExamples ? { type: 'number',  examples: [value] } : { type: 'number' };
      if (type === 'string')  return addExamples ? { type: 'string',  examples: [value] } : { type: 'string' };

      if (type === 'array') {
        const schema = { type: 'array' };
        if (value.length > 0) schema.items = inferSchema(value[0], addExamples);
        return schema;
      }

      if (type === 'object') {
        const schema = { type: 'object', properties: {} };
        const keys = Object.keys(value);
        keys.forEach(k => { schema.properties[k] = inferSchema(value[k], addExamples); });
        if (document.getElementById('mark-required').checked && keys.length > 0) {
          schema.required = keys;
        }
        return schema;
      }

      return {};
    }

    const statusEl = document.getElementById('tool-status');
    function showStatus(msg, type = 'info') {
      statusEl.innerHTML = msg ? `<div class="alert alert--${type}">${msg}</div>` : '';
    }

    function generate() {
      const { data, error, line } = JT.parseJSON(document.getElementById('json-input').value);
      if (error) {
        const lineLbl = line ? ` (${(WS.__isEn ? 'line' : WS.lineWord || 'line')} ${line})` : '';
        showStatus(`<svg aria-hidden="true" width="12" height="12" viewBox="0 0 12 12" fill="none" style="vertical-align:-1px;margin-right:3px"><path d="M2 2l8 8M10 2l-8 8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>${error}${lineLbl}`, 'error');
        return;
      }

      const addExamples = document.getElementById('add-examples').checked;
      const schema = {
        $schema: 'http://json-schema.org/draft-07/schema#',
        ...inferSchema(data, addExamples)
      };

      const { text } = JT.stringifyJSON(schema, 2);
      document.getElementById('schema-output').textContent = text;
      showStatus('<svg aria-hidden="true" width="12" height="12" viewBox="0 0 12 12" fill="none" style="vertical-align:-1px;margin-right:3px"><path d="M2 6l3 3 5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>' + (WS.schemaGeneratedMsg || 'Schema generated'), 'success');
    }

    document.getElementById('generate-btn').addEventListener('click', generate);
    document.getElementById('json-input').addEventListener('input', JT.debounce(generate, 500));

    document.getElementById('copy-btn').addEventListener('click', () => {
      JT.copyToClipboard(document.getElementById('schema-output').textContent)
        .then(() => showStatus(WS.copied || 'Copied!', 'success'))
        .catch(() => showStatus(WS.copyFailed || 'Copy failed.', 'warning'));
    });

    document.getElementById('clear-btn').addEventListener('click', () => {
      document.getElementById('json-input').value = '';
      document.getElementById('schema-output').textContent = '';
      showStatus('');
    });
  
</script>

