---
import type { ToolItem } from '../../../data/tools';
import { defaultLang, type Lang } from '../../../i18n/ui';
import { getLocalizedTool } from '../../../i18n/tools';
import { getWorkspaceStrings } from '../../../i18n/workspaces';

export interface Props {
  tool: ToolItem;
  lang?: Lang;
}

const { tool, lang = defaultLang } = Astro.props;
const locTool = getLocalizedTool(tool, lang);
const ws = getWorkspaceStrings(lang);
const isEn = lang === 'en';
const payload = { ...ws, __isEn: isEn };
---

  <div class="options-bar" style="display:flex;align-items:center;flex-wrap:wrap;gap:var(--space-3);padding:var(--space-3) var(--space-4);background:var(--bg-raised);border:1px solid var(--bg-border);border-radius:var(--radius-lg);margin-bottom:var(--space-4);">
        <label class="flex items-center gap-2 text-sm text-secondary">
          {ws.targetLangLabel}
          <select id="lang-select" class="jc-select" style="padding:4px 8px;background:var(--bg-base);color:var(--text-primary);border:1px solid var(--bg-border);border-radius:4px;" aria-label={isEn ? 'Target Programming Language' : ws.targetLangLabel}>
            <option value="go" selected>{ws.goStructLabel}</option>
            <option value="rust">{ws.rustStructLabel}</option>
            <option value="python">{ws.pythonPydanticLabel}</option>
          </select>
        </label>
        <label class="flex items-center gap-2 text-sm text-secondary">
          {isEn ? 'Root Name:' : `${ws.rootNameLabel}:`}
          <input type="text" id="root-name" value="AutoGenerated" style="padding:4px 8px;background:var(--bg-base);color:var(--text-primary);border:1px solid var(--bg-border);border-radius:4px;width:130px;" aria-label={isEn ? 'Root Struct Name' : ws.rootNameLabel} />
        </label>
        <button class="btn btn--primary" id="convert-btn">{ws.generateCodeBtn}</button>
        <button class="btn btn--ghost btn--sm" id="copy-btn" style="margin-left:auto">{ws.copyCode}</button>
        <button class="btn btn--ghost btn--sm" id="download-btn">{ws.download}</button>
        <button class="btn btn--ghost btn--sm" id="clear-btn">{ws.clear}</button>
      </div>

      <div class="split-pane">
        <div class="pane">
          <div class="pane__header"><span class="pane__title">{locTool.inputLabel || ws.jsonPayload}</span></div>
          <textarea class="textarea" id="converter-input"
            placeholder='{"user": {"id": 42, "username": "dev_hero", "roles": ["admin"]}, "meta": {"version": 1.2}}'
            aria-label={ws.jsonInput} spellcheck="false" style="min-height:320px;font-family:var(--font-mono);"></textarea>
        </div>
        <div class="pane">
          <div class="pane__header"><span class="pane__title" id="output-title">{locTool.outputLabel || ws.goOutputTitle}</span></div>
          <pre class="code-output" id="converter-output" tabindex="0" style="min-height:320px;font-family:var(--font-mono);padding:var(--space-4);background:var(--bg-base);border:1px solid var(--bg-border);border-radius:var(--radius-lg);overflow:auto;"></pre>
        </div>
      </div>

      <div id="tool-status" role="status" aria-live="polite" style="margin-top:var(--space-4)"></div>

  <script id="ws-i18n-data" type="application/json" is:inline set:html={JSON.stringify(payload).replace(/</g, '\\u003c')} />
  <script is:inline>

    (function() {
      'use strict';
      const WS = JSON.parse(document.getElementById('ws-i18n-data')?.textContent || '{}');
      const langSel = document.getElementById('lang-select');
      const rootNameInput = document.getElementById('root-name');
      const inputEl = document.getElementById('converter-input');
      const outputEl = document.getElementById('converter-output');
      const outputTitle = document.getElementById('output-title');
      const statusEl = document.getElementById('tool-status');

      function showStatus(msg, type = 'info') {
        statusEl.innerHTML = msg ? `<div class="alert alert--${type}">${msg}</div>` : '';
      }

      function convert() {
        const text = inputEl.value.trim();
        const lang = langSel.value;

        if (!text) {
          outputEl.textContent = '';
          showStatus('');
          return;
        }

        const { data, error } = JT.parseJSON(text);
        if (error) {
          showStatus(`${WS.jsonParseError || 'JSON Parse Error'}: ${error}`, 'error');
          return;
        }

        const opts = { structName: rootNameInput.value.trim() || 'AutoGenerated', className: rootNameInput.value.trim() || 'AutoGenerated' };
        let res = { code: '', error: null };

        if (lang === 'go') {
          outputTitle.textContent = WS.goOutputTitle || 'Go Struct Output';
          res = JT.jsonToGo(data, opts);
        } else if (lang === 'rust') {
          outputTitle.textContent = WS.rustOutputTitle || 'Rust Struct Output';
          res = JT.jsonToRust(data, opts);
        } else if (lang === 'python') {
          outputTitle.textContent = WS.pythonOutputTitle || 'Python Pydantic Output';
          res = JT.jsonToPython(data, opts);
        }

        if (res.error) {
          showStatus(`Generation Error: ${res.error}`, 'error');
          return;
        }

        outputEl.textContent = res.code;
        showStatus(
          WS.__isEn
            ? `Successfully generated ${lang.toUpperCase()} code model!`
            : `${lang.toUpperCase()} — ${WS.statusCodeSuccess || 'Successfully generated code model!'}`,
          'success'
        );
      }

      document.getElementById('convert-btn').addEventListener('click', convert);
      inputEl.addEventListener('input', JT.debounce(convert, 400));
      rootNameInput.addEventListener('input', JT.debounce(convert, 400));
      langSel.addEventListener('change', convert);

      document.getElementById('copy-btn').addEventListener('click', () => {
        const res = outputEl.textContent;
        if (!res) return;
        JT.copyToClipboard(res)
          .then(() => showStatus(WS.__isEn ? 'Copied code to clipboard!' : (WS.copied || 'Copied!'), 'success'))
          .catch(() => showStatus(WS.copyFailed || 'Copy failed.', 'warning'));
      });

      document.getElementById('download-btn').addEventListener('click', () => {
        const res = outputEl.textContent;
        if (!res) return;
        const lang = langSel.value;
        const ext = lang === 'go' ? 'go' : (lang === 'rust' ? 'rs' : 'py');
        const blob = new Blob([res], { type: 'text/plain;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `model.${ext}`;
        a.click();
        setTimeout(() => URL.revokeObjectURL(url), 5000);
      });

      document.getElementById('clear-btn').addEventListener('click', () => {
        inputEl.value = '';
        outputEl.textContent = '';
        showStatus('');
      });
    })();
  
</script>

