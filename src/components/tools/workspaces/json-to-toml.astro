---
import type { ToolItem } from '../../../data/tools';
import { defaultLang, type Lang } from '../../../i18n/ui';
import { getLocalizedTool } from '../../../i18n/tools';
import { getWorkspaceStrings } from '../../../i18n/workspaces';

export interface Props {
  tool: ToolItem;
  lang?: Lang;
}

const { tool, lang = defaultLang } = Astro.props;
const locTool = getLocalizedTool(tool, lang);
const ws = getWorkspaceStrings(lang);
const isEn = lang === 'en';
const payload = { ...ws, __isEn: isEn };
---

  <div class="options-bar" style="display:flex;align-items:center;flex-wrap:wrap;gap:var(--space-3);padding:var(--space-3) var(--space-4);background:var(--bg-raised);border:1px solid var(--bg-border);border-radius:var(--radius-lg);margin-bottom:var(--space-4);">
        <button class="btn btn--primary" id="convert-btn">{ws.convert}</button>
        <button class="btn btn--ghost btn--sm" id="copy-btn" style="margin-left:auto">{isEn ? 'Copy TOML' : ws.copyOutput}</button>
        <button class="btn btn--ghost btn--sm" id="download-btn">{ws.downloadToml}</button>
        <button class="btn btn--ghost btn--sm" id="clear-btn">{ws.clear}</button>
      </div>

      <div class="split-pane">
        <div class="pane">
          <div class="pane__header"><span class="pane__title">{locTool.inputLabel || ws.jsonInput}</span></div>
          <textarea class="textarea" id="converter-input"
            placeholder='{"package":{"name":"my-app","version":"1.0.0"},"dependencies":{"serde":"1.0"}}'
            aria-label={isEn ? 'Input code pane' : ws.jsonInput} spellcheck="false" style="min-height:300px;font-family:var(--font-mono);"></textarea>
        </div>
        <div class="pane">
          <div class="pane__header"><span class="pane__title">{locTool.outputLabel || ws.tomlOutput}</span></div>
          <pre class="code-output" id="converter-output" tabindex="0" style="min-height:300px;font-family:var(--font-mono);padding:var(--space-4);background:var(--bg-base);border:1px solid var(--bg-border);border-radius:var(--radius-lg);overflow:auto;"></pre>
        </div>
      </div>

      <div id="tool-status" role="status" aria-live="polite" style="margin-top:var(--space-4)"></div>

  <script id="ws-i18n-data" type="application/json" is:inline set:html={JSON.stringify(payload).replace(/</g, '\\u003c')} />
  <script is:inline>

    (function() {
      'use strict';
      const WS = JSON.parse(document.getElementById('ws-i18n-data')?.textContent || '{}');
      const inputEl = document.getElementById('converter-input');
      const outputEl = document.getElementById('converter-output');
      const statusEl = document.getElementById('tool-status');

      function showStatus(msg, type = 'info') {
        statusEl.innerHTML = msg ? `<div class="alert alert--${type}">${msg}</div>` : '';
      }

      function convert() {
        const text = inputEl.value.trim();
        if (!text) {
          outputEl.textContent = '';
          showStatus('');
          return;
        }

        const { data, error } = JT.parseJSON(text);
        if (error) {
          showStatus(`${WS.jsonParseError || 'JSON Parse Error'}: ${error}`, 'error');
          return;
        }

        const { toml, error: tErr } = JT.jsonToToml(data);
        if (tErr) {
          showStatus(`TOML Error: ${tErr}`, 'error');
          return;
        }

        outputEl.textContent = toml;
        showStatus(`${WS.statusConvertedTo || 'Successfully converted to'} TOML`, 'success');
      }

      document.getElementById('convert-btn').addEventListener('click', convert);
      inputEl.addEventListener('input', JT.debounce(convert, 400));

      document.getElementById('copy-btn').addEventListener('click', () => {
        const res = outputEl.textContent;
        if (!res) return;
        JT.copyToClipboard(res)
          .then(() => showStatus(WS.__isEn ? 'Copied to clipboard!' : (WS.copied || 'Copied!'), 'success'))
          .catch(() => showStatus(WS.copyFailed || 'Copy failed.', 'warning'));
      });

      document.getElementById('download-btn').addEventListener('click', () => {
        const res = outputEl.textContent;
        if (!res) return;
        const blob = new Blob([res], { type: 'text/plain;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'config.toml';
        a.click();
        setTimeout(() => URL.revokeObjectURL(url), 5000);
      });

      document.getElementById('clear-btn').addEventListener('click', () => {
        inputEl.value = '';
        outputEl.textContent = '';
        showStatus('');
      });
    })();
  
</script>

