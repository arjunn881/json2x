---
import DocsHubPage from '../../../components/pages/DocsHubPage.astro';
import { NON_DEFAULT_LOCALES, type Lang } from '../../../i18n/ui';

export function getStaticPaths() {
  return NON_DEFAULT_LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
---

<DocsHubPage lang={lang} />

