---
import BlogHubPage from '../../../components/pages/BlogHubPage.astro';
import { NON_DEFAULT_LOCALES, type Lang } from '../../../i18n/ui';

export function getStaticPaths() {
  return NON_DEFAULT_LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
---

<BlogHubPage lang={lang} />

