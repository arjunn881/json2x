---
import ToolLayout from '../../layouts/ToolLayout.astro';
import { getToolBySlugOrId } from '../../data/tools';

const tool = getToolBySlugOrId('json-tree-viewer')!;
---

<ToolLayout tool={tool}>
  <style>
    /* ── Tree pane body ──────────────────────────────────────── */
    .tree-wrap {
      flex:        1;
      min-height:  320px;
      max-height:  70vh;
      padding:     var(--space-4);
      background:  var(--bg-base);
      font-family: var(--font-mono);
      font-size:   var(--text-xs);
      line-height: 1.8;
      overflow:    auto;
    }
    .tree-wrap:empty::after {
      content:    attr(data-placeholder);
      color:      var(--text-muted);
      font-style: italic;
    }

    .tree-node { padding-left: var(--space-5); position: relative; }
    .tree-node::before {
      content:    '';
      position:   absolute;
      left:       8px;
      top:        0;
      bottom:     0;
      width:      1px;
      background: var(--bg-border);
    }
    .tree-toggle {
      cursor:      pointer;
      user-select: none;
      display:     inline-flex;
      align-items: center;
      gap:         var(--space-1);
      border:      none;
      background:  transparent;
      color:       inherit;
      font:        inherit;
      padding:     0;
    }
    .tree-toggle::before {
      content:        '';
      width:          0;
      height:         0;
      margin-right:   4px;
      display:        inline-block;
      vertical-align: 1px;
      border-left:    4px solid transparent;
      border-right:   4px solid transparent;
      border-top:     5px solid var(--text-muted);
      transition:     transform var(--transition-fast);
    }
    .tree-toggle.collapsed::before { transform: rotate(-90deg); }

    .tree-key   { color: var(--hl-key); }
    .tree-colon { color: var(--text-muted); margin-inline: 2px; }
    .type-string  { color: var(--hl-str); }
    .type-number  { color: var(--hl-num); }
    .type-boolean { color: var(--hl-bool); }
    .type-null    { color: var(--hl-null); }
    .tree-count   { font-size: 10px; color: var(--text-muted); margin-left: var(--space-2); }
    .tree-row--dim { opacity: 0.2; }
    /* ── Search field ─────────────────────────────────────────── */
    .search-input-wrap { position: relative; max-width: 320px; flex: 1 1 220px; }
    .search-input-wrap svg {
      position:       absolute;
      left:           10px;
      top:            50%;
      transform:      translateY(-50%);
      color:          var(--text-muted);
      pointer-events: none;
    }
    #search-input { padding-left: 34px; }

    /* ── Parse error — foot of the input pane ─────────────────── */
    .tv-error {
      display:     flex;
      align-items: flex-start;
      gap:         var(--space-3);
      padding:     var(--space-3) var(--space-4);
      background:  var(--error-bg);
      color:       var(--error);
      border-top:  1px solid var(--error);
      font-size:   var(--text-xs);
      font-family: var(--font-mono);
    }
    .tv-error[hidden] { display: none; }
  </style>
  <div class="options-bar">
    <div class="search-input-wrap">
      <svg width="14" height="14" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <circle cx="9" cy="9" r="6" stroke="currentColor" stroke-width="2"/>
        <path d="M14 14l3 3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
      <input type="search" id="search-input" class="input" placeholder="Search keys &amp; values…" aria-label="Search JSON tree" />
    </div>
    <button class="btn btn--ghost btn--sm" id="expand-all-btn">Expand all</button>
    <button class="btn btn--ghost btn--sm" id="collapse-all-btn">Collapse all</button>
    <button class="btn btn--ghost btn--sm" id="sample-btn">Load sample</button>
    <button class="btn btn--ghost btn--sm" id="clear-btn" style="margin-left:auto">Clear</button>
  </div>

  <div class="tw-workspace tw-workspace--sticky-out">
    <!-- LEFT: input -->
    <section class="tw-pane tw-pane--input" aria-labelledby="tv-in-title">
      <div class="tw-pane__header">
        <h2 class="tw-pane__title" id="tv-in-title">
          {tool.inputLabel || 'JSON Input'}
          <span class="tw-pane__side">Input</span>
        </h2>
        <span class="tw-pane__meta" id="input-size"></span>
      </div>
      <textarea
        class="tw-input"
        id="json-input"
        placeholder={'{"user":{"name":"Alice","roles":["admin","user"]}}'}
        aria-label="JSON input"
        spellcheck="false"
        autocapitalize="off"
        autocomplete="off"
      ></textarea>
      <div class="tv-error" id="tv-error" hidden role="alert" aria-live="assertive"></div>
    </section>
    <!-- RIGHT: interactive tree -->
    <section class="tw-pane tw-pane--output" aria-labelledby="tv-out-title">
      <div class="tw-pane__header">
        <h2 class="tw-pane__title" id="tv-out-title">
          {tool.outputLabel || 'Tree View'}
          <span class="tw-pane__side">Output</span>
        </h2>
        <span class="tw-pane__meta" id="tree-meta"></span>
      </div>
      <div
        class="tree-wrap"
        id="tree-output"
        role="tree"
        aria-label="JSON tree"
        data-placeholder="The collapsible tree appears here — paste JSON on the left."
      ></div>
    </section>
  </div>

  <script is:inline>
    (function () {
      'use strict';

      var treeEl  = document.getElementById('tree-output');
      var inputEl = document.getElementById('json-input');
      var errorEl = document.getElementById('tv-error');
      var metaEl  = document.getElementById('tree-meta');

      function esc(s) {
        return String(s)
          .replace(/&/g, '&amp;').replace(/</g, '&lt;')
          .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
      }

      function renderValue(val, key) {
        var type = JT.getType(val);
        var keySpan = key !== null
          ? '<span class="tree-key">' + esc(JSON.stringify(key)) + '</span><span class="tree-colon">:</span>'
          : '';

        if (type === 'string')  return keySpan + '<span class="type-string">' + esc(JSON.stringify(val)) + '</span>';
        if (type === 'number')  return keySpan + '<span class="type-number">' + val + '</span>';
        if (type === 'boolean') return keySpan + '<span class="type-boolean">' + val + '</span>';
        if (type === 'null')    return keySpan + '<span class="type-null">null</span>';

        var isArr = type === 'array';
        var open  = isArr ? '[' : '{';
        var close = isArr ? ']' : '}';
        var len   = isArr ? val.length : Object.keys(val).length;
        var label = isArr ? 'Array[' + len + ']' : 'Object{' + len + '}';

        var children = '';
        if (isArr) {
          val.forEach(function (item, i) {
            children += '<div class="tree-row">' + renderValue(item, i) + '</div>';
          });
        } else {
          Object.keys(val).forEach(function (k) {
            children += '<div class="tree-row">' + renderValue(val[k], k) + '</div>';
          });
        }

        return keySpan +
          '<button class="tree-toggle" aria-expanded="true">' + open +
          ' <span class="tree-count">' + label + '</span></button>' +
          '<div class="tree-node">' + children + '</div>' +
          '<span class="type-null">' + close + '</span>';
      }
      function setToggle(btn, collapsed) {
        btn.classList.toggle('collapsed', collapsed);
        btn.setAttribute('aria-expanded', String(!collapsed));
        var node = btn.nextElementSibling;
        if (node) node.style.display = collapsed ? 'none' : '';
      }

      function renderTree(data) {
        treeEl.innerHTML = '<div class="tree-row">' + renderValue(data, null) + '</div>';
        // One delegated listener beats one per node — large documents can
        // produce thousands of toggles.
        var stats = JT.countNodes(data);
        metaEl.textContent = stats.keys.toLocaleString() + ' keys · depth ' + stats.depth;
      }

      treeEl.addEventListener('click', function (e) {
        var btn = e.target.closest ? e.target.closest('.tree-toggle') : null;
        if (!btn || !treeEl.contains(btn)) return;
        setToggle(btn, !btn.classList.contains('collapsed'));
      });

      function parse() {
        var raw = inputEl.value;
        document.getElementById('input-size').textContent = raw.trim() ? JT.formatBytes(new Blob([raw]).size) : '';

        if (!raw.trim()) {
          errorEl.hidden = true;
          treeEl.innerHTML = '';
          metaEl.textContent = '';
          return;
        }

        var res = JT.parseJSON(raw);
        if (res.error) {
          errorEl.textContent = res.error + (res.line ? ' (line ' + res.line + ')' : '');
          errorEl.hidden = false;
          treeEl.innerHTML = '';
          metaEl.textContent = '';
          return;
        }

        errorEl.hidden = true;
        renderTree(res.data);
      }
      inputEl.addEventListener('input', JT.debounce(parse, 400));

      document.getElementById('expand-all-btn').addEventListener('click', function () {
        treeEl.querySelectorAll('.tree-toggle').forEach(function (btn) { setToggle(btn, false); });
      });

      document.getElementById('collapse-all-btn').addEventListener('click', function () {
        treeEl.querySelectorAll('.tree-toggle').forEach(function (btn) { setToggle(btn, true); });
      });

      document.getElementById('sample-btn').addEventListener('click', function () {
        inputEl.value = JSON.stringify({
          user: {
            id: 4821,
            name: 'Alice',
            roles: ['admin', 'user'],
            profile: { city: 'London', joined: '2026-01-14', verified: true }
          },
          orders: [
            { id: 'A-1001', total: 39.98, items: 2 },
            { id: 'B-2002', total: 149.5, items: 1 }
          ],
          deletedAt: null
        }, null, 2);
        parse();
      });

      document.getElementById('clear-btn').addEventListener('click', function () {
        inputEl.value = '';
        treeEl.innerHTML = '';
        errorEl.hidden = true;
        metaEl.textContent = '';
        document.getElementById('input-size').textContent = '';
        inputEl.focus();
      });

      document.getElementById('search-input').addEventListener('input', JT.debounce(function () {
        var q = this.value.trim().toLowerCase();
        treeEl.querySelectorAll('.tree-row').forEach(function (row) {
          if (!q) { row.classList.remove('tree-row--dim'); return; }
          row.classList.toggle('tree-row--dim', row.textContent.toLowerCase().indexOf(q) === -1);
        });
      }, 250));
    })();
  </script>

</ToolLayout>
