---
import ToolLayout from '../../layouts/ToolLayout.astro';
import { getToolBySlugOrId } from '../../data/tools';

const tool = getToolBySlugOrId('csv-to-json')!;
---

<ToolLayout tool={tool}>
  <style>
    /* Syntax highlight tokens (shared vocabulary with the formatter) */
    .hl-key  { color: var(--hl-key); }
    .hl-str  { color: var(--hl-str); }
    .hl-num  { color: var(--hl-num); }
    .hl-bool { color: var(--hl-bool); }
    .hl-null { color: var(--hl-null); }

    /* ── Toolbar ─────────────────────────────────────────────── */
    .cj-toolbar {
      display:       flex;
      align-items:   center;
      flex-wrap:     wrap;
      gap:           var(--space-2);
      padding:       var(--space-3) var(--space-4);
      background:    var(--bg-raised);
      border:        1px solid var(--bg-border);
      border-radius: var(--radius-lg);
      margin-bottom: var(--space-4);
    }
    .cj-toolbar__divider { width:1px; height:24px; background:var(--bg-border); flex-shrink:0; margin-inline:var(--space-1); }
    .cj-toolbar__label   { font-size:var(--text-xs); font-weight:var(--font-semibold); color:var(--text-muted); text-transform:uppercase; letter-spacing:0.06em; }

    .cj-select {
      width:auto; padding:var(--space-2) var(--space-3);
      background:var(--bg-base); color:var(--text-primary);
      border:1px solid var(--bg-border); border-radius:var(--radius-md);
      font-size:var(--text-xs); font-weight:var(--font-semibold);
      cursor:pointer; outline:none; transition:border-color var(--transition-fast);
    }
    .cj-select:focus { border-color:var(--accent); }

    .toggle-check {
      display:inline-flex; align-items:center; gap:var(--space-2);
      font-size:var(--text-xs); font-weight:var(--font-medium);
      color:var(--text-secondary); cursor:pointer; user-select:none;
    }
    .toggle-check input { accent-color:var(--accent); width:14px; height:14px; }
    /* ── Detected delimiter badge ─────────────────────────────── */
    .delim-badge {
      display:       inline-flex;
      align-items:   center;
      gap:           var(--space-1);
      padding:       2px var(--space-2);
      background:    var(--info-bg);
      color:         var(--info);
      border:        1px solid hsla(199,90%,58%,0.3);
      border-radius: var(--radius-full);
      font-size:     var(--text-xs);
      font-weight:   var(--font-semibold);
      font-family:   var(--font-mono);
    }
    .delim-badge[hidden] { display: none; }

    /* ── Error banner — foot of the input pane ────────────────── */
    .cj-error {
      display:flex; align-items:flex-start; gap:var(--space-3);
      padding:var(--space-3) var(--space-4);
      background:var(--error-bg); color:var(--error);
      border-top:1px solid var(--error);
      font-size:var(--text-xs);
    }
    .cj-error[hidden] { display: none; }
    .cj-error__badge {
      flex-shrink:0; background:var(--error); color:#fff;
      border-radius:var(--radius-sm); padding:1px var(--space-2);
      font-weight:var(--font-semibold); font-family:var(--font-mono);
    }

    /* ── Stats row ────────────────────────────────────────────── */
    .cj-stats {
      display:flex; align-items:center; flex-wrap:wrap; gap:var(--space-6);
      padding:var(--space-3) var(--space-5); background:var(--bg-raised);
      border:1px solid var(--bg-border); border-radius:var(--radius-lg);
      font-size:var(--text-xs); margin-top:var(--space-4);
    }
    .cj-stats[hidden] { display: none; }
    .cj-stat { display:flex; align-items:center; gap:var(--space-2); }
    .cj-stat__label { color:var(--text-muted); }
    .cj-stat__value { font-family:var(--font-mono); font-weight:var(--font-semibold); color:var(--text-primary); }
    .cj-stat--valid .cj-stat__value { color:var(--success); }
    /* ── Preview table ────────────────────────────────────────── */
    #preview-section { margin-top: var(--space-6); }
    #preview-section[hidden] { display: none; }

    .preview-wrap {
      overflow-x:    auto;
      overflow-y:    auto;
      max-height:    280px;
      border:        1px solid var(--bg-border);
      border-radius: var(--radius-lg);
    }
    .preview-table {
      width:           100%;
      border-collapse: collapse;
      font-size:       var(--text-xs);
      font-family:     var(--font-mono);
    }
    .preview-table th {
      padding:       var(--space-2) var(--space-3);
      background:    var(--bg-raised);
      color:         var(--text-secondary);
      font-weight:   var(--font-semibold);
      text-align:    left;
      border-bottom: 1px solid var(--bg-border);
      white-space:   nowrap;
      position:      sticky;
      top:           0;
      z-index:       1;
    }
    .preview-table td {
      padding:       var(--space-2) var(--space-3);
      border-bottom: 1px solid var(--bg-border);
      color:         var(--text-primary);
      max-width:     200px;
      overflow:      hidden;
      text-overflow: ellipsis;
      white-space:   nowrap;
    }
    .preview-table tr:last-child td { border-bottom: none; }
    .preview-table tr:nth-child(even) td { background: var(--bg-raised); }

    .td-null    { color: var(--text-muted); font-style: italic; }
    .td-number  { color: var(--hl-num); }
    .td-boolean { color: var(--hl-bool); }
  </style>
  <div class="cj-toolbar" role="toolbar" aria-label="Converter options">
    <div style="display:flex;align-items:center;gap:var(--space-2)">
      <span class="cj-toolbar__label">Delimiter</span>
      <select id="delimiter-select" class="cj-select" aria-label="CSV delimiter">
        <option value="" selected>Auto-detect</option>
        <option value=",">, comma</option>
        <option value=";">; semicolon</option>
        <option value="&#9;">⇥ tab</option>
        <option value="|">| pipe</option>
      </select>
      <span class="delim-badge" id="detected-badge" hidden></span>
    </div>

    <div class="cj-toolbar__divider" aria-hidden="true"></div>

    <label class="toggle-check">
      <input type="checkbox" id="coerce-toggle" checked aria-label="Coerce types" />
      Coerce types
    </label>

    <label class="toggle-check">
      <input type="checkbox" id="skip-empty-toggle" checked aria-label="Skip empty rows" />
      Skip empty rows
    </label>

    <div class="cj-toolbar__divider" aria-hidden="true"></div>

    <button class="btn btn--primary" id="convert-btn">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M3 7h8M7 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      Convert
    </button>

    <button class="btn btn--ghost btn--sm" id="sample-btn">Load sample</button>

    <button class="btn btn--ghost" id="clear-btn" style="margin-left:auto">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M2 2l10 10M12 2 2 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
      Clear
    </button>
  </div>
  <div class="tw-workspace tw-workspace--sticky-out">
    <!-- LEFT: CSV input -->
    <section class="tw-pane tw-pane--input" aria-labelledby="cj-in-title">
      <div class="tw-pane__header">
        <h2 class="tw-pane__title" id="cj-in-title">
          {tool.inputLabel || 'CSV Input'}
          <span class="tw-pane__side">Input</span>
        </h2>
        <span class="tw-pane__meta" id="input-meta"></span>
      </div>
      <textarea
        class="tw-input"
        id="csv-input"
        aria-label="CSV input"
        spellcheck="false"
        autocapitalize="off"
        autocomplete="off"
        placeholder="Paste CSV here, or drag &amp; drop a .csv file…"
      ></textarea>
      <div class="cj-error" id="cj-error" hidden role="alert" aria-live="assertive">
        <span class="cj-error__badge">ERR</span>
        <span id="cj-error-msg"></span>
      </div>
    </section>
    <!-- RIGHT: JSON output -->
    <section class="tw-pane tw-pane--output" aria-labelledby="cj-out-title">
      <div class="tw-pane__header">
        <h2 class="tw-pane__title" id="cj-out-title">
          {tool.outputLabel || 'JSON Output'}
          <span class="tw-pane__side">Output</span>
        </h2>
        <div class="tw-pane__actions">
          <span class="tw-pane__meta" id="output-meta"></span>
          <button class="btn btn--ghost btn--sm" id="copy-btn">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <rect x="4" y="4" width="8" height="8" rx="1.5" stroke="currentColor" stroke-width="1.5"/>
              <path d="M2 10V2h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            Copy
          </button>
          <button class="btn btn--ghost btn--sm" id="download-btn">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M7 1v8m0 0-3-3m3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M2 10v1.5A1.5 1.5 0 0 0 3.5 13h7a1.5 1.5 0 0 0 1.5-1.5V10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            .json
          </button>
        </div>
      </div>
      <pre
        class="tw-output"
        id="json-output"
        tabindex="0"
        role="region"
        aria-label="JSON output"
        aria-live="polite"
        data-placeholder="JSON appears here — paste CSV rows on the left."
      ></pre>
    </section>
  </div>
  <div class="cj-stats" id="cj-stats" hidden aria-live="polite">
    <div class="cj-stat cj-stat--valid">
      <span class="cj-stat__value" id="stat-valid"><svg aria-hidden="true" width="12" height="12" viewBox="0 0 12 12" fill="none" style="vertical-align:-1px;margin-right:3px"><path d="M2 6l3 3 5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>Converted</span>
    </div>
    <div class="cj-stat">
      <span class="cj-stat__label">Rows</span>
      <span class="cj-stat__value" id="stat-rows">—</span>
    </div>
    <div class="cj-stat">
      <span class="cj-stat__label">Columns</span>
      <span class="cj-stat__value" id="stat-cols">—</span>
    </div>
    <div class="cj-stat">
      <span class="cj-stat__label">Output size</span>
      <span class="cj-stat__value" id="stat-size">—</span>
    </div>
  </div>

  <section id="preview-section" hidden>
    <div class="tw-pane__header" style="border-radius:var(--radius-lg) var(--radius-lg) 0 0;border:1px solid var(--bg-border);border-bottom:none;">
      <h2 class="tw-pane__title">Row preview</h2>
      <span class="tw-pane__meta" id="preview-label"></span>
    </div>
    <div class="preview-wrap" style="border-radius:0 0 var(--radius-lg) var(--radius-lg);border-top:none;">
      <table class="preview-table" id="preview-table" aria-label="Data preview">
        <thead id="preview-head"></thead>
        <tbody id="preview-body"></tbody>
      </table>
    </div>
  </section>
  <script is:inline>
    (function () {
      'use strict';

      var inputEl     = document.getElementById('csv-input');
      var outputEl    = document.getElementById('json-output');
      var errorEl     = document.getElementById('cj-error');
      var errorMsgEl  = document.getElementById('cj-error-msg');
      var statsEl     = document.getElementById('cj-stats');
      var previewSec  = document.getElementById('preview-section');
      var previewHead = document.getElementById('preview-head');
      var previewBody = document.getElementById('preview-body');
      var delimSel    = document.getElementById('delimiter-select');
      var coerceCheck = document.getElementById('coerce-toggle');
      var skipCheck   = document.getElementById('skip-empty-toggle');
      var detectedBdg = document.getElementById('detected-badge');

      var PREVIEW_ROWS = 10;
      var lastJSON = '';

      function escHtml(s) {
        return String(s === null || s === undefined ? '' : s)
          .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      }

      /* Token-level highlighter: walks the serialised JSON once so string
         contents can never be mistaken for structural characters. */
      function buildHighlight(str) {
        var result = '';
        var i = 0;
        var len = str.length;

        while (i < len) {
          var ch = str[i];
          if (ch === '"') {
            var raw = '"'; i++;
            while (i < len) {
              var c = str[i]; raw += c;
              if (c === '\\') { i++; if (i < len) raw += str[i]; }
              else if (c === '"') break;
              i++;
            }
            i++;
            var j = i;
            while (j < len && (str[j] === ' ' || str[j] === '\r' || str[j] === '\n')) j++;
            var isKey = str[j] === ':';
            result += '<span class="' + (isKey ? 'hl-key' : 'hl-str') + '">' + escHtml(raw).replace(/"/g, '&quot;') + '</span>';
            continue;
          }
          if (ch === 't' && str.slice(i, i + 4) === 'true')  { result += '<span class="hl-bool">true</span>';  i += 4; continue; }
          if (ch === 'f' && str.slice(i, i + 5) === 'false') { result += '<span class="hl-bool">false</span>'; i += 5; continue; }
          if (ch === 'n' && str.slice(i, i + 4) === 'null')  { result += '<span class="hl-null">null</span>';  i += 4; continue; }
          if (ch === '-' || (ch >= '0' && ch <= '9')) {
            var num = '';
            while (i < len && /[-\d.eE+]/.test(str[i])) num += str[i++];
            result += '<span class="hl-num">' + num + '</span>';
            continue;
          }
          result += escHtml(ch);
          i++;
        }
        return result;
      }
      function detectDelimiter(raw) {
        var firstLine = raw.split('\n')[0];
        var candidates = { ',': 0, ';': 0, '\t': 0, '|': 0 };
        for (var i = 0; i < firstLine.length; i++) {
          var ch = firstLine[i];
          if (ch in candidates) candidates[ch]++;
        }
        var winner = Object.keys(candidates).reduce(function (a, b) {
          return candidates[a] >= candidates[b] ? a : b;
        });
        return candidates[winner] > 0 ? winner : ',';
      }

      function cellClass(val) {
        if (val === null) return 'td-null';
        if (typeof val === 'number') return 'td-number';
        if (typeof val === 'boolean') return 'td-boolean';
        return '';
      }

      function renderPreview(data, headers) {
        var rows = data.slice(0, PREVIEW_ROWS);
        var total = data.length;

        previewHead.innerHTML = '<tr>' + headers.map(function (h) {
          return '<th>' + escHtml(h) + '</th>';
        }).join('') + '</tr>';

        previewBody.innerHTML = rows.map(function (row) {
          return '<tr>' + headers.map(function (h) {
            var val = row[h];
            var text = escHtml(val === null ? 'null' : val);
            return '<td class="' + cellClass(val) + '" title="' + text + '">' + text + '</td>';
          }).join('') + '</tr>';
        }).join('');

        document.getElementById('preview-label').textContent = total > PREVIEW_ROWS
          ? 'First ' + PREVIEW_ROWS + ' of ' + total.toLocaleString() + ' rows'
          : total.toLocaleString() + ' row' + (total !== 1 ? 's' : '');

        previewSec.hidden = false;
      }
      function resetOutput() {
        outputEl.innerHTML = '';
        statsEl.hidden = true;
        previewSec.hidden = true;
        document.getElementById('output-meta').textContent = '';
        lastJSON = '';
      }

      function convert() {
        var raw = inputEl.value;
        document.getElementById('input-meta').textContent = raw.trim() ? JT.formatBytes(new Blob([raw]).size) : '';

        if (!raw.trim()) {
          errorEl.hidden = true;
          detectedBdg.hidden = true;
          resetOutput();
          return;
        }

        var delim = delimSel.value;
        if (delim === '') {
          delim = detectDelimiter(raw);
          var labels = { ',': 'comma', ';': 'semicolon', '\t': 'tab', '|': 'pipe' };
          detectedBdg.textContent = 'Detected: ' + (labels[delim] || delim);
          detectedBdg.hidden = false;
        } else {
          detectedBdg.hidden = true;
        }

        var res = JT.csvToJson(raw, {
          delimiter: delim,
          coerce: coerceCheck.checked,
          skipEmpty: skipCheck.checked
        });

        if (res.error) {
          errorMsgEl.textContent = res.error;
          errorEl.hidden = false;
          resetOutput();
          return;
        }
        errorEl.hidden = true;
        var jsonText = JT.stringifyJSON(res.data, 2).text;
        lastJSON = jsonText;
        outputEl.innerHTML = buildHighlight(jsonText);

        var outBytes = new Blob([jsonText]).size;
        var outLines = (jsonText.match(/\n/g) || []).length + 1;
        document.getElementById('output-meta').textContent =
          outLines.toLocaleString() + ' lines · ' + JT.formatBytes(outBytes);

        document.getElementById('stat-rows').textContent = res.data.length.toLocaleString();
        document.getElementById('stat-cols').textContent = res.headers.length.toLocaleString();
        document.getElementById('stat-size').textContent = JT.formatBytes(outBytes);
        statsEl.hidden = false;

        if (res.data.length > 0) {
          renderPreview(res.data, res.headers);
        } else {
          previewSec.hidden = true;
        }
      }

      document.getElementById('convert-btn').addEventListener('click', convert);
      inputEl.addEventListener('input', JT.debounce(convert, 400));

      function reconvert() { if (inputEl.value.trim()) convert(); }
      delimSel.addEventListener('change', reconvert);
      coerceCheck.addEventListener('change', reconvert);
      skipCheck.addEventListener('change', reconvert);

      document.getElementById('sample-btn').addEventListener('click', function () {
        inputEl.value = 'name,age,active,city\nAlice,30,true,London\nBob,25,false,Paris\nChen,41,true,Singapore';
        convert();
      });
      document.getElementById('copy-btn').addEventListener('click', function () {
        if (!lastJSON) return;
        var btn = this;
        JT.copyToClipboard(lastJSON).then(function () {
          var orig = btn.innerHTML;
          btn.innerHTML = '<svg aria-hidden="true" width="12" height="12" viewBox="0 0 12 12" fill="none" style="vertical-align:-1px;margin-right:4px"><path d="M2 6l3 3 5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>Copied!';
          btn.style.color = 'var(--success)';
          setTimeout(function () { btn.innerHTML = orig; btn.style.color = ''; }, 1800);
        });
      });

      document.getElementById('download-btn').addEventListener('click', function () {
        if (!lastJSON) return;
        var blob = new Blob([lastJSON], { type: 'application/json' });
        var url  = URL.createObjectURL(blob);
        var a    = document.createElement('a');
        a.href = url; a.download = 'data.json'; a.click();
        setTimeout(function () { URL.revokeObjectURL(url); }, 5000);
      });

      document.getElementById('clear-btn').addEventListener('click', function () {
        inputEl.value = '';
        errorEl.hidden = true;
        detectedBdg.hidden = true;
        resetOutput();
        document.getElementById('input-meta').textContent = '';
        inputEl.focus();
      });

      document.body.addEventListener('dragover', function (e) {
        if (e.dataTransfer && Array.prototype.indexOf.call(e.dataTransfer.types, 'Files') > -1) e.preventDefault();
      });
      document.body.addEventListener('drop', function (e) {
        if (!e.dataTransfer || !e.dataTransfer.files.length) return;
        e.preventDefault();
        var reader = new FileReader();
        reader.onload = function (ev) { inputEl.value = ev.target.result; convert(); };
        reader.readAsText(e.dataTransfer.files[0]);
      });

      document.addEventListener('keydown', function (e) {
        var mod = e.metaKey || e.ctrlKey;
        if (mod && e.shiftKey && e.key.toLowerCase() === 'c') {
          e.preventDefault();
          document.getElementById('copy-btn').click();
        }
      });
    })();
  </script>

</ToolLayout>
