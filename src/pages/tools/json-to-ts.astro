---
import ToolLayout from '../../layouts/ToolLayout.astro';
import { getToolBySlugOrId } from '../../data/tools';

const tool = getToolBySlugOrId('json-to-ts') || {
  id: 'json-to-ts',
  slug: 'json-to-ts',
  aliases: [],
  name: 'Json To Ts',
  title: 'Json To Ts — JSON2X',
  metaDesc: 'Free client-side developer tool on JSON2X.',
  keywords: 'json to ts',
  desc: 'Developer tool',
  category: 'format-validate',
  icon: '',
  href: '/tools/json-to-ts',
  related: [],
  faqs: []
};
---

<ToolLayout tool={tool}>
  <style>

    /* ── Syntax tokens for TypeScript output ─────────────── */
    .ts-kw      { color: var(--ts-kw); }
    .ts-name    { color: var(--ts-name); }
    .ts-key     { color: var(--ts-key); }
    .ts-type    { color: var(--ts-type); }
    .ts-punc    { color: var(--text-muted); }
    .ts-comment { color: var(--text-muted); font-style: italic; }
    .ts-opt     { color: var(--error); }
    .ts-str     { color: var(--ts-str); }

    /* ── Layout ───────────────────────────────────────────── */
    .ts-workspace {
      display: grid;
      gap:     var(--space-5);
      margin-bottom: var(--space-5);
    }
    @media (min-width: 800px) {
      .ts-workspace { grid-template-columns: 1fr 1fr; align-items: start; }
    }

    /* ── Toolbar ──────────────────────────────────────────── */
    .ts-toolbar {
      display:       flex;
      align-items:   center;
      flex-wrap:     wrap;
      gap:           var(--space-2);
      padding:       var(--space-3) var(--space-4);
      background:    var(--bg-raised);
      border:        1px solid var(--bg-border);
      border-radius: var(--radius-lg);
      margin-bottom: var(--space-4);
    }
    .ts-toolbar__divider { width:1px; height:24px; background:var(--bg-border); flex-shrink:0; margin-inline:var(--space-1); }
    .ts-toolbar__label   { font-size:var(--text-xs); font-weight:var(--font-semibold); color:var(--text-muted); text-transform:uppercase; letter-spacing:0.06em; white-space:nowrap; }

    .ts-select {
      padding:var(--space-2) var(--space-3); background:var(--bg-base); color:var(--text-primary);
      border:1px solid var(--bg-border); border-radius:var(--radius-md);
      font-size:var(--text-xs); font-weight:var(--font-semibold); cursor:pointer; outline:none;
      transition:border-color var(--transition-fast);
    }
    .ts-select:focus { border-color:var(--accent); }

    .ts-input {
      padding:var(--space-2) var(--space-3); background:var(--bg-base); color:var(--text-primary);
      border:1px solid var(--bg-border); border-radius:var(--radius-md);
      font-size:var(--text-xs); font-family:var(--font-mono);
      outline:none; width:140px; transition:border-color var(--transition-fast);
    }
    .ts-input:focus { border-color:var(--accent); }

    .toggle-check {
      display:inline-flex; align-items:center; gap:var(--space-2);
      font-size:var(--text-xs); font-weight:var(--font-medium);
      color:var(--text-secondary); cursor:pointer; user-select:none;
    }
    .toggle-check input { accent-color:var(--accent); width:14px; height:14px; }

    /* ── Input/Output pane ────────────────────────────────── */
    .ts-pane { display:flex; flex-direction:column; }
    .ts-pane__header { display:flex; align-items:center; justify-content:space-between; margin-bottom:var(--space-2); }
    .ts-pane__title  { font-size:var(--text-xs); font-weight:var(--font-semibold); color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.08em; }

    .ts-textarea {
      background:var(--bg-base); border:1px solid var(--bg-border); border-radius:var(--radius-lg);
      padding:var(--space-4); font-family:var(--font-mono); font-size:var(--text-xs);
      line-height:var(--leading-relaxed); color:var(--text-primary); outline:none; resize:vertical;
      min-height:300px; tab-size:2; transition:border-color var(--transition-fast), box-shadow var(--transition-fast);
    }
    .ts-textarea:focus  { border-color:var(--accent); box-shadow:0 0 0 3px var(--accent-glow); }
    .ts-textarea.error  { border-color:var(--error);  box-shadow:0 0 0 3px var(--error-bg); }

    /* ── Output pre ───────────────────────────────────────── */
    .ts-output {
      font-family:var(--font-mono); font-size:var(--text-xs); line-height:var(--leading-relaxed);
      background:var(--bg-base); border:1px solid var(--bg-border); border-radius:var(--radius-lg);
      padding:var(--space-4); min-height:300px; max-height:600px; overflow:auto;
      white-space:pre; tab-size:2; color:var(--text-primary);
    }
    .ts-output--empty { color:var(--text-muted); font-style:italic; white-space:pre-wrap; }

    /* ── Tab strip for TS / Zod ───────────────────────────── */
    .output-tabs {
      display:flex; gap:var(--space-1); margin-bottom:var(--space-2);
    }
    .output-tab {
      padding:var(--space-2) var(--space-4); font-size:var(--text-xs); font-weight:var(--font-semibold);
      border:1px solid var(--bg-border); border-radius:var(--radius-md) var(--radius-md) 0 0;
      background:var(--bg-raised); color:var(--text-muted); cursor:pointer;
      transition:all var(--transition-fast); border-bottom:none; user-select:none;
    }
    .output-tab.active { background:var(--bg-base); color:var(--text-primary); border-color:var(--bg-border); border-bottom:1px solid var(--bg-base); }

    /* ── Error strip ──────────────────────────────────────── */
    .ts-error {
      display:flex; align-items:flex-start; gap:var(--space-3);
      padding:var(--space-3) var(--space-4); background:var(--error-bg); color:var(--error);
      border:1px solid hsla(0,82%,63%,0.3); border-radius:var(--radius-md);
      font-size:var(--text-xs); margin-bottom:var(--space-4);
    }
    .ts-error__badge { flex-shrink:0; background:var(--error); color:#fff; border-radius:var(--radius-sm); padding:1px var(--space-2); font-weight:var(--font-semibold); font-family:var(--font-mono); }

    /* ── Interface count badge ────────────────────────────── */
    .ts-stats {
      display:flex; gap:var(--space-4); font-size:var(--text-xs); color:var(--text-muted); margin-bottom:var(--space-3);
    }
    .ts-stat { display:flex; gap:var(--space-2); align-items:center; }
    .ts-stat__val { font-family:var(--font-mono); font-weight:var(--font-semibold); color:var(--text-secondary); }

    /* ── FAQ ──────────────────────────────────────────────── */
    .faq-section { margin-top:var(--space-16); padding-top:var(--space-10); border-top:1px solid var(--bg-border); }
    .faq-eyebrow { font-size:var(--text-xs); font-weight:var(--font-semibold); text-transform:uppercase; letter-spacing:0.1em; color:var(--accent); margin-bottom:var(--space-3); }
    .faq-title   { font-size:var(--text-2xl); font-weight:var(--font-bold); margin-bottom:var(--space-8); }
    .faq-grid    { display:grid; grid-template-columns:repeat(auto-fill,minmax(280px,1fr)); gap:var(--space-5); margin-bottom:var(--space-8); }
    .faq-card    { background:var(--bg-surface); border:1px solid var(--bg-border); border-radius:var(--radius-xl); padding:var(--space-5); }
    .faq-card h3 { font-size:var(--text-base); font-weight:var(--font-semibold); margin-bottom:var(--space-3); line-height:var(--leading-snug); }
    .faq-card p  { font-size:var(--text-sm); color:var(--text-secondary); line-height:var(--leading-relaxed); }
    .faq-card code { font-family:var(--font-mono); font-size:0.85em; background:var(--bg-raised); border:1px solid var(--bg-border); border-radius:var(--radius-sm); padding:1px 4px; color:var(--accent); }
    .faq-prose   { font-size:var(--text-sm); color:var(--text-secondary); line-height:var(--leading-relaxed); max-width:760px; display:flex; flex-direction:column; gap:var(--space-4); }
    .faq-prose p { margin:0; }
    .faq-prose strong { color:var(--text-primary); font-weight:var(--font-semibold); }
    .faq-prose code { font-family:var(--font-mono); font-size:0.9em; background:var(--bg-raised); border:1px solid var(--bg-border); border-radius:var(--radius-sm); padding:1px 4px; color:var(--accent); }
    .faq-prose a { color:var(--accent); }
  
</style>

  <div class="container container--tool">

      <div class="tool-hero">
        <div class="tool-hero__badge">TypeScript &amp; Zod</div>
        <h1 class="tool-hero__title">JSON to TypeScript Generator</h1>
        
      </div>


      <!-- ── Toolbar ─────────────────────────────────────────── -->
      <div class="ts-toolbar" role="toolbar">
        <span class="ts-toolbar__label">Root name</span>
        <input class="ts-input" id="root-name" type="text" value="Root" aria-label="Root interface name" maxlength="60" />

        <div class="ts-toolbar__divider"></div>

        <span class="ts-toolbar__label">Output</span>
        <select class="ts-select" id="output-style" aria-label="Output style">
          <option value="interface">interface</option>
          <option value="type">type alias</option>
        </select>

        <div class="ts-toolbar__divider"></div>

        <label class="toggle-check">
          <input type="checkbox" id="export-toggle" checked />
          export
        </label>

        <label class="toggle-check">
          <input type="checkbox" id="optional-toggle" />
          Optional fields <span style="font-size:10px;color:var(--text-muted)">(add ?)</span>
        </label>

        <div class="ts-toolbar__divider"></div>

        <button class="btn btn--primary" id="generate-btn">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M2 7h10M7 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Generate
        </button>

        <button class="btn btn--ghost" id="copy-btn">Copy</button>
        <button class="btn btn--ghost" id="download-btn">Download .ts</button>
        <button class="btn btn--ghost" id="clear-btn" style="margin-left:auto">Clear</button>
      </div>

      <!-- ── Workspace ───────────────────────────────────────── -->
      <div class="ts-workspace">

        <!-- Input pane -->
        <div class="ts-pane">
          <div class="ts-pane__header">
            <span class="ts-pane__title">JSON Input</span>
            <span id="input-meta" class="text-xs text-muted"></span>
          </div>
          <textarea
            class="ts-textarea"
            id="json-input"
            aria-label="JSON input"
            spellcheck="false"
            autocorrect="off"
            placeholder='{&#10;  "user": {&#10;    "id": 1,&#10;    "name": "Alice",&#10;    "email": "alice@example.com",&#10;    "roles": ["admin", "editor"],&#10;    "active": true&#10;  }&#10;}'
          ></textarea>
        </div>

        <!-- Output pane -->
        <div class="ts-pane">
          <div class="ts-pane__header">
            <span class="ts-pane__title">TypeScript Output</span>
          </div>

          <div class="output-tabs" role="tablist">
            <button class="output-tab active" role="tab" id="tab-ts"  aria-selected="true"  aria-controls="panel-ts">TypeScript</button>
            <button class="output-tab"         role="tab" id="tab-zod" aria-selected="false" aria-controls="panel-zod">Zod Schema</button>
          </div>

          <div id="ts-error" class="ts-error" style="display:none">
            <span class="ts-error__badge">ERR</span>
            <span id="ts-error-msg"></span>
          </div>

          <div class="ts-stats" id="ts-stats" style="display:none">
            <div class="ts-stat"><span>Interfaces</span><span class="ts-stat__val" id="stat-ifaces">0</span></div>
            <div class="ts-stat"><span>Properties</span><span class="ts-stat__val" id="stat-props">0</span></div>
          </div>

          <div id="panel-ts"  role="tabpanel" aria-labelledby="tab-ts">
            <pre class="ts-output ts-output--empty" id="ts-output">TypeScript interface will appear here…</pre>
          </div>
          <div id="panel-zod" role="tabpanel" aria-labelledby="tab-zod" style="display:none">
            <pre class="ts-output ts-output--empty" id="zod-output">Zod schema will appear here…</pre>
          </div>
        </div>
      </div>

      <!-- ── Ad + Related ────────────────────────────────────── -->
</div>

  <script is:inline>

  (function () {
    'use strict';

    const inputEl    = document.getElementById('json-input');
    const tsOutEl    = document.getElementById('ts-output');
    const zodOutEl   = document.getElementById('zod-output');
    const rootInput  = document.getElementById('root-name');
    const styleEl    = document.getElementById('output-style');
    const exportChk  = document.getElementById('export-toggle');
    const optChk     = document.getElementById('optional-toggle');
    const errEl      = document.getElementById('ts-error');
    const errMsgEl   = document.getElementById('ts-error-msg');
    const statsEl    = document.getElementById('ts-stats');
    const tabTS      = document.getElementById('tab-ts');
    const tabZod     = document.getElementById('tab-zod');
    const panelTS    = document.getElementById('panel-ts');
    const panelZod   = document.getElementById('panel-zod');

    let lastTS  = '';
    let lastZod = '';
    let activeTab = 'ts';

    /* ══════════════════════════════════════════════════════════
       Type inference engine
       ══════════════════════════════════════════════════════════ */

    const ifaceRegistry = new Map(); // name → properties[]
    let totalProps = 0;

    /** Convert camelCase / snake_case / any key to PascalCase interface name */
    function toPascal(str) {
      return String(str)
        .replace(/[^a-zA-Z0-9]+(.)/g, (_, ch) => ch.toUpperCase())
        .replace(/^[a-z]/, ch => ch.toUpperCase())
        .replace(/[^a-zA-Z0-9]/g, '');
    }

    /** Infer a TS type string for a value. Registers sub-interfaces as a side-effect. */
    function inferType(val, parentName, key) {
      if (val === null)                return 'null';
      if (typeof val === 'string')     return 'string';
      if (typeof val === 'number')     return Number.isInteger(val) ? 'number' : 'number';
      if (typeof val === 'boolean')    return 'boolean';

      if (Array.isArray(val)) {
        if (val.length === 0) return 'unknown[] /* TODO: specify element type */';
        const types = [...new Set(val.map(item => inferType(item, parentName, key)))];
        if (types.length === 1) return `${types[0]}[]`;
        // Union
        const union = types.join(' | ');
        return `(${union})[]`;
      }

      if (typeof val === 'object') {
        const subName = parentName + toPascal(String(key));
        buildInterface(subName, val);
        return subName;
      }

      return 'unknown';
    }

    function buildInterface(name, obj) {
      if (ifaceRegistry.has(name)) return; // prevent duplicates
      const props = Object.entries(obj).map(([k, v]) => {
        totalProps++;
        const tsType = inferType(v, name, k);
        return { key: k, type: tsType };
      });
      ifaceRegistry.set(name, props);
    }

    /* ── Render TypeScript ─────────────────────────────────── */
    function renderTS(style, addExport, makeOptional) {
      const lines = [];
      const exp = addExport ? 'export ' : '';
      const opt = makeOptional ? '?' : '';

      // Emit in reverse order so nested types come before they're referenced
      const entries = [...ifaceRegistry.entries()].reverse();

      entries.forEach(([name, props]) => {
        if (style === 'interface') {
          lines.push(`${exp}interface ${name} {`);
          props.forEach(p => {
            lines.push(`  ${p.key}${opt}: ${p.type};`);
          });
          lines.push('}');
        } else {
          lines.push(`${exp}type ${name} = {`);
          props.forEach(p => {
            lines.push(`  ${p.key}${opt}: ${p.type};`);
          });
          lines.push('};');
        }
        lines.push('');
      });

      return lines.join('\n');
    }

    /* ── Render Zod ────────────────────────────────────────── */
    function tsTypeToZod(tsType, style) {
      tsType = tsType.trim();
      if (tsType === 'string')  return 'z.string()';
      if (tsType === 'number')  return 'z.number()';
      if (tsType === 'boolean') return 'z.boolean()';
      if (tsType === 'null')    return 'z.null()';
      if (tsType.startsWith('unknown[]')) return 'z.array(z.unknown())';
      if (tsType.endsWith('[]')) {
        const inner = tsType.slice(0, -2);
        return `z.array(${tsTypeToZod(inner, style)})`;
      }
      if (tsType.startsWith('(') && tsType.endsWith(')[]')) {
        const inner = tsType.slice(1, -3);
        const parts = inner.split('|').map(s => tsTypeToZod(s.trim(), style));
        return `z.array(z.union([${parts.join(', ')}]))`;
      }
      // Sub-interface reference
      if (ifaceRegistry.has(tsType)) {
        return `${tsType}Schema`;
      }
      if (tsType.includes(' | ')) {
        const parts = tsType.split('|').map(s => tsTypeToZod(s.trim(), style));
        return `z.union([${parts.join(', ')}])`;
      }
      return 'z.unknown()';
    }

    function renderZod(addExport, makeOptional) {
      const lines = [
        `import { z } from 'zod';`,
        '',
      ];
      const exp = addExport ? 'export ' : '';

      const entries = [...ifaceRegistry.entries()].reverse();
      entries.forEach(([name, props]) => {
        const schemaName = `${name[0].toLowerCase() + name.slice(1)}Schema`;
        lines.push(`${exp}const ${schemaName} = z.object({`);
        props.forEach(p => {
          let zodType = tsTypeToZod(p.type, 'zod');
          if (makeOptional) zodType += '.optional()';
          lines.push(`  ${p.key}: ${zodType},`);
        });
        lines.push('});');
        lines.push('');
        lines.push(`${exp}type ${name} = z.infer<typeof ${schemaName}>;`);
        lines.push('');
      });

      return lines.join('\n');
    }

    /* ── Syntax highlight TypeScript ─────────────────────── */
    function hlTS(code) {
      const escH = s => String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
      return code.split('\n').map(line => {
        let l = escH(line);
        // Keywords
        l = l.replace(/\b(export|interface|type|import|from|const|z)\b/g, '<span class="ts-kw">$1</span>');
        // Zod string literals
        l = l.replace(/'([^']*)'/g, '<span class="ts-str">\'$1\'</span>');
        // Interface/type names (CamelCase)
        l = l.replace(/\b([A-Z][a-zA-Z0-9]+)\b/g, '<span class="ts-name">$1</span>');
        // Types: string number boolean null unknown
        l = l.replace(/\b(string|number|boolean|null|unknown)\b/g, '<span class="ts-type">$1</span>');
        // Comments
        l = l.replace(/(\/\/ TODO[^<]*)/g, '<span class="ts-comment">$1</span>');
        return l;
      }).join('\n');
    }

    /* ── Generate ─────────────────────────────────────────── */
    function generate() {
      const raw = inputEl.value.trim();
      document.getElementById('input-meta').textContent = raw ? JT.formatBytes(new Blob([raw]).size) : '';

      if (!raw) {
        clearOutput();
        return;
      }

      const { data, error, line } = JT.parseJSON(raw);
      if (error) {
        inputEl.classList.add('error');
        errMsgEl.textContent = `JSON error${line ? ` (line ${line})` : ''}: ${error}`;
        errEl.style.display = 'flex';
        clearOutput(false);
        return;
      }

      inputEl.classList.remove('error');
      errEl.style.display = 'none';

      // Reset registry
      ifaceRegistry.clear();
      totalProps = 0;

      const rootName = (rootInput.value.trim() || 'Root').replace(/[^a-zA-Z0-9_]/g, '') || 'Root';
      const style    = styleEl.value;
      const addExp   = exportChk.checked;
      const makeOpt  = optChk.checked;

      // Build from root
      if (typeof data === 'object' && data !== null && !Array.isArray(data)) {
        buildInterface(rootName, data);
      } else if (Array.isArray(data) && data.length > 0 && typeof data[0] === 'object' && data[0] !== null) {
        buildInterface(rootName, data[0]);
      } else {
        // Primitive or empty array
        const rootType = inferType(data, '', rootName);
        ifaceRegistry.set(rootName, [{ key: 'value', type: rootType }]);
        totalProps++;
      }

      lastTS  = renderTS(style, addExp, makeOpt);
      lastZod = renderZod(addExp, makeOpt);

      // Render highlighted output
      tsOutEl.innerHTML = hlTS(lastTS);
      tsOutEl.classList.remove('ts-output--empty');

      zodOutEl.innerHTML = hlTS(lastZod);
      zodOutEl.classList.remove('ts-output--empty');

      // Stats
      document.getElementById('stat-ifaces').textContent = ifaceRegistry.size;
      document.getElementById('stat-props').textContent  = totalProps;
      statsEl.style.display = 'flex';
    }

    function clearOutput(keepError = true) {
      if (!keepError) {
        tsOutEl.innerHTML  = 'TypeScript interface will appear here…';
        zodOutEl.innerHTML = 'Zod schema will appear here…';
        tsOutEl.classList.add('ts-output--empty');
        zodOutEl.classList.add('ts-output--empty');
      }
      statsEl.style.display = 'none';
      lastTS = ''; lastZod = '';
    }

    /* ── Tab switching ─────────────────────────────────────── */
    tabTS.addEventListener('click', () => {
      activeTab = 'ts';
      tabTS.classList.add('active');  tabZod.classList.remove('active');
      tabTS.setAttribute('aria-selected','true'); tabZod.setAttribute('aria-selected','false');
      panelTS.style.display = '';    panelZod.style.display = 'none';
    });
    tabZod.addEventListener('click', () => {
      activeTab = 'zod';
      tabZod.classList.add('active'); tabTS.classList.remove('active');
      tabZod.setAttribute('aria-selected','true'); tabTS.setAttribute('aria-selected','false');
      panelZod.style.display = '';   panelTS.style.display = 'none';
    });

    /* ── Events ───────────────────────────────────────────── */
    document.getElementById('generate-btn').addEventListener('click', generate);
    inputEl.addEventListener('input', JT.debounce(generate, 400));
    rootInput.addEventListener('input', JT.debounce(generate, 300));
    styleEl.addEventListener('change', () => { if (inputEl.value.trim()) generate(); });
    exportChk.addEventListener('change', () => { if (inputEl.value.trim()) generate(); });
    optChk.addEventListener('change', () => { if (inputEl.value.trim()) generate(); });

    document.getElementById('copy-btn').addEventListener('click', function () {
      const content = activeTab === 'zod' ? lastZod : lastTS;
      if (!content) return;
      JT.copyToClipboard(content)
        .then(() => { this.innerHTML = '<svg aria-hidden="true" width="12" height="12" viewBox="0 0 12 12" fill="none" style="vertical-align:-1px;margin-right:4px"><path d="M2 6l3 3 5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>Copied!'; setTimeout(() => { this.textContent = 'Copy'; }, 1800); })
        .catch(() => alert('Copy failed.'));
    });

    document.getElementById('download-btn').addEventListener('click', () => {
      const content = activeTab === 'zod'
        ? (lastZod || lastTS)
        : (lastTS || lastZod);
      if (!content) return;
      const name = (rootInput.value.trim() || 'types').toLowerCase();
      const fname = activeTab === 'zod' ? `${name}.schema.ts` : `${name}.types.ts`;
      const blob = new Blob([content], { type: 'text/typescript' });
      const url  = URL.createObjectURL(blob);
      const a    = document.createElement('a');
      a.href = url; a.download = fname; a.click();
      setTimeout(() => URL.revokeObjectURL(url), 5000);
    });

    document.getElementById('clear-btn').addEventListener('click', () => {
      inputEl.value = '';
      inputEl.classList.remove('error');
      errEl.style.display = 'none';
      document.getElementById('input-meta').textContent = '';
      clearOutput(false);
    });

    /* ── Drag and drop ─────────────────────────────────────── */
    document.body.addEventListener('dragover', e => { if ([...e.dataTransfer.types].includes('Files')) e.preventDefault(); });
    document.body.addEventListener('drop', e => {
      e.preventDefault();
      const file = e.dataTransfer.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = ev => { inputEl.value = ev.target.result; generate(); };
      reader.readAsText(file);
    });

  })();
  
</script>
</ToolLayout>
