---
import ToolLayout from '../../layouts/ToolLayout.astro';
import { getToolBySlugOrId } from '../../data/tools';

const tool = getToolBySlugOrId('json-to-code') || {
  id: 'json-to-code',
  slug: 'json-to-code',
  aliases: [],
  name: 'Json To Code',
  title: 'Json To Code — JSON2X',
  metaDesc: 'Free client-side developer tool on JSON2X.',
  keywords: 'json to code',
  desc: 'Developer tool',
  category: 'format-validate',
  icon: '',
  href: '/tools/json-to-code',
  related: [],
  faqs: []
};
---

<ToolLayout tool={tool}>
  

  <div class="options-bar" style="display:flex;align-items:center;flex-wrap:wrap;gap:var(--space-3);padding:var(--space-3) var(--space-4);background:var(--bg-raised);border:1px solid var(--bg-border);border-radius:var(--radius-lg);margin-bottom:var(--space-4);">
        <label class="flex items-center gap-2 text-sm text-secondary">
          Target Language:
          <select id="lang-select" class="jc-select" style="padding:4px 8px;background:var(--bg-base);color:var(--text-primary);border:1px solid var(--bg-border);border-radius:4px;" aria-label="Target Programming Language">
            <option value="go" selected>Go Struct</option>
            <option value="rust">Rust (Serde Struct)</option>
            <option value="python">Python (Pydantic)</option>
          </select>
        </label>
        <label class="flex items-center gap-2 text-sm text-secondary">
          Root Name:
          <input type="text" id="root-name" value="AutoGenerated" style="padding:4px 8px;background:var(--bg-base);color:var(--text-primary);border:1px solid var(--bg-border);border-radius:4px;width:130px;" aria-label="Root Struct Name" />
        </label>
        <button class="btn btn--primary" id="convert-btn">Generate Code</button>
        <button class="btn btn--ghost btn--sm" id="copy-btn" style="margin-left:auto">Copy Code</button>
        <button class="btn btn--ghost btn--sm" id="download-btn">Download</button>
        <button class="btn btn--ghost btn--sm" id="clear-btn">Clear</button>
      </div>

      <div class="split-pane">
        <div class="pane">
          <div class="pane__header"><span class="pane__title">JSON Payload</span></div>
          <textarea class="textarea" id="converter-input"
            placeholder='{"user": {"id": 42, "username": "dev_hero", "roles": ["admin"]}, "meta": {"version": 1.2}}'
            aria-label="JSON Input" spellcheck="false" style="min-height:320px;font-family:var(--font-mono);"></textarea>
        </div>
        <div class="pane">
          <div class="pane__header"><span class="pane__title" id="output-title">Go Struct Output</span></div>
          <pre class="code-output" id="converter-output" tabindex="0" style="min-height:320px;font-family:var(--font-mono);padding:var(--space-4);background:var(--bg-base);border:1px solid var(--bg-border);border-radius:var(--radius-lg);overflow:auto;"></pre>
        </div>
      </div>

      <div id="tool-status" role="status" aria-live="polite" style="margin-top:var(--space-4)"></div>

      <div class="crosslinks" style="display:flex;align-items:center;flex-wrap:wrap;gap:var(--space-3);padding:var(--space-4) var(--space-5);background:var(--bg-raised);border:1px solid var(--bg-border);border-radius:var(--radius-lg);margin-top:var(--space-6);" aria-label="Related tools">
        <span style="font-weight:600;color:var(--text-muted);font-size:var(--text-xs);text-transform:uppercase;">Related Tools</span>
        <a href="json-to-ts" style="color:var(--accent);text-decoration:none;font-size:var(--text-sm);">JSON to TypeScript</a>
        <a href="schema" style="color:var(--accent);text-decoration:none;font-size:var(--text-sm);">JSON Schema Generator</a>
        <a href="json-to-sql" style="color:var(--accent);text-decoration:none;font-size:var(--text-sm);">JSON to SQL</a>
      </div>

  <script is:inline>

    (function() {
      'use strict';
      const langSel = document.getElementById('lang-select');
      const rootNameInput = document.getElementById('root-name');
      const inputEl = document.getElementById('converter-input');
      const outputEl = document.getElementById('converter-output');
      const outputTitle = document.getElementById('output-title');
      const statusEl = document.getElementById('tool-status');

      function showStatus(msg, type = 'info') {
        statusEl.innerHTML = msg ? `<div class="alert alert--${type}">${msg}</div>` : '';
      }

      function convert() {
        const text = inputEl.value.trim();
        const lang = langSel.value;

        if (!text) {
          outputEl.textContent = '';
          showStatus('');
          return;
        }

        const { data, error } = JT.parseJSON(text);
        if (error) {
          showStatus(`JSON Parse Error: ${error}`, 'error');
          return;
        }

        const opts = { structName: rootNameInput.value.trim() || 'AutoGenerated', className: rootNameInput.value.trim() || 'AutoGenerated' };
        let res = { code: '', error: null };

        if (lang === 'go') {
          outputTitle.textContent = 'Go Struct Output';
          res = JT.jsonToGo(data, opts);
        } else if (lang === 'rust') {
          outputTitle.textContent = 'Rust Struct Output';
          res = JT.jsonToRust(data, opts);
        } else if (lang === 'python') {
          outputTitle.textContent = 'Python Pydantic Output';
          res = JT.jsonToPython(data, opts);
        }

        if (res.error) {
          showStatus(`Generation Error: ${res.error}`, 'error');
          return;
        }

        outputEl.textContent = res.code;
        showStatus(`Successfully generated ${lang.toUpperCase()} code model!`, 'success');
      }

      document.getElementById('convert-btn').addEventListener('click', convert);
      inputEl.addEventListener('input', JT.debounce(convert, 400));
      rootNameInput.addEventListener('input', JT.debounce(convert, 400));
      langSel.addEventListener('change', convert);

      document.getElementById('copy-btn').addEventListener('click', () => {
        const res = outputEl.textContent;
        if (!res) return;
        JT.copyToClipboard(res)
          .then(() => showStatus('Copied code to clipboard!', 'success'))
          .catch(() => showStatus('Copy failed.', 'warning'));
      });

      document.getElementById('download-btn').addEventListener('click', () => {
        const res = outputEl.textContent;
        if (!res) return;
        const lang = langSel.value;
        const ext = lang === 'go' ? 'go' : (lang === 'rust' ? 'rs' : 'py');
        const blob = new Blob([res], { type: 'text/plain;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `model.${ext}`;
        a.click();
        setTimeout(() => URL.revokeObjectURL(url), 5000);
      });

      document.getElementById('clear-btn').addEventListener('click', () => {
        inputEl.value = '';
        outputEl.textContent = '';
        showStatus('');
      });
    })();
  
</script>
</ToolLayout>
