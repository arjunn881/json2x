---
import ToolLayout from '../../layouts/ToolLayout.astro';
import { getToolBySlugOrId } from '../../data/tools';

const tool = getToolBySlugOrId('json-to-csv')!;
---

<ToolLayout tool={tool}>
  <style>
    /* ── Toolbar ─────────────────────────────────────────────── */
    .jc-toolbar {
      display:       flex;
      align-items:   center;
      flex-wrap:     wrap;
      gap:           var(--space-2);
      padding:       var(--space-3) var(--space-4);
      background:    var(--bg-raised);
      border:        1px solid var(--bg-border);
      border-radius: var(--radius-lg);
      margin-bottom: var(--space-4);
    }
    .jc-toolbar__divider { width:1px; height:24px; background:var(--bg-border); flex-shrink:0; margin-inline:var(--space-1); }
    .jc-toolbar__label { font-size:var(--text-xs); font-weight:var(--font-semibold); color:var(--text-muted); text-transform:uppercase; letter-spacing:0.06em; }

    .jc-select {
      width:         auto;
      padding:       var(--space-2) var(--space-3);
      background:    var(--bg-base);
      color:         var(--text-primary);
      border:        1px solid var(--bg-border);
      border-radius: var(--radius-md);
      font-size:     var(--text-xs);
      font-weight:   var(--font-semibold);
      cursor:        pointer;
      outline:       none;
      transition:    border-color var(--transition-fast);
    }
    .jc-select:focus { border-color: var(--accent); }

    .toggle-check {
      display:     inline-flex;
      align-items: center;
      gap:         var(--space-2);
      font-size:   var(--text-xs);
      font-weight: var(--font-medium);
      color:       var(--text-secondary);
      cursor:      pointer;
      user-select: none;
    }
    .toggle-check input { accent-color: var(--accent); width:14px; height:14px; }
    /* ── Conversion notices — top of the output pane ──────────── */
    .jc-warnings {
      display:        flex;
      flex-direction: column;
      gap:            var(--space-2);
      padding:        var(--space-3);
      border-bottom:  1px solid var(--bg-border);
      background:     var(--bg-surface);
    }
    .jc-warnings[hidden] { display: none; }

    .warning-banner {
      display:       flex;
      align-items:   flex-start;
      gap:           var(--space-2);
      padding:       var(--space-2) var(--space-3);
      border-radius: var(--radius-md);
      font-size:     var(--text-xs);
      line-height:   var(--leading-snug);
      border:        1px solid transparent;
    }
    .warning-banner--warn { background:var(--warning-bg); color:var(--warning); border-color:var(--warning-bg); }
    .warning-banner--info { background:var(--info-bg);    color:var(--info);    border-color:var(--info-bg); }
    .warning-banner--err  { background:var(--error-bg);   color:var(--error);   border-color:var(--error-bg); }

    /* ── Column chips ─────────────────────────────────────────── */
    .col-chips-wrap { margin-top: var(--space-6); }
    .col-chips-wrap[hidden] { display: none; }
    .col-chips-header {
      display:         flex;
      justify-content: space-between;
      align-items:     center;
      margin-bottom:   var(--space-3);
    }
    .col-chips { display:flex; flex-wrap:wrap; gap:var(--space-2); }
    .col-chip {
      display:       inline-flex;
      align-items:   center;
      gap:           var(--space-1);
      padding:       var(--space-1) var(--space-3);
      background:    var(--bg-raised);
      border:        1px solid var(--bg-border);
      border-radius: var(--radius-full);
      font-family:   var(--font-mono);
      font-size:     var(--text-xs);
      color:         var(--text-secondary);
    }
    /* ── Stats bar ────────────────────────────────────────────── */
    .jc-stats {
      display:       flex;
      align-items:   center;
      flex-wrap:     wrap;
      gap:           var(--space-6);
      padding:       var(--space-3) var(--space-5);
      background:    var(--bg-raised);
      border:        1px solid var(--bg-border);
      border-radius: var(--radius-lg);
      font-size:     var(--text-xs);
      margin-top:    var(--space-4);
    }
    .jc-stats[hidden] { display: none; }
    .jc-stat { display:flex; align-items:center; gap:var(--space-2); }
    .jc-stat[hidden] { display: none; }
    .jc-stat__label { color:var(--text-muted); }
    .jc-stat__value { font-family:var(--font-mono); font-weight:var(--font-semibold); color:var(--text-primary); }

    /* CSV columns must stay aligned, so this pane never soft-wraps. */
    #csv-output { white-space: pre; }
  </style>
  <div class="jc-toolbar" role="toolbar" aria-label="Converter options">
    <div style="display:flex;align-items:center;gap:var(--space-2)">
      <span class="jc-toolbar__label">Delimiter</span>
      <select id="delimiter-select" class="jc-select" aria-label="CSV delimiter">
        <option value="," selected>, comma</option>
        <option value=";">; semicolon</option>
        <option value="&#9;">⇥ tab</option>
        <option value="|">| pipe</option>
      </select>
    </div>

    <div class="jc-toolbar__divider" aria-hidden="true"></div>

    <label class="toggle-check">
      <input type="checkbox" id="flatten-toggle" checked aria-label="Flatten nested objects" />
      Flatten nested objects
    </label>

    <label class="toggle-check">
      <input type="checkbox" id="headers-toggle" checked aria-label="Include header row" />
      Include headers
    </label>

    <div class="jc-toolbar__divider" aria-hidden="true"></div>

    <button class="btn btn--primary" id="convert-btn">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M7 2v10M2 7l5-5 5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      Convert
    </button>

    <button class="btn btn--ghost btn--sm" id="sample-btn">Load sample</button>

    <button class="btn btn--ghost" id="clear-btn" style="margin-left:auto">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M2 2l10 10M12 2 2 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
      Clear
    </button>
  </div>
  <div class="tw-workspace tw-workspace--sticky-out">
    <!-- LEFT: JSON input -->
    <section class="tw-pane tw-pane--input" aria-labelledby="jc-in-title">
      <div class="tw-pane__header">
        <h2 class="tw-pane__title" id="jc-in-title">
          {tool.inputLabel || 'JSON Input'}
          <span class="tw-pane__side">Input</span>
        </h2>
        <span class="tw-pane__meta" id="input-meta"></span>
      </div>
      <textarea
        class="tw-input"
        id="json-input"
        aria-label="JSON input"
        spellcheck="false"
        autocapitalize="off"
        autocomplete="off"
        placeholder="Paste a JSON array of objects here…"
      ></textarea>
    </section>
    <!-- RIGHT: CSV output -->
    <section class="tw-pane tw-pane--output" aria-labelledby="jc-out-title">
      <div class="tw-pane__header">
        <h2 class="tw-pane__title" id="jc-out-title">
          {tool.outputLabel || 'CSV Output'}
          <span class="tw-pane__side">Output</span>
        </h2>
        <div class="tw-pane__actions">
          <button class="btn btn--ghost btn--sm" id="copy-btn">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <rect x="4" y="4" width="8" height="8" rx="1.5" stroke="currentColor" stroke-width="1.5"/>
              <path d="M2 10V2h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            Copy CSV
          </button>
          <button class="btn btn--ghost btn--sm" id="download-btn">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M7 1v8m0 0-3-3m3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M2 10v1.5A1.5 1.5 0 0 0 3.5 13h7a1.5 1.5 0 0 0 1.5-1.5V10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            .csv
          </button>
        </div>
      </div>
      <div class="jc-warnings" id="warning-stack" hidden aria-live="polite"></div>
      <pre
        class="tw-output"
        id="csv-output"
        tabindex="0"
        role="region"
        aria-label="CSV output"
        aria-live="polite"
        data-placeholder="CSV appears here — paste a JSON array on the left."
      ></pre>
    </section>
  </div>
  <div class="jc-stats" id="jc-stats" hidden aria-live="polite">
    <div class="jc-stat">
      <span class="jc-stat__label">Rows</span>
      <span class="jc-stat__value" id="stat-rows">—</span>
    </div>
    <div class="jc-stat">
      <span class="jc-stat__label">Columns</span>
      <span class="jc-stat__value" id="stat-cols">—</span>
    </div>
    <div class="jc-stat">
      <span class="jc-stat__label">Output size</span>
      <span class="jc-stat__value" id="stat-size">—</span>
    </div>
    <div class="jc-stat" id="stat-skipped-wrap" hidden>
      <span class="jc-stat__label">Non-object rows skipped</span>
      <span class="jc-stat__value" id="stat-skipped" style="color:var(--warning)">—</span>
    </div>
  </div>

  <div class="col-chips-wrap" id="col-chips-wrap" hidden>
    <div class="col-chips-header">
      <span class="tw-pane__title">Columns <span id="col-count" class="text-muted text-xs font-normal"></span></span>
    </div>
    <div class="col-chips" id="col-chips" role="list" aria-label="CSV column headers"></div>
  </div>
  <script is:inline>
    (function () {
      'use strict';

      var inputEl      = document.getElementById('json-input');
      var outputEl     = document.getElementById('csv-output');
      var warnStack    = document.getElementById('warning-stack');
      var chipsWrap    = document.getElementById('col-chips-wrap');
      var chipsEl      = document.getElementById('col-chips');
      var statsEl      = document.getElementById('jc-stats');
      var delimSel     = document.getElementById('delimiter-select');
      var flattenCheck = document.getElementById('flatten-toggle');
      var headersCheck = document.getElementById('headers-toggle');

      var lastCSV = '';

      function escHtml(s) {
        return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      }

      function showWarnings(msgs) {
        if (!msgs || msgs.length === 0) {
          warnStack.hidden = true;
          warnStack.innerHTML = '';
          return;
        }
        warnStack.innerHTML = msgs.map(function (m) {
          return '<div class="warning-banner warning-banner--' + (m.type || 'warn') + '" role="status">' +
            '<svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" style="flex-shrink:0;margin-top:1px">' +
            '<path d="M7 1L13 12H1L7 1Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>' +
            '<path d="M7 5v3M7 10h.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>' +
            escHtml(m.text) + '</div>';
        }).join('');
        warnStack.hidden = false;
      }

      function showColumns(headers) {
        if (!headers || headers.length === 0) { chipsWrap.hidden = true; return; }
        document.getElementById('col-count').textContent = '(' + headers.length + ')';
        chipsEl.innerHTML = headers.map(function (h) {
          return '<span class="col-chip" role="listitem">' + escHtml(h) + '</span>';
        }).join('');
        chipsWrap.hidden = false;
      }
      function showStats(rows, cols, csvText, skipped) {
        document.getElementById('stat-rows').textContent = rows.toLocaleString();
        document.getElementById('stat-cols').textContent = cols.toLocaleString();
        document.getElementById('stat-size').textContent = JT.formatBytes(new Blob([csvText]).size);
        var skipWrap = document.getElementById('stat-skipped-wrap');
        if (skipped > 0) {
          document.getElementById('stat-skipped').textContent = skipped.toLocaleString();
          skipWrap.hidden = false;
        } else {
          skipWrap.hidden = true;
        }
        statsEl.hidden = false;
      }

      function fail(msg) {
        showWarnings([{ type: 'err', text: msg }]);
        outputEl.textContent = '';
        chipsWrap.hidden = true;
        statsEl.hidden = true;
        lastCSV = '';
      }
      function convert() {
        var raw = inputEl.value.trim();
        document.getElementById('input-meta').textContent = raw ? JT.formatBytes(new Blob([raw]).size) : '';

        if (!raw) {
          outputEl.textContent = '';
          showWarnings([]);
          chipsWrap.hidden = true;
          statsEl.hidden = true;
          lastCSV = '';
          return;
        }

        var parsed = JT.parseJSON(raw);
        if (parsed.error) {
          fail('JSON parse error' + (parsed.line ? ' (line ' + parsed.line + ')' : '') + ': ' + parsed.error);
          return;
        }

        var data = parsed.data;
        var arr = data;
        var warnings = [];

        if (!Array.isArray(data)) {
          if (data !== null && typeof data === 'object') {
            var arrayKey = Object.keys(data).find(function (k) { return Array.isArray(data[k]); });
            if (arrayKey) {
              arr = data[arrayKey];
              warnings.push({ type: 'info', text: 'Found array at key "' + arrayKey + '" — using ' + arr.length + ' rows from it.' });
            } else {
              arr = [data];
              warnings.push({ type: 'info', text: 'Input is a single JSON object. Wrapping it as one CSV row.' });
            }
          } else {
            fail('Input must be a JSON array of objects. Primitive values cannot be converted to CSV.');
            return;
          }
        }
        var flatten = flattenCheck.checked;
        var incHdr  = headersCheck.checked;
        var skipped = 0;
        var processedRows = [];

        arr.forEach(function (item) {
          if (item === null || typeof item !== 'object' || Array.isArray(item)) { skipped++; return; }
          if (flatten) {
            processedRows.push(JT.flattenObject(item));
          } else {
            var row = {};
            Object.keys(item).forEach(function (k) {
              var v = item[k];
              row[k] = (typeof v === 'object' && v !== null) ? JSON.stringify(v) : v;
            });
            processedRows.push(row);
          }
        });

        if (skipped > 0) {
          warnings.push({ type: 'warn', text: skipped + ' non-object item' + (skipped > 1 ? 's' : '') + ' (arrays, primitives) skipped — CSV supports only object rows.' });
        }

        if (processedRows.length === 0) {
          fail('No convertible rows found. The array must contain at least one object.');
          return;
        }

        if (flatten) {
          var hasIndexedKeys = processedRows.some(function (row) {
            return Object.keys(row).some(function (k) { return /\.\d+/.test(k); });
          });
          if (hasIndexedKeys) {
            warnings.push({ type: 'warn', text: 'Some nested arrays were flattened to indexed columns (e.g. tags.0, tags.1). Restructure the data if that is not what you want.' });
          }
        }
        var out = JT.jsonToCsv(processedRows, {
          delimiter: delimSel.value,
          includeHeaders: incHdr
        });

        if (out.error) { fail(out.error); return; }

        lastCSV = out.csv;
        outputEl.textContent = out.csv;
        showWarnings(warnings);
        showColumns(incHdr ? out.headers : []);
        showStats(processedRows.length, out.headers.length, out.csv, skipped);
      }

      document.getElementById('convert-btn').addEventListener('click', convert);
      inputEl.addEventListener('input', JT.debounce(convert, 400));

      function reconvert() { if (inputEl.value.trim()) convert(); }
      delimSel.addEventListener('change', reconvert);
      flattenCheck.addEventListener('change', reconvert);
      headersCheck.addEventListener('change', reconvert);

      document.getElementById('sample-btn').addEventListener('click', function () {
        inputEl.value = JSON.stringify([
          { id: 1, name: 'Alice', age: 30, address: { city: 'London', zip: 'EC1A' } },
          { id: 2, name: 'Bob', age: 25, address: { city: 'Paris', zip: '75001' } },
          { id: 3, name: 'Chen', age: 41, address: { city: 'Singapore', zip: '018956' } }
        ], null, 2);
        convert();
      });
      document.getElementById('copy-btn').addEventListener('click', function () {
        if (!lastCSV) return;
        var btn = this;
        JT.copyToClipboard(lastCSV).then(function () {
          var orig = btn.innerHTML;
          btn.innerHTML = '<svg aria-hidden="true" width="12" height="12" viewBox="0 0 12 12" fill="none" style="vertical-align:-1px;margin-right:4px"><path d="M2 6l3 3 5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>Copied!';
          btn.style.color = 'var(--success)';
          setTimeout(function () { btn.innerHTML = orig; btn.style.color = ''; }, 1800);
        });
      });

      document.getElementById('download-btn').addEventListener('click', function () {
        if (!lastCSV) return;
        var blob = new Blob([lastCSV], { type: 'text/csv;charset=utf-8;' });
        var url  = URL.createObjectURL(blob);
        var a    = document.createElement('a');
        a.href = url; a.download = 'data.csv'; a.click();
        setTimeout(function () { URL.revokeObjectURL(url); }, 5000);
      });

      document.getElementById('clear-btn').addEventListener('click', function () {
        inputEl.value = '';
        lastCSV = '';
        outputEl.textContent = '';
        showWarnings([]);
        chipsWrap.hidden = true;
        statsEl.hidden = true;
        document.getElementById('input-meta').textContent = '';
        inputEl.focus();
      });

      document.body.addEventListener('dragover', function (e) {
        if (e.dataTransfer && Array.prototype.indexOf.call(e.dataTransfer.types, 'Files') > -1) e.preventDefault();
      });
      document.body.addEventListener('drop', function (e) {
        if (!e.dataTransfer || !e.dataTransfer.files.length) return;
        e.preventDefault();
        var reader = new FileReader();
        reader.onload = function (ev) { inputEl.value = ev.target.result; convert(); };
        reader.readAsText(e.dataTransfer.files[0]);
      });
    })();
  </script>

</ToolLayout>
