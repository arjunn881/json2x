---
import ToolLayout from '../../layouts/ToolLayout.astro';
import { getToolBySlugOrId } from '../../data/tools';

const tool = getToolBySlugOrId('json-minifier')!;
---

<ToolLayout tool={tool}>
  <style>
    /* ── Toolbar ─────────────────────────────────────────────── */
    .mn-toolbar {
      display:       flex;
      align-items:   center;
      flex-wrap:     wrap;
      gap:           var(--space-2);
      padding:       var(--space-3) var(--space-4);
      background:    var(--bg-raised);
      border:        1px solid var(--bg-border);
      border-radius: var(--radius-lg);
      margin-bottom: var(--space-4);
    }
    .mn-toolbar__divider {
      width: 1px; height: 24px;
      background: var(--bg-border);
      flex-shrink: 0; margin-inline: var(--space-1);
    }

    @media (max-width: 640px) {
      .mn-toolbar { padding: var(--space-3); }
      .mn-toolbar__divider { display: none; }
      .mn-toolbar .btn {
        flex: 1 1 calc(50% - var(--space-2));
        justify-content: center;
        min-height: 36px;
      }
      .mn-toolbar .btn--primary { flex: 1 1 100%; min-height: 40px; }
    }
    /* ── Error strip — sits at the foot of the input pane ─────── */
    .mn-error {
      display:       flex;
      align-items:   flex-start;
      gap:           var(--space-3);
      padding:       var(--space-3) var(--space-4);
      background:    var(--error-bg);
      border-top:    1px solid var(--error);
      font-size:     var(--text-xs);
      color:         var(--error);
    }
    .mn-error[hidden] { display: none; }
    .mn-error__badge {
      flex-shrink:   0;
      background:    var(--error);
      color:         #fff;
      border-radius: var(--radius-sm);
      padding:       1px var(--space-2);
      font-weight:   var(--font-semibold);
      font-family:   var(--font-mono);
    }

    /* ── Compression card ─────────────────────────────────────── */
    .compression-card {
      background:    var(--bg-surface);
      border:        1px solid var(--bg-border);
      border-radius: var(--radius-2xl);
      padding:       var(--space-8) var(--space-6);
      margin-block:  var(--space-6);
      position:      relative;
      overflow:      hidden;
    }
    .compression-card::before {
      content:    '';
      position:   absolute;
      inset:      0;
      background: radial-gradient(ellipse 60% 70% at 50% 120%, var(--success-bg), transparent 70%);
      pointer-events: none;
    }
    .compression-card__metrics {
      display:               grid;
      grid-template-columns: 1fr auto 1fr 1fr;
      align-items:           center;
      gap:                   var(--space-4);
      margin-bottom:         var(--space-6);
    }
    @media (max-width: 640px) {
      .compression-card__metrics { grid-template-columns: 1fr 1fr; }
      .metric--arrow { display: none; }
    }
    .metric {
      display:        flex;
      flex-direction: column;
      align-items:    center;
      gap:            var(--space-1);
    }
    .metric__value {
      font-family: var(--font-mono);
      font-size:   var(--text-3xl);
      font-weight: var(--font-bold);
      color:       var(--text-primary);
      line-height: 1;
    }
    .metric__label {
      font-size:      var(--text-xs);
      font-weight:    var(--font-semibold);
      color:          var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }
    .metric--pct .metric__value {
      font-size:       2.5rem;
      background:      linear-gradient(135deg, var(--success) 0%, hsl(152,68%,70%) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .metric--arrow {
      font-size:   var(--text-2xl);
      color:       var(--text-muted);
      user-select: none;
    }

    /* ── Compression bar ──────────────────────────────────────── */
    .compression-bar-wrap { position: relative; }
    .compression-bar-labels {
      display:         flex;
      justify-content: space-between;
      font-size:       var(--text-xs);
      color:           var(--text-muted);
      margin-bottom:   var(--space-2);
    }
    .compression-bar-track {
      height:        14px;
      background:    var(--bg-overlay);
      border-radius: var(--radius-full);
      overflow:      hidden;
      position:      relative;
    }
    .compression-bar-fill {
      position:      absolute;
      inset:         0 auto 0 0;
      background:    linear-gradient(90deg, var(--success), hsl(199,90%,55%));
      border-radius: var(--radius-full);
      width:         0%;
      transition:    width 0.6s cubic-bezier(0.34,1.56,0.64,1);
    }
    .compression-bar-ghost {
      position:      absolute;
      inset:         0 auto 0 0;
      background:    hsla(0,82%,63%,0.25);
      width:         100%;
      border-radius: var(--radius-full);
    }
    .compression-bar-legend {
      display:    flex;
      gap:        var(--space-5);
      margin-top: var(--space-3);
      font-size:  var(--text-xs);
      color:      var(--text-muted);
    }
    .legend-dot {
      width: 8px; height: 8px;
      border-radius: 50%;
      display: inline-block;
      margin-right: var(--space-1);
    }
  </style>
  <div class="mn-toolbar" role="toolbar" aria-label="Minifier options">
    <button class="btn btn--primary" id="minify-btn" aria-label="Minify JSON">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <rect x="1" y="3"   width="12" height="1.5" rx="0.75" fill="currentColor"/>
        <rect x="3" y="6.5" width="8"  height="1.5" rx="0.75" fill="currentColor"/>
        <rect x="5" y="10"  width="4"  height="1.5" rx="0.75" fill="currentColor"/>
      </svg>
      Minify JSON
    </button>

    <div class="mn-toolbar__divider" aria-hidden="true"></div>

    <button class="btn btn--ghost" id="sample-btn">Load sample</button>

    <label class="btn btn--ghost" style="cursor:pointer" title="Load .json file from disk">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M8 1H3.5A1.5 1.5 0 0 0 2 2.5v9A1.5 1.5 0 0 0 3.5 13h7a1.5 1.5 0 0 0 1.5-1.5V5.5L8 1Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
        <path d="M8 1v4.5H12.5" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
      </svg>
      Open File
      <input type="file" id="file-input" accept=".json,application/json,text/*" style="display:none" aria-label="Load JSON file" />
    </label>

    <button class="btn btn--ghost" id="clear-btn" style="margin-left:auto" aria-label="Clear all">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M2 2l10 10M12 2 2 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
      Clear
    </button>
  </div>
  <div class="tw-workspace tw-workspace--sticky-out">
    <!-- LEFT: input -->
    <section class="tw-pane tw-pane--input" aria-labelledby="mn-in-title">
      <div class="tw-pane__header">
        <h2 class="tw-pane__title" id="mn-in-title">
          {tool.inputLabel || 'JSON Input'}
          <span class="tw-pane__side">Input</span>
        </h2>
        <span class="tw-pane__meta">
          <span id="input-lines"></span>
          <span id="input-size-el"></span>
        </span>
      </div>
      <textarea
        class="tw-input"
        id="json-input"
        placeholder="Paste JSON here, or drag &amp; drop a .json file…"
        aria-label="JSON input"
        spellcheck="false"
        autocapitalize="off"
        autocomplete="off"
      ></textarea>
      <div class="mn-error" id="error-strip" hidden role="alert" aria-live="assertive">
        <span class="mn-error__badge" id="error-badge">ERR</span>
        <span id="error-msg"></span>
      </div>
    </section>
    <!-- RIGHT: minified output -->
    <section class="tw-pane tw-pane--output" aria-labelledby="mn-out-title">
      <div class="tw-pane__header">
        <h2 class="tw-pane__title" id="mn-out-title">
          {tool.outputLabel || 'Minified JSON'}
          <span class="tw-pane__side">Output</span>
        </h2>
        <div class="tw-pane__actions">
          <span class="tw-pane__meta" id="output-size-el"></span>
          <button class="btn btn--ghost btn--sm" id="copy-btn" aria-label="Copy minified JSON">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <rect x="4" y="4" width="8" height="8" rx="1.5" stroke="currentColor" stroke-width="1.5"/>
              <path d="M2 10V2h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Copy
          </button>
          <button class="btn btn--ghost btn--sm" id="download-btn" aria-label="Download minified JSON file">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M7 1v8m0 0-3-3m3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M2 10v1.5A1.5 1.5 0 0 0 3.5 13h7a1.5 1.5 0 0 0 1.5-1.5V10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            Download
          </button>
        </div>
      </div>
      <pre
        class="tw-output"
        id="mn-output"
        tabindex="0"
        role="region"
        aria-label="Minified JSON output"
        aria-live="polite"
        data-placeholder="Minified JSON appears here — paste on the left to start."
      ></pre>
    </section>
  </div>
  <div class="compression-card" id="compression-card" hidden aria-label="Compression statistics" aria-live="polite">
    <div class="compression-card__metrics">
      <div class="metric">
        <span class="metric__value" id="sz-before">—</span>
        <span class="metric__label">Original</span>
      </div>
      <div class="metric metric--arrow" aria-hidden="true">→</div>
      <div class="metric">
        <span class="metric__value" id="sz-after">—</span>
        <span class="metric__label">Minified</span>
      </div>
      <div class="metric metric--pct">
        <span class="metric__value" id="sz-pct">—</span>
        <span class="metric__label">Smaller</span>
      </div>
    </div>

    <div class="compression-bar-wrap">
      <div class="compression-bar-labels">
        <span>Minified size</span>
        <span id="sz-saved-label">Saved: —</span>
      </div>
      <div class="compression-bar-track" role="progressbar" aria-label="Compression ratio" id="bar-track" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
        <div class="compression-bar-ghost"></div>
        <div class="compression-bar-fill" id="bar-fill"></div>
      </div>
      <div class="compression-bar-legend">
        <span><span class="legend-dot" style="background:linear-gradient(90deg,var(--success),hsl(199,90%,55%))"></span>Minified</span>
        <span><span class="legend-dot" style="background:hsla(0,82%,63%,0.4)"></span>Whitespace removed</span>
      </div>
    </div>
  </div>
  <script is:inline>
    (function () {
      'use strict';

      var inputEl  = document.getElementById('json-input');
      var outputEl = document.getElementById('mn-output');
      var errorEl  = document.getElementById('error-strip');
      var errorBdg = document.getElementById('error-badge');
      var errorMsg = document.getElementById('error-msg');
      var card     = document.getElementById('compression-card');

      var lastMinified = '';

      function showError(msg, line) {
        errorEl.hidden = false;
        errorBdg.textContent = line ? 'Line ' + line : 'ERR';
        errorMsg.textContent = msg;
        card.hidden = true;
        outputEl.textContent = '';
        document.getElementById('output-size-el').textContent = '';
        lastMinified = '';
      }

      function clearError() {
        errorEl.hidden = true;
      }

      function updateInputMeta(raw) {
        var lines = (raw.match(/\n/g) || []).length + 1;
        document.getElementById('input-lines').textContent   = raw.trim() ? lines.toLocaleString() + ' lines' : '';
        document.getElementById('input-size-el').textContent = raw.trim() ? JT.formatBytes(new Blob([raw]).size) : '';
      }
      function minify() {
        var raw = inputEl.value;
        updateInputMeta(raw);

        if (!raw.trim()) {
          clearError();
          card.hidden = true;
          outputEl.textContent = '';
          document.getElementById('output-size-el').textContent = '';
          lastMinified = '';
          return;
        }

        var res = JT.parseJSON(raw);
        if (res.error) { showError(res.error, res.line); return; }
        clearError();

        var minified = JT.stringifyJSON(res.data, 0).text;
        lastMinified = minified;
        outputEl.textContent = minified;

        var beforeBytes = new Blob([raw]).size;
        var afterBytes  = new Blob([minified]).size;
        var savedBytes  = beforeBytes - afterBytes;
        var pct         = beforeBytes > 0 ? Math.max(0, Math.round((savedBytes / beforeBytes) * 100)) : 0;
        var keptPct     = 100 - pct;

        document.getElementById('output-size-el').textContent  = JT.formatBytes(afterBytes);
        document.getElementById('sz-before').textContent       = JT.formatBytes(beforeBytes);
        document.getElementById('sz-after').textContent        = JT.formatBytes(afterBytes);
        document.getElementById('sz-pct').textContent          = pct + '%';
        document.getElementById('sz-saved-label').textContent  = 'Saved: ' + JT.formatBytes(savedBytes);

        var barTrack = document.getElementById('bar-track');
        document.getElementById('bar-fill').style.width = keptPct + '%';
        barTrack.setAttribute('aria-valuenow', String(keptPct));
        card.hidden = false;
      }
      document.getElementById('minify-btn').addEventListener('click', minify);
      inputEl.addEventListener('input', JT.debounce(minify, 350));

      document.getElementById('sample-btn').addEventListener('click', function () {
        inputEl.value = JSON.stringify({
          endpoint: '/api/v2/orders',
          items: [
            { sku: 'A-1001', qty: 2, price: 19.99, tags: ['sale', 'new'] },
            { sku: 'B-2002', qty: 1, price: 149.5, tags: [] }
          ],
          customer: { id: 8814, name: 'Ada Lovelace', vip: true },
          shipped: null
        }, null, 2);
        minify();
      });

      document.getElementById('copy-btn').addEventListener('click', function () {
        if (!lastMinified) return;
        var btn = this;
        JT.copyToClipboard(lastMinified).then(function () {
          var orig = btn.innerHTML;
          btn.innerHTML = '<svg aria-hidden="true" width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2.5 7.5l3 3 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg> Copied!';
          btn.style.color = 'var(--success)';
          setTimeout(function () { btn.innerHTML = orig; btn.style.color = ''; }, 1800);
        });
      });

      document.getElementById('download-btn').addEventListener('click', function () {
        if (!lastMinified) return;
        var blob = new Blob([lastMinified], { type: 'application/json' });
        var url  = URL.createObjectURL(blob);
        var a    = document.createElement('a');
        a.href = url; a.download = 'minified.json'; a.click();
        setTimeout(function () { URL.revokeObjectURL(url); }, 5000);
      });
      document.getElementById('clear-btn').addEventListener('click', function () {
        inputEl.value = '';
        lastMinified  = '';
        clearError();
        card.hidden = true;
        outputEl.textContent = '';
        document.getElementById('input-lines').textContent    = '';
        document.getElementById('input-size-el').textContent  = '';
        document.getElementById('output-size-el').textContent = '';
        inputEl.focus();
      });

      function readFile(file) {
        if (!file) return;
        if (file.size > 5 * 1024 * 1024) { showError('File too large — 5 MB maximum.'); return; }
        var reader = new FileReader();
        reader.onload = function (e) { inputEl.value = e.target.result; minify(); };
        reader.readAsText(file);
      }

      document.getElementById('file-input').addEventListener('change', function () {
        readFile(this.files[0]);
        this.value = '';
      });

      document.body.addEventListener('dragover', function (e) {
        if (e.dataTransfer && Array.prototype.indexOf.call(e.dataTransfer.types, 'Files') > -1) e.preventDefault();
      });
      document.body.addEventListener('drop', function (e) {
        if (!e.dataTransfer || !e.dataTransfer.files.length) return;
        e.preventDefault();
        readFile(e.dataTransfer.files[0]);
      });

      // Ctrl/Cmd+Shift+M minifies, Ctrl/Cmd+Shift+C copies.
      document.addEventListener('keydown', function (e) {
        var mod = e.metaKey || e.ctrlKey;
        if (!mod || !e.shiftKey) return;
        var k = e.key.toLowerCase();
        if (k === 'm') { e.preventDefault(); minify(); }
        if (k === 'c') { e.preventDefault(); document.getElementById('copy-btn').click(); }
      });
    })();
  </script>

</ToolLayout>
