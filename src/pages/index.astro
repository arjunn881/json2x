  <!-- Live JSON Terminal Hero Animation Script -->
  <script is:inline>
    (function () {
      const codeEl = document.getElementById('hero-json-code');
      if (!codeEl) return;

      const rawJson = '{"name":"JSON2X","type":"developer-tools","privacy":"100% client-side","speed":"0ms","tools":10,"compliant":true}';
      const formattedLines = [
        '<span class="t-brace">{</span>',
        '  <span class="t-key">"name"</span>: <span class="t-str">"JSON2X"</span>,',
        '  <span class="t-key">"type"</span>: <span class="t-str">"developer-tools"</span>,',
        '  <span class="t-key">"privacy"</span>: <span class="t-str">"100% client-side"</span>,',
        '  <span class="t-key">"speed"</span>: <span class="t-str">"0ms"</span>,',
        '  <span class="t-key">"tools"</span>: <span class="t-num">10</span>,',
        '  <span class="t-key">"compliant"</span>: <span class="t-bool">true</span>',
        '<span class="t-brace">}</span>'
      ].join('\n');

      // Check prefers-reduced-motion
      if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        codeEl.innerHTML = '<pre class="formatted-code">' + formattedLines + '</pre>';
        return;
      }

      let index = 0;
      let isTyping = true;
      const termBody = document.getElementById('hero-json-terminal');

      function runCycle() {
        if (isTyping) {
          if (index <= rawJson.length) {
            codeEl.innerHTML = '<span class="t-raw">' + rawJson.slice(0, index) + '</span><span class="t-cursor">|</span>';
            index++;
            setTimeout(runCycle, 30);
          } else {
            isTyping = false;
            setTimeout(() => {
              // Prettify transition
              if (termBody) termBody.style.opacity = '0.3';
              setTimeout(() => {
                codeEl.innerHTML = '<pre class="formatted-code">' + formattedLines + '</pre>';
                if (termBody) termBody.style.opacity = '1';
                setTimeout(() => {
                  // Reset loop
                  isTyping = true;
                  index = 0;
                  runCycle();
                }, 5000);
              }, 250);
            }, 800);
          }
        }
      }

      runCycle();
    })();
  </script>
