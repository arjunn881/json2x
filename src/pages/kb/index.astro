---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import { KB_TOPICS } from '../../data/kb';

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  'name': 'JSON Knowledge Base & Technical Reference Index',
  'url': 'https://json2x.com/kb/',
  'itemListElement': KB_TOPICS.map((t, idx) => ({
    '@type': 'ListItem',
    'position': idx + 1,
    'name': t.title,
    'url': `https://json2x.com/kb/${t.slug}`
  }))
};
---

<BaseLayout
  title="JSON Knowledge Base & Technical Reference Index | JSON2X"
  description="Programmatic developer reference hub covering JSON errors, tutorials, arrays, objects, validation, escaping, formatting, APIs, schemas, and JSONPath."
  canonical="/kb/"
  currentId="kb"
  schema={itemListSchema}
>
  <Breadcrumbs items={[{ label: 'Knowledge Base' }]} />

  <div class="tool-hero" style="text-align:left; margin-bottom:var(--space-10);">
    <div class="tool-hero__badge">Knowledge Hub</div>
    <h1 class="tool-hero__title">JSON Knowledge Base &amp; Technical Reference</h1>
    <p class="tool-hero__desc">Programmatically compiled guides, syntax specifications, error troubleshooting, and tutorials for developers.</p>
  </div>

  <div class="faq-grid" style="grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: var(--space-6);">
    {KB_TOPICS.map((topic) => (
      <a href={`/kb/${topic.slug}`} class="faq-card" style="text-decoration:none; display:flex; flex-direction:column;">
        <p class="faq-section__eyebrow">{topic.category}</p>
        <h2 class="faq-card__q" style="margin-top:0;">{topic.h1}</h2>
        <p class="faq-card__a">{topic.metaDesc}</p>
      </a>
    ))}
  </div>
</BaseLayout>
