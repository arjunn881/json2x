---
import KbLayout from '../../../layouts/KbLayout.astro';
import { TOOL_PAGES, resolveToolSlug, getPseoKeywords, getPseoCategory } from '../../../data/tool-pseo';
import type { ToolPseoPage } from '../../../data/tool-pseo';

export function getStaticPaths() {
  return TOOL_PAGES.map((page) => ({
    params: { slug: page.slug },
    props: { page }
  }));
}

export interface Props {
  page: ToolPseoPage;
}

const { page } = Astro.props;

// The two authoring generations differ in which fields they populate; normalise
// here so every pSEO page renders with real keywords, category and CTA tool.
const primaryTool = resolveToolSlug(page);
const keywords = getPseoKeywords(page);
const category = getPseoCategory(page);
---

<KbLayout
  title={page.metaTitle || page.title}
  metaDesc={page.metaDesc}
  h1={page.h1}
  category={category}
  primaryTool={primaryTool}
  keywords={keywords}
  content={page.content}
  codeExample={page.codeExample}
  faqs={page.faqs}
  answer={page.intro}
  useCases={page.useCases}
  relatedTools={page.relatedTools}
  canonical={`/kb/tools/${page.slug}`}
  breadcrumbs={[
    { label: 'Knowledge Base', href: '/kb' },
    { label: 'Tool Guides', href: '/kb/tools' },
    { label: page.h1 }
  ]}
/>
