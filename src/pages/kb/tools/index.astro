---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/layout/Breadcrumbs.astro';
import { TOOL_PAGES, getPseoCategory } from '../../../data/tool-pseo';

const categories = Array.from(new Set(TOOL_PAGES.map((p) => getPseoCategory(p)))).sort();

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  'name': 'JSON2X Developer Tool Guides',
  'url': 'https://json2x.com/kb/tools',
  'numberOfItems': TOOL_PAGES.length,
  'itemListElement': TOOL_PAGES.map((p, idx) => ({
    '@type': 'ListItem',
    'position': idx + 1,
    'name': p.h1,
    'url': `https://json2x.com/kb/tools/${p.slug}`
  }))
};
---

<BaseLayout
  title="JSON Tool Guides & Tutorials — 41 Step-by-Step Walkthroughs"
  description="Task-specific guides for every JSON2X tool: format JSON in Python or JavaScript, convert JSON to CSV for Excel, and generate TypeScript types."
  canonical="/kb/tools"
  currentId="kb"
  schema={itemListSchema}
>
  <Breadcrumbs
    items={[
      { label: 'Knowledge Base', href: '/kb' },
      { label: 'Tool Guides' }
    ]}
  />

  <div class="tool-hero" style="text-align:left; margin-bottom:var(--space-8);">
    <div class="tool-hero__badge">Tool Specific Intent Guides</div>
    <h1 class="tool-hero__title">JSON Tool Guides &amp; Tutorials</h1>
    <p class="tool-hero__desc">In-depth feature comparisons, online alternatives, and use-case tutorials for all 21 client-side developer utilities.</p>
    <p id="direct-answer" style="margin-top:var(--space-4);padding:var(--space-4) var(--space-5);background:var(--bg-raised);border-left:4px solid var(--accent);border-radius:0 var(--radius-md) var(--radius-md) 0;font-size:var(--text-base);color:var(--text-primary);line-height:1.7;">
      This directory holds {TOOL_PAGES.length} task-specific guides for the JSON2X toolkit, grouped by intent: formatting JSON in a given language, converting between JSON and CSV, YAML, XML or SQL, validating API responses, and generating types or schemas from a sample payload.
    </p>
  </div>

  {categories.map((cat) => {
    const pages = TOOL_PAGES.filter((p) => getPseoCategory(p) === cat);
    return (
      <section style="margin-bottom:var(--space-12);">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:var(--space-4);border-bottom:1px solid var(--bg-border);padding-bottom:var(--space-2);">
          <h2 style="font-size:var(--text-xl);font-weight:var(--font-bold);color:var(--text-primary);">{cat}</h2>
          <span style="font-size:var(--text-xs);color:var(--text-muted);">{pages.length} Pages</span>
        </div>

        <div class="faq-grid" style="grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: var(--space-4);">
          {pages.map((p) => (
            <a href={`/kb/tools/${p.slug}`} class="faq-card" style="text-decoration:none;">
              <span style="font-size:11px;font-weight:600;color:var(--accent);text-transform:uppercase;">{cat}</span>
              <h3 class="faq-card__q" style="font-size:var(--text-base);margin-top:4px;">{p.h1}</h3>
              <p class="faq-card__a">{p.metaDesc}</p>
            </a>
          ))}
        </div>
      </section>
    );
  })}
</BaseLayout>
